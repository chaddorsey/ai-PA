{
  "title": "OmniFocus Timer Toggle",
  "rules": [
    {
      "description": "Caps Lock → Toggle OmniFocus Timer (LED on while timing)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "shell_command": "/Users/chaddorsey/Dropbox/dev/omnifocus-timer/toggle-timer.sh &",
              "repeat": false
            }
          ]
        }
      ]
    }
  ]
}
