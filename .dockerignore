# macOS metadata
._*
.DS_Store

# VCS + worktrees (~5GB + 308M) — never needed in an image build context
.git
.worktrees

# Local runtime state (agent backends/memfs, exports) — runtime only
.letta

# Large unrelated subsystems. The only services that build from the repo root
# (pa-web-ui, slack-analytics-mcp-server, curator-radar) each COPY only their
# own subdir (+ a couple of small helper paths for pa-web-ui), so none of these
# belong in the build context. Keeping them out takes the context 44GB -> ~2GB,
# which is what was wedging buildx.
frigate
deployment
spike-clips
sports-and-media-tools
auto-madden
lettabot
omnifocus-timer
omnifocus-mcp-letta
letta-code
letta-code-patched

# DB dumps / backups
*.sql
*.sql.gz

# Dependencies + caches (rebuilt inside the image)
**/node_modules
**/__pycache__
