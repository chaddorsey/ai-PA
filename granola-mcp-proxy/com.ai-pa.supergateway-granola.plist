<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-pa.supergateway-granola</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/supergateway</string>
        <string>--stdio</string>
        <string>npx mcp-remote https://mcp.granola.ai/mcp</string>
        <string>--outputTransport</string>
        <string>streamableHttp</string>
        <string>--port</string>
        <string>8089</string>
        <string>--cors</string>
        <string>--logLevel</string>
        <string>info</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/supergateway-granola.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/supergateway-granola.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/dorseyhomeserver</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Volumes/main-drive/ai-PA/granola-mcp-proxy</string>
</dict>
</plist>
