/*{
  "type":        "library",
  "targets":     ["omnifocus"],
  "identifier":  "omnifocus-mcp",
  "author":      "Chad Dorsey",
  "version":     "0.1.1",
  "description": "MCP bridge library for OmniFocus"
}*/
(() => {
  var lib = new PlugIn.Library(new Version("0.1.1"));

  // Enhanced Performance optimization: Multi-level caching with smart invalidation
  const queryCache = new Map();
  const aggregationCache = new Map();
  const hierarchyCache = new Map();
  
  // Enhanced cache configuration
  const CACHE_CONFIG = {
    // TTL settings for different data types
    taskDataTTL: 30000,           // 30 seconds for dynamic task data
    organizationalDataTTL: 300000, // 5 minutes for folders/projects
    hierarchyDataTTL: 600000,     // 10 minutes for stable hierarchies
    inboxDataTTL: 30000,          // 30 seconds for dynamic inbox
    aggregationTTL: 120000,       // 2 minutes for computed aggregations
    
    // Memory management
    maxCacheSize: 200,            // Increased for multi-level caching
    maxAggregationSize: 50,       // Limit for aggregation cache
    maxHierarchySize: 30,         // Limit for hierarchy cache
    
    // Performance monitoring
    enableMetrics: true,
    metricsReportInterval: 300000 // 5 minutes
  };
  
  // Performance metrics tracking
  const performanceMetrics = {
    totalQueries: 0,
    cacheHits: 0,
    cacheMisses: 0,
    avgResponseTime: 0,
    slowQueries: [],
    lastReportTime: Date.now()
  };
  
  function getSmartCacheKey(method, params, keyType = 'method') {
    switch (keyType) {
      case 'organizational':
        // Hierarchical keys for organizational data
        const baseKey = `org:${method}`;
        if (params.folderId) return `${baseKey}:folder:${params.folderId}`;
        if (params.projectId) return `${baseKey}:project:${params.projectId}`;
        if (params.parentFolderId) return `${baseKey}:parent:${params.parentFolderId}`;
        return `${baseKey}:root`;
        
      case 'aggregation':
        // Keys for computed aggregations
        return `agg:${method}:` + JSON.stringify(params);
        
      case 'hierarchy':
        // Keys for folder hierarchies
        return `hier:${params.folderId || 'root'}:depth:${params.maxDepth || 'unlimited'}`;
        
      default:
        // Standard method-level caching
        return method + ':' + JSON.stringify(params);
    }
  }
  
  function getCachedWithTTL(key, cache = queryCache, ttl = CACHE_CONFIG.taskDataTTL) {
    const cached = cache.get(key);
    if (cached && (Date.now() - cached.timestamp) < ttl) {
      // Update metrics
      performanceMetrics.cacheHits++;
      return cached.result;
    }
    if (cached) {
      cache.delete(key);
    }
    performanceMetrics.cacheMisses++;
    return null;
  }
  
  function setCachedWithTTL(key, result, cache = queryCache, maxSize = CACHE_CONFIG.maxCacheSize) {
    cache.set(key, { result, timestamp: Date.now() });
    
    // Enhanced cache cleanup with size limits
    if (cache.size > maxSize) {
      const entries = Array.from(cache.entries());
      const now = Date.now();
      
      // Sort by age (oldest first) and remove oldest 25%
      entries.sort((a, b) => a[1].timestamp - b[1].timestamp);
      const toRemove = Math.floor(entries.length * 0.25);
      
      for (let i = 0; i < toRemove; i++) {
        cache.delete(entries[i][0]);
      }
    }
  }
  
  function invalidateOrganizationalCache(changeType, entityId) {
    // Smart cache invalidation based on organizational changes
    const patterns = [];
    
    switch (changeType) {
      case 'folder':
        patterns.push(`org:.*:folder:${entityId}`);
        patterns.push(`org:.*:parent:${entityId}`);
        patterns.push(`hier:${entityId}:.*`);
        patterns.push(`agg:.*folder.*${entityId}`);
        break;
        
      case 'project':
        patterns.push(`org:.*:project:${entityId}`);
        patterns.push(`agg:.*project.*`);
        break;
        
      case 'inbox':
        patterns.push(`org:.*inbox.*`);
        patterns.push(`agg:.*inbox.*`);
        break;
        
      case 'global':
        // Clear organizational caches completely
        queryCache.clear();
        aggregationCache.clear();
        hierarchyCache.clear();
        return;
    }
    
    // Remove matching entries from all caches
    [queryCache, aggregationCache, hierarchyCache].forEach(cache => {
      for (const [key, value] of cache.entries()) {
        if (patterns.some(pattern => new RegExp(pattern).test(key))) {
          cache.delete(key);
        }
      }
    });
  }

  function invalidateQueryCache(changeType, entityId) {
    // Query cache invalidation - delegate to organizational cache for now
    invalidateOrganizationalCache(changeType, entityId);
  }
  
  function trackPerformance(methodName, startTime, wasCached = false) {
    const duration = Date.now() - startTime;
    performanceMetrics.totalQueries++;
    
    // Update rolling average
    performanceMetrics.avgResponseTime = 
      (performanceMetrics.avgResponseTime * (performanceMetrics.totalQueries - 1) + duration) / 
      performanceMetrics.totalQueries;
    
    // Track slow queries (over 1 second)
    if (duration > 1000) {
      performanceMetrics.slowQueries.push({
        method: methodName,
        duration: duration,
        timestamp: Date.now(),
        cached: wasCached
      });
      
      // Keep only last 10 slow queries
      if (performanceMetrics.slowQueries.length > 10) {
        performanceMetrics.slowQueries.shift();
      }
    }
    
    // Periodic metrics reporting
    if (CACHE_CONFIG.enableMetrics && 
        Date.now() - performanceMetrics.lastReportTime > CACHE_CONFIG.metricsReportInterval) {
      reportPerformanceMetrics();
      performanceMetrics.lastReportTime = Date.now();
    }
  }
  
  function reportPerformanceMetrics() {
    const hitRate = performanceMetrics.totalQueries > 0 ? 
      (performanceMetrics.cacheHits / performanceMetrics.totalQueries * 100).toFixed(1) : 0;
    
    console.log(`[PERFORMANCE REPORT]
      Total Queries: ${performanceMetrics.totalQueries}
      Cache Hit Rate: ${hitRate}%
      Avg Response Time: ${performanceMetrics.avgResponseTime.toFixed(2)}ms
      Cache Sizes: Query=${queryCache.size}, Agg=${aggregationCache.size}, Hier=${hierarchyCache.size}
      Slow Queries: ${performanceMetrics.slowQueries.length}
    `);
  }
  
  // Legacy compatibility functions
  function getCacheKey(method, params) {
    return getSmartCacheKey(method, params, 'method');
  }
  
  function getCached(key) {
    return getCachedWithTTL(key, queryCache, CACHE_CONFIG.taskDataTTL);
  }
  
  function setCached(key, result) {
    setCachedWithTTL(key, result, queryCache, CACHE_CONFIG.maxCacheSize);
  }
  
  // Performance monitoring for optimization verification
  function withTiming(methodName, fn) {
    return function(params) {
      const start = Date.now();
      const result = fn.call(this, params);
      const duration = Date.now() - start;
      
      // Log performance info (visible in OmniFocus console)
      console.log(`${methodName}: ${duration}ms, cached: ${getCached(getCacheKey(methodName, params || {})) !== null}`);
      
      return result;
    };
  }

  function bareId(objId) {
    const s = String(objId);
    const m = s.match(/ ([^ ]+)\]$/);
    return m ? m[1] : s;
  }

  // Helper function to calculate task depth (number of parent levels)
  function calculateTaskDepth(task) {
    let depth = 0;
    let currentTask = task;
    while (currentTask.parent) {
      depth++;
      currentTask = currentTask.parent;
    }
    return depth;
  }

  // Helper function to check if a project is in an excluded folder hierarchy
  function isInExcludedFolder(project, excludeFolderIds) {
    if (!project || !project.folder || excludeFolderIds.length === 0) {
      return false;
    }
    
    let folder = project.folder;
    while (folder) {
      if (excludeFolderIds.includes(bareId(folder.id))) {
        return true;
      }
      folder = folder.parent;
    }
    return false;
  }

  // Optimized version using Set for O(1) lookup
  function isInExcludedFolderOptimized(project, excludeFolderSet) {
    if (!project || !project.folder || excludeFolderSet.size === 0) {
      return false;
    }
    
    let folder = project.folder;
    while (folder) {
      if (excludeFolderSet.has(bareId(folder.id))) {
        return true;
      }
      folder = folder.parent;
    }
    return false;
  }

  // Date and status helper functions for advanced filtering
  function isToday(date) {
    if (!date) return false;
    const today = new Date();
    return date.toDateString() === today.toDateString();
  }

  function isOverdue(dueDate) {
    if (!dueDate) return false;
    return dueDate < new Date();
  }

  function isDueSoon(dueDate, days) {
    if (!dueDate) return false;
    const soonDate = new Date();
    soonDate.setDate(soonDate.getDate() + days);
    return dueDate <= soonDate && dueDate >= new Date();
  }

  function isAvailableNow(task) {
    // Available if not completed, not dropped, and not deferred
    if (task.completed || !task.effectiveActive) return false;
    if (task.deferDate && task.deferDate > new Date()) return false;
    return true;
  }

  // Boolean tag logic helper functions for Task 1-16
  function matchesTagCombination(task, tagCombination) {
    if (!tagCombination) return true;
    
    const taskTagIds = new Set(task.tags.map(tag => bareId(tag.id)));
    
    // AND logic: ALL specified tags must be present
    if (tagCombination.and && tagCombination.and.length > 0) {
      if (!tagCombination.and.every(tagId => taskTagIds.has(tagId))) {
        return false;
      }
    }
    
    // OR logic: AT LEAST ONE specified tag must be present
    if (tagCombination.or && tagCombination.or.length > 0) {
      if (!tagCombination.or.some(tagId => taskTagIds.has(tagId))) {
        return false;
      }
    }
    
    // Legacy 'any' support (equivalent to OR)
    if (tagCombination.any && tagCombination.any.length > 0) {
      if (!tagCombination.any.some(tagId => taskTagIds.has(tagId))) {
        return false;
      }
    }
    
    // NOT logic: NONE of the specified tags can be present
    if (tagCombination.not && tagCombination.not.length > 0) {
      if (tagCombination.not.some(tagId => taskTagIds.has(tagId))) {
        return false;
      }
    }
    
    return true;
  }

  function validateTagCombination(tagCombination) {
    if (!tagCombination) return [];
    
    const allTagIds = [
      ...(tagCombination.and || []),
      ...(tagCombination.or || []),
      ...(tagCombination.any || []),
      ...(tagCombination.not || [])
    ];
    
    // Validate that all tag IDs exist
    const invalidTags = [];
    for (const tagId of allTagIds) {
      const tag = flattenedTags.find(t => bareId(t.id) === tagId);
      if (!tag) {
        invalidTags.push(tagId);
      }
    }
    
    return invalidTags;
  }

  function toIsoOrNull(value) {
    if (!value) return null;
    try {
      return value.toISOString();
    } catch (error) {
      return null;
    }
  }

  function serializeTimestamped(entity) {
    return {
      added: toIsoOrNull(entity.added),
      modified: toIsoOrNull(entity.modified)
    };
  }

  function serializeTask(t) {
    const timestamps = serializeTimestamped(t);
    return {
      id:        bareId(t.id),
      name:      t.name,
      note:      t.note,
      flagged:   t.flagged,
      deferDate: toIsoOrNull(t.deferDate),
      dueDate:   toIsoOrNull(t.dueDate),
      duration:  t.estimatedMinutes,
      projectId: t.containingProject ? bareId(t.containingProject.id) : null,
      folderId:  (t.containingProject && t.containingProject.folder)
                ? bareId(t.containingProject.folder.id)
                : null,
      contexts:  t.tags.map(x => bareId(x.id)),
      completed: t.completed,
      dropped:   !t.effectiveActive,
      added:     timestamps.added,
      modified:  timestamps.modified
    };
  }

  lib.listRemaining = () => {
    const startTime = Date.now();
    
    // Check cache first for performance  
    const cacheKey = getCacheKey('listRemaining', {});
    const cached = getCached(cacheKey);
    if (cached) {
      console.log(`listRemaining: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    // Single-pass filtering and serialization
    const results = [];
    for (const t of flattenedTasks) {
      if (!t.completed) {
        results.push(serializeTask(t));
      }
    }
    
    // Cache the result
    setCached(cacheKey, results);
    console.log(`listRemaining: ${Date.now() - startTime}ms (processed ${results.length} results)`);
    return results;
  };

  lib.getTask = params => {
    const t = flattenedTasks.find(t => bareId(t.id) === params.taskId);
    return t ? serializeTask(t) : null;
  };

  lib.listProjects = () =>
    flattenedProjects.map(p => ({
      id: bareId(p.id),
      name: p.name,
      added: toIsoOrNull(p.added),
      modified: toIsoOrNull(p.modified)
    }));

  lib.listTags = () =>
    flattenedTags.map(t => ({
      id: bareId(t.id),
      name: t.name,
      added: toIsoOrNull(t.added),
      modified: toIsoOrNull(t.modified)
    }));

  lib.listTasksByProject = params => {
    const proj = flattenedProjects.find(p => bareId(p.id) === params.projectId);
    if (!proj) throw new Error("Unknown project ID: " + params.projectId);
    return proj.flattenedTasks.map(serializeTask);
  };

  lib.listTasksByTag = params => {
    const startTime = Date.now();
    
    // Check cache first for performance
    const cacheKey = getCacheKey('listTasksByTag', params);
    const cached = getCached(cacheKey);
    if (cached) {
      console.log(`listTasksByTag: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }

    const tag = flattenedTags.find(t => bareId(t.id) === params.tagId);
    if (!tag) throw new Error("Unknown tag ID: " + params.tagId);
    
    // Validate project if specified
    let targetProjectId = null;
    if (params.projectId) {
      const proj = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!proj) throw new Error("Unknown project ID: " + params.projectId);
      targetProjectId = params.projectId;
    }
    
    // Single-pass filtering with early termination
    const results = [];
    const includeCompleted = params.includeCompleted || false;
    
    for (const t of flattenedTasks) {
      // Check if task has the required tag (most selective filter first)
      if (!t.tags.some(taskTag => bareId(taskTag.id) === params.tagId)) continue;
      
      // Apply completion filter
      if (!includeCompleted && t.completed) continue;
      
      // Apply active filter if specified
      if (params.active !== undefined && t.effectiveActive !== params.active) continue;
      
      // Apply project scoping if specified
      if (targetProjectId && (!t.containingProject || bareId(t.containingProject.id) !== targetProjectId)) continue;
      
      // Task passed all filters
      results.push(serializeTask(t));
    }
    
    // Cache the result
    setCached(cacheKey, results);
    console.log(`listTasksByTag: ${Date.now() - startTime}ms (processed ${results.length} results)`);
    return results;
  };

  lib.queryTasks = params => {
    const startTime = Date.now();
    
    // Check cache first for performance
    const cacheKey = getCacheKey('queryTasks', params);
    const cached = getCached(cacheKey);
    if (cached) {
      console.log(`queryTasks: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }

    // Pre-parse date filters for efficiency
    const dueBefore = params.dueBefore ? new Date(params.dueBefore) : null;
    const dueAfter = params.dueAfter ? new Date(params.dueAfter) : null;
    const deferBefore = params.deferBefore ? new Date(params.deferBefore) : null;
    const deferAfter = params.deferAfter ? new Date(params.deferAfter) : null;
    
    // Extract exclusion parameters with defaults and optimize for performance
    const excludeProjectIds = params.excludeProjectIds || [];
    const excludeTagIds = params.excludeTagIds || [];
    const excludeFolderIds = params.excludeFolderIds || [];
    
    // Convert to Sets for O(1) lookup performance
    const excludeProjectSet = new Set(excludeProjectIds);
    const excludeTagSet = new Set(excludeTagIds);
    const excludeFolderSet = new Set(excludeFolderIds);

    // Validate tag combination if provided - Task 1-16
    if (params.tagCombination) {
      const invalidTags = validateTagCombination(params.tagCombination);
      if (invalidTags.length > 0) {
        throw new Error(`Invalid tag IDs: ${invalidTags.join(', ')}`);
      }
    }

    // Start with most efficient dataset
    let sourceTasks;
    if (params.projectId) {
      const proj = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!proj) throw new Error("Unknown project ID: " + params.projectId);
      sourceTasks = proj.flattenedTasks;
    } else if (params.tagCombination) {
      // For tag combinations, use all tasks and filter in the main loop
      // This handles complex AND/OR/NOT logic efficiently
      sourceTasks = flattenedTasks;
    } else if (params.tagId) {
      // Legacy single tag support for backward compatibility
      const tag = flattenedTags.find(t => bareId(t.id) === params.tagId);
      if (!tag) throw new Error("Unknown tag ID: " + params.tagId);
      // Pre-filter by tag to reduce dataset size
      sourceTasks = flattenedTasks.filter(t => 
        t.tags.some(taskTag => bareId(taskTag.id) === params.tagId)
      );
    } else {
      sourceTasks = flattenedTasks;
    }

    // Single-pass filtering for optimal performance
    const results = [];
    for (const t of sourceTasks) {
      // Apply all filters in single pass with early termination
      
      // Completion filter (most common filter first)
      if (params.includeCompleted !== true && t.completed) continue;
      if (params.completed !== undefined && t.completed !== params.completed) continue;
      
      // Status filters (quick boolean checks)
      if (params.flagged !== undefined && t.flagged !== params.flagged) continue;
      if (params.dropped !== undefined && !t.effectiveActive !== params.dropped) continue;
      if (params.active !== undefined && t.effectiveActive !== params.active) continue;
      
      // Date filters (pre-parsed for efficiency)
      if (dueBefore && (!t.dueDate || t.dueDate >= dueBefore)) continue;
      if (dueAfter && (!t.dueDate || t.dueDate <= dueAfter)) continue;
      if (deferBefore && (!t.deferDate || t.deferDate >= deferBefore)) continue;
      if (deferAfter && (!t.deferDate || t.deferDate <= deferAfter)) continue;
      
      // Duration filters
      if (params.minDuration !== undefined && (!t.estimatedMinutes || t.estimatedMinutes < params.minDuration)) continue;
      if (params.maxDuration !== undefined && (!t.estimatedMinutes || t.estimatedMinutes > params.maxDuration)) continue;
      
      // Task status filter (blocked tasks)
      if (params.blocked !== undefined) {
        const isBlocked = t.taskStatus === Task.Status.Blocked;
        if (params.blocked !== isBlocked) continue;
      }
      
      // Advanced metadata filters - added for Task 1-20
      // Time estimate filters
      if (params.hasEstimate !== undefined) {
        const hasEst = t.estimatedMinutes && t.estimatedMinutes > 0;
        if (hasEst !== params.hasEstimate) continue;
      }
      if (params.minEstimate !== undefined) {
        if (!t.estimatedMinutes || t.estimatedMinutes < params.minEstimate) continue;
      }
      if (params.maxEstimate !== undefined) {
        if (t.estimatedMinutes && t.estimatedMinutes > params.maxEstimate) continue;
      }
      
      // Content-based filters
      if (params.hasNotes !== undefined) {
        const hasNotes = t.note && t.note.trim().length > 0;
        if (hasNotes !== params.hasNotes) continue;
      }
      if (params.hasDueDate !== undefined) {
        const hasDue = !!t.dueDate;
        if (hasDue !== params.hasDueDate) continue;
      }
      if (params.hasDeferDate !== undefined) {
        const hasDefer = !!t.deferDate;
        if (hasDefer !== params.hasDeferDate) continue;
      }
      
      // Advanced date-based filters using helper functions
      if (params.isOverdue !== undefined) {
        if (isOverdue(t.dueDate) !== params.isOverdue) continue;
      }
      if (params.isDueToday !== undefined) {
        if (isToday(t.dueDate) !== params.isDueToday) continue;
      }
      if (params.isDueSoon !== undefined) {
        if (!isDueSoon(t.dueDate, params.isDueSoon)) continue;
      }
      
      // Availability filter using helper function
      if (params.isAvailable !== undefined) {
        if (isAvailableNow(t) !== params.isAvailable) continue;
      }
      
      // Boolean tag combination filtering - Task 1-16
      if (params.tagCombination) {
        if (!matchesTagCombination(t, params.tagCombination)) continue;
      } else if (params.tagId && params.projectId) {
        // Legacy tagId filtering when both projectId and tagId are specified
        // (sourceTasks was pre-filtered by project, so we need to check tag here)
        if (!t.tags.some(taskTag => bareId(taskTag.id) === params.tagId)) continue;
      }
      
      // Exclusion filters - apply after all other filters for efficiency
      // Project exclusion check - use Set for O(1) lookup
      if (excludeProjectSet.size > 0 && t.containingProject && 
          excludeProjectSet.has(bareId(t.containingProject.id))) continue;
      
      // Tag exclusion check - exclude if task has any of the excluded tags
      if (excludeTagSet.size > 0 && t.tags.some(tag => 
          excludeTagSet.has(bareId(tag.id)))) continue;
      
      // Folder exclusion check - exclude if project is in excluded folder hierarchy
      if (excludeFolderSet.size > 0 && t.containingProject &&
          isInExcludedFolderOptimized(t.containingProject, excludeFolderSet)) continue;
      
      // Task passed all filters - serialize and add to results
      results.push(serializeTask(t));
    }

    // Cache the result for future queries
    setCached(cacheKey, results);
    console.log(`queryTasks: ${Date.now() - startTime}ms (processed ${results.length} results)`);
    return results;
  };

  lib.createTask = params => {
    let proj = null;
    if (params.projectId) {
      proj = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!proj) throw new Error("Unknown project ID: " + params.projectId);
    }
    const tags = (params.tagIds || []).map(id => {
      const tag = flattenedTags.find(t => bareId(t.id) === id);
      if (!tag) throw new Error("Unknown tag ID: " + id);
      return tag;
    });

    const t = proj ? new Task(params.name, proj) : new Task(params.name);
    if (params.note !== undefined)    t.note     = params.note;
    if (params.flagged !== undefined) t.flagged  = params.flagged;
    if (params.estimatedMinutes !== undefined) t.estimatedMinutes = params.estimatedMinutes;
    if (params.deferDate)             t.deferDate = new Date(params.deferDate);
    if (params.dueDate)               t.dueDate   = new Date(params.dueDate);
    tags.forEach(tag => t.addTag(tag));
    
    // Invalidate cache after mutation
    queryCache.clear();
    
    return serializeTask(t);
  };

  lib.updateTask = params => {
    const t = flattenedTasks.find(x => bareId(x.id) === params.taskId);
    if (!t) throw new Error("Unknown task ID: " + params.taskId);

    if (params.name      !== undefined) t.name      = params.name;
    if (params.note      !== undefined) t.note      = params.note;
    if (params.flagged   !== undefined) t.flagged   = params.flagged;
    if (params.completed !== undefined) t.completed = params.completed;
    if (params.dropped   !== undefined) t.active    = !params.dropped; // dropped = !active
    if (params.deferDate               ) t.deferDate = new Date(params.deferDate);
    if (params.dueDate                 ) t.dueDate   = new Date(params.dueDate);
    if (params.estimatedMinutes !== undefined) t.estimatedMinutes = params.estimatedMinutes;

    if (params.projectId) {
      const proj = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!proj) throw new Error("Unknown project ID: " + params.projectId);
      t.project = proj;
    }
    if (params.tagIds) {
      t.tags.forEach(tag => t.removeTag(tag));
      params.tagIds.forEach(id => {
        const tag = flattenedTags.find(x => bareId(x.id) === id);
        if (!tag) throw new Error("Unknown tag ID: " + id);
        t.addTag(tag);
      });
    }
    
    // Invalidate cache after mutation
    queryCache.clear();
    
    return serializeTask(t);
  };

  lib.completeTask = params => {
    const t = flattenedTasks.find(x => bareId(x.id) === params.taskId);
    if (!t) throw new Error("Unknown task ID: " + params.taskId);
    t.markComplete();
    
    // Invalidate cache after mutation
    queryCache.clear();
    
    return { success: true };
  };

  lib.deleteTask = params => {
    const t = flattenedTasks.find(x => bareId(x.id) === params.taskId);
    if (!t) throw new Error("Unknown task ID: " + params.taskId);
    
    // Use the OmniFocus database deleteObject method
    deleteObject(t);
    
    // Invalidate cache after mutation
    queryCache.clear();
    
    return { success: true, deleted: true };
  };

  lib.listInbox = params => {
    const startTime = Date.now();
    
    // Check organizational cache for inbox data with shorter TTL (inbox is dynamic)
    const cacheKey = getSmartCacheKey('listInbox', params, 'organizational');
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.inboxDataTTL);
    if (cached) {
      trackPerformance('listInbox', startTime, true);
      console.log(`listInbox: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    // Access the inbox collection - OmniFocus provides global 'inbox' variable
    let inboxItems = Array.from(inbox);
    
    // Apply completion status filtering (default to excluding completed)
    const includeCompleted = params.includeCompleted !== undefined ? params.includeCompleted : false;
    if (!includeCompleted) {
      inboxItems = inboxItems.filter(task => !task.completed);
    }
    
    // Apply limit if specified
    const limit = params.limit;
    if (limit !== undefined) {
      if (typeof limit !== 'number' || limit <= 0 || !Number.isInteger(limit)) {
        throw new Error("Limit must be a positive integer");
      }
      inboxItems = inboxItems.slice(0, limit);
    }
    
    // Serialize all inbox items using existing task serialization
    const results = inboxItems.map(serializeTask);
    
    // Cache the result with shorter TTL for dynamic inbox data
    setCachedWithTTL(cacheKey, results, queryCache, CACHE_CONFIG.maxCacheSize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('listInbox', startTime, false);
    console.log(`[TIMING] listInbox completed in ${processingTime}ms (${results.length} items)`);
    
    return results;
  };

  lib.processInboxItem = params => {
    const startTime = Date.now();
    
    // Invalidate inbox cache since we're modifying inbox items
    invalidateOrganizationalCache('inbox', null);
    
    // Validate required parameters
    if (!params.taskId || typeof params.taskId !== 'string') {
      throw new Error("Task ID is required and must be a non-empty string");
    }
    
    // Find the task and verify it's in the inbox
    const task = flattenedTasks.find(t => bareId(t.id) === params.taskId);
    if (!task) {
      throw new Error(`Task not found with ID: ${params.taskId}`);
    }
    
    if (!task.inInbox) {
      throw new Error(`Task ${params.taskId} is not in the inbox`);
    }
    
    // Track which operations were performed for logging
    const operations = [];
    
    // Handle project assignment (move out of inbox)
    if (params.projectId) {
      const project = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!project) {
        throw new Error(`Project not found with ID: ${params.projectId}`);
      }
      moveTasks([task], project);
      operations.push('assign_project');
    }
    
    // Handle tag additions
    if (params.tagIds && Array.isArray(params.tagIds) && params.tagIds.length > 0) {
      const tags = params.tagIds.map(tagId => {
        const tag = flattenedTags.find(t => bareId(t.id) === tagId);
        if (!tag) {
          throw new Error(`Tag not found with ID: ${tagId}`);
        }
        return tag;
      });
      
      // Add tags to the task (avoid duplicates)
      tags.forEach(tag => {
        if (!task.tags.some(existingTag => bareId(existingTag.id) === bareId(tag.id))) {
          task.addTag(tag);
        }
      });
      operations.push('add_tags');
    }
    
    // Handle basic task property updates
    if (params.name !== undefined) {
      task.name = params.name;
      operations.push('rename');
    }
    
    if (params.note !== undefined) {
      task.note = params.note;
      operations.push('set_note');
    }
    
    if (params.flagged !== undefined) {
      task.flagged = params.flagged;
      operations.push('flag');
    }
    
    if (params.estimatedMinutes !== undefined) {
      task.estimatedMinutes = params.estimatedMinutes;
      operations.push('set_duration');
    }
    
    // Handle date setting
    if (params.deferDate || params.dueDate) {
      if (params.deferDate) {
        const deferDate = new Date(params.deferDate);
        if (isNaN(deferDate.getTime())) {
          throw new Error(`Invalid defer date format: ${params.deferDate}`);
        }
        task.deferDate = deferDate;
      }
      
      if (params.dueDate) {
        const dueDate = new Date(params.dueDate);
        if (isNaN(dueDate.getTime())) {
          throw new Error(`Invalid due date format: ${params.dueDate}`);
        }
        task.dueDate = dueDate;
      }
      operations.push('set_dates');
    }
    
    // Handle deletion (this should be mutually exclusive with other operations)
    if (params.deleteTask === true) {
      if (operations.length > 0) {
        throw new Error("Delete operation cannot be combined with other operations");
      }
      deleteObject(task);
      
      // Clear cache after mutation
      queryCache.clear();
      
      const processingTime = Date.now() - startTime;
      console.log(`[TIMING] processInboxItem (delete) completed in ${processingTime}ms`);
      
      return { success: true, deleted: true, taskId: params.taskId };
    }
    
    // Ensure at least one operation was requested
    if (operations.length === 0) {
      throw new Error("At least one operation must be specified: projectId, tagIds, name, note, flagged, estimatedMinutes, deferDate, dueDate, or deleteTask");
    }
    
    // Clear cache after mutations
    queryCache.clear();
    
    const processingTime = Date.now() - startTime;
    trackPerformance('processInboxItem', startTime, false);
    console.log(`[TIMING] processInboxItem (${operations.join(', ')}) completed in ${processingTime}ms`);
    
    return serializeTask(task);
  };

  // ===== BULK INBOX PROCESSING (Task 3-3) =====
  
  lib.getInboxProcessingContext = params => {
    const startTime = Date.now();
    
    // Validate parameters with performance limits
    const maxItems = Math.min(params.max_items || 15, 25); // Reduced default and max for performance
    const includeExamples = params.include_examples === true; // Default to false for performance
    const includeUserPatterns = params.include_user_patterns !== false;
    const preAnalyzeContent = params.pre_analyze_content === true; // Default to false for performance
    const defaultProjectId = params.default_project_id || "bdRrScFC2eT"; // Default to Today project
    
    if (typeof maxItems !== 'number' || maxItems <= 0 || maxItems > 200) {
      throw new Error("max_items must be a positive number between 1 and 200");
    }
    
    // Validate default project (hardwired to Today project unless overridden)
    let defaultProject = null;
    if (defaultProjectId) {
      defaultProject = flattenedProjects.find(p => bareId(p.id) === defaultProjectId);
      if (!defaultProject) {
        const projectName = defaultProjectId === "bdRrScFC2eT" ? "Today project" : `project ${defaultProjectId}`;
        throw new Error(`Default ${projectName} not found. Please ensure the Today project exists.`);
      }
      console.log(`[INBOX_CONTEXT] Using default project: ${defaultProject.name} (${defaultProjectId === "bdRrScFC2eT" ? "Today project" : "custom"})`);
    }
    
    try {
      console.log(`[INBOX_CONTEXT] Loading context for up to ${maxItems} items`);
      
      // Get inbox items with basic analysis
      let inboxItems = Array.from(inbox).filter(task => !task.completed);
      
      // Apply item limit
      if (inboxItems.length > maxItems) {
        inboxItems = inboxItems.slice(0, maxItems);
      }
      
              // Enhanced serialization with optional pre-analysis
        const enrichedItems = inboxItems.map((task, index) => {
          const basicTask = serializeTask(task);
          
          // Start with basic enrichment
          const enriched = {
            ...basicTask,
            created_date: task.creationDate ? task.creationDate.toISOString() : null,
            content_type: classifyTaskContent(task),
            
            // Only do expensive analysis if requested
            extracted_dates: preAnalyzeContent ? extractDatesFromContent(task) : [],
            suggested_projects: preAnalyzeContent ? suggestProjectsForTask(task, defaultProject).slice(0, 3) : [], // Limit to top 3 to accommodate default
            suggested_tags: preAnalyzeContent ? suggestTagsForTask(task).slice(0, 2) : [], // Limit to top 2
            enhanced_name: preAnalyzeContent ? enhanceTaskName(task) : null,
            email_metadata: analyzeEmailContent(task),
            continuation_signals: preAnalyzeContent ? findContinuationSignals(task) : [],
            subtask_breakdown: preAnalyzeContent ? analyzeForSubtaskBreakdown(task) : null
          };
          
          return enriched;
        });
      
              // Build user intelligence patterns (simplified for performance)
        const userPatterns = includeUserPatterns ? buildSimplifiedUserPatterns() : null;
      
              // Get available destinations with smart activity scoring
        const availableProjects = (flattenedProjects || [])
          .map(p => {
            const projectData = {
              id: bareId(p.id),
              name: p.name,
              parent_id: p.folder ? bareId(p.folder.id) : null,
              status: p.status ? p.status.name : 'active',
              task_count: p.flattenedTasks ? p.flattenedTasks.length : 0,
              activity_score: calculateProjectActivityScore(p)
            };
            
            return projectData;
          })
          .sort((a, b) => b.activity_score - a.activity_score) // Sort by activity score
          .slice(0, 30); // Limit for performance
        
        const availableTags = flattenedTags
          .slice(0, 20) // Limit for performance
          .map(t => ({
            id: bareId(t.id),
            name: t.name,
            category: getCategoryFromTagName(t.name)
          }));
      
              // Historical processing examples (simplified)
        const processingExamples = includeExamples ? [] : []; // Disabled for now for performance
        
        // Pre-calculated shortcuts for UI (simplified)
        const suggestedShortcuts = generateSimplifiedShortcuts(enrichedItems);
      
      // Activity-based project shortcuts for Claude
      const topActiveProjects = availableProjects.slice(0, 5).map((project, index) => {
        const activityIndicator = project.activity_score > 50 ? ' ⚡ (very active)' : 
                                 project.activity_score > 30 ? ' ⭐ (active)' : 
                                 project.activity_score > 15 ? ' ● (some activity)' : ' (dormant)';
        return {
          shortcut: `p${index + 1}`,
          description: `Move to "${project.name}"${activityIndicator}`,
          project_id: project.id,
          activity_score: project.activity_score
        };
      });

      const result = {
        inbox_items: enrichedItems,
        user_patterns: userPatterns,
        available_projects: availableProjects,
        available_tags: availableTags,
        processing_examples: processingExamples,
        suggested_shortcuts: suggestedShortcuts,
        top_active_projects: topActiveProjects,
        default_project: defaultProject ? {
          id: bareId(defaultProject.id),
          name: defaultProject.name,
          note: 'Most tasks will default to this project unless content suggests otherwise'
        } : null
      };
      
      const processingTime = Date.now() - startTime;
      trackPerformance('getInboxProcessingContext', startTime, false);
      console.log(`[TIMING] getInboxProcessingContext completed in ${processingTime}ms (${enrichedItems.length} items)`);
      
      return result;
      
    } catch (error) {
      console.log(`[ERROR] getInboxProcessingContext failed: ${error.message}`);
      throw new Error(`Failed to get inbox processing context: ${error.message}`);
    }
  };

  // Helper functions for inbox processing context

  function extractDatesFromContent(task) {
    const dates = [];
    const content = (task.name + ' ' + (task.note || '')).toLowerCase();
    
    // Simple date patterns - can be enhanced
    const patterns = [
      { regex: /(?:by|due)\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)/i, type: 'due' },
      { regex: /(?:by|due)\s+(today|tomorrow|next week)/i, type: 'due' },
      { regex: /(?:defer|start|begin)\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)/i, type: 'defer' },
      { regex: /(?:defer|start|begin)\s+(today|tomorrow|next week)/i, type: 'defer' }
    ];
    
    patterns.forEach(pattern => {
      const match = content.match(pattern.regex);
      if (match) {
        dates.push({
          type: pattern.type,
          date: convertRelativeDateToISO(match[1]),
          confidence: 0.8
        });
      }
    });
    
    return dates;
  }

  function convertRelativeDateToISO(dateString) {
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    
    switch (dateString.toLowerCase()) {
      case 'today':
        return today.toISOString();
      case 'tomorrow':
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);
        return tomorrow.toISOString();
      case 'next week':
        const nextWeek = new Date(today);
        nextWeek.setDate(nextWeek.getDate() + 7);
        return nextWeek.toISOString();
      default:
        // For day names, find next occurrence
        const dayNames = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
        const targetDay = dayNames.indexOf(dateString.toLowerCase());
        if (targetDay !== -1) {
          const nextDay = new Date(today);
          const currentDay = nextDay.getDay();
          const daysUntilTarget = (targetDay - currentDay + 7) % 7;
          nextDay.setDate(nextDay.getDate() + (daysUntilTarget === 0 ? 7 : daysUntilTarget));
          return nextDay.toISOString();
        }
        return today.toISOString();
    }
  }

  function suggestProjectsForTask(task, defaultProject = null) {
    const suggestions = [];
    const content = (task.name + ' ' + (task.note || '')).toLowerCase();
    
    // Quick keyword-based matching combined with activity scoring
    const keywords = content.split(/\s+/).filter(word => word.length > 3);
    
    // Get projects sorted by activity score (most active first)
    const activeProjects = flattenedProjects
      .filter(p => !p.completed) // Include all non-completed projects
      .map(p => ({
        project: p,
        activity_score: calculateProjectActivityScore(p)
      }))
      .sort((a, b) => b.activity_score - a.activity_score)
      .slice(0, 25) // Check top 25 most active projects
      .map(item => item.project);
    
    // First, add default project if specified (with high confidence unless content strongly suggests otherwise)
    if (defaultProject) {
      let defaultConfidence = 0.85; // High default confidence
      let defaultReason = 'Default project for inbox processing';
      
      // Check if content strongly suggests a different project
      const projectName = defaultProject.name.toLowerCase();
      let contentScore = 0;
      keywords.forEach(keyword => {
        if (projectName.includes(keyword)) {
          contentScore += 0.4;
        }
      });
      
      // If content matches default project, increase confidence
      if (contentScore > 0.3) {
        defaultConfidence = 0.95;
        defaultReason = 'Default project + content match';
      }
      
      // Check for strong content matches with other projects that might override default
      const strongContentMatches = activeProjects.filter(project => {
        if (bareId(project.id) === bareId(defaultProject.id)) return false;
        const otherProjectName = project.name.toLowerCase();
        let otherContentScore = 0;
        keywords.forEach(keyword => {
          if (otherProjectName.includes(keyword)) {
            otherContentScore += 0.4;
          }
        });
        return otherContentScore > 0.7; // Strong content match threshold
      });
      
      // Lower default confidence if there are strong content matches elsewhere
      if (strongContentMatches.length > 0) {
        defaultConfidence = 0.60; // Still suggest default, but with lower confidence
        defaultReason = 'Default project (content may suggest others)';
      }
      
      suggestions.push({
        id: bareId(defaultProject.id),
        name: defaultProject.name,
        confidence: defaultConfidence,
        reason: defaultReason,
        activity_score: calculateProjectActivityScore(defaultProject),
        is_default: true
      });
    }
    
    // Then add other project suggestions based on content and activity
    activeProjects.forEach(project => {
      // Skip if this is already the default project
      if (defaultProject && bareId(project.id) === bareId(defaultProject.id)) {
        return;
      }
      
      const projectName = project.name.toLowerCase();
      let contentScore = 0;
      let activityBonus = 0;
      
      // Content matching score
      keywords.forEach(keyword => {
        if (projectName.includes(keyword)) {
          contentScore += 0.4;
        }
      });
      
      // Activity-based bonus for recently used projects
      const activityScore = calculateProjectActivityScore(project);
      if (activityScore > 50) activityBonus = 0.3; // Very active project
      else if (activityScore > 30) activityBonus = 0.2; // Active project
      else if (activityScore > 15) activityBonus = 0.1; // Somewhat active
      
      const totalScore = contentScore + activityBonus;
      
      // Include projects with either content match OR high activity
      // Lower threshold when default project is specified to show alternatives
      const threshold = defaultProject ? 0.15 : 0.2;
      if (totalScore > threshold) {
        let reason = 'Content match';
        if (contentScore === 0 && activityBonus > 0) {
          reason = 'Recently active project';
        } else if (contentScore > 0 && activityBonus > 0) {
          reason = 'Content match + recently active';
        }
        
        suggestions.push({
          id: bareId(project.id),
          name: project.name,
          confidence: Math.min(totalScore, 0.95),
          reason: reason,
          activity_score: activityScore,
          is_default: false
        });
      }
    });
    
    // Sort by confidence (default project should naturally be first due to high confidence)
    return suggestions.sort((a, b) => b.confidence - a.confidence).slice(0, 3);
  }

  function suggestTagsForTask(task) {
    const suggestions = [];
    const content = (task.name + ' ' + (task.note || '')).toLowerCase();
    
    // Common tag patterns
    const tagPatterns = [
      { keywords: ['call', 'phone', 'contact'], tag: '@calls' },
      { keywords: ['buy', 'purchase', 'shop', 'store'], tag: '@errands' },
      { keywords: ['meeting', 'discuss', 'agenda'], tag: '@agenda' },
      { keywords: ['email', 'respond', 'reply'], tag: '@computer' },
      { keywords: ['urgent', 'asap', 'immediate'], tag: '@urgent' },
      { keywords: ['read', 'review', 'research'], tag: '@read' }
    ];
    
    tagPatterns.forEach(pattern => {
      const matches = pattern.keywords.filter(keyword => content.includes(keyword));
      if (matches.length > 0) {
        const tag = flattenedTags.find(t => t.name.toLowerCase() === pattern.tag.toLowerCase());
        if (tag) {
          suggestions.push({
            id: bareId(tag.id),
            name: tag.name,
            confidence: 0.7 + (matches.length * 0.1),
            reason: `Content suggests: ${matches.join(', ')}`
          });
        }
      }
    });
    
    return suggestions.slice(0, 3);
  }

  function enhanceTaskName(task) {
    const originalName = task.name;
    
    // Simple name enhancement patterns
    if (originalName.length < 10 && !originalName.includes(' ')) {
      // Very short names might need enhancement
      return {
        suggestion: originalName + ' (needs clarification)',
        reasoning: 'Task name is very brief',
        confidence: 0.3
      };
    }
    
    // Check for action words
    const actionWords = ['buy', 'call', 'email', 'schedule', 'book', 'pay', 'submit'];
    const hasAction = actionWords.some(word => originalName.toLowerCase().includes(word));
    
    if (!hasAction) {
      return {
        suggestion: 'Complete: ' + originalName,
        reasoning: 'Added action verb for clarity',
        confidence: 0.6
      };
    }
    
    return null;
  }

  function analyzeForSubtaskBreakdown(task) {
    const content = (task.name + ' ' + (task.note || '')).toLowerCase();
    const name = task.name.toLowerCase();
    
    // Patterns that suggest subtask breakdown
    const complexTaskPatterns = [
      { keywords: ['plan', 'organize', 'prepare'], type: 'planning', confidence: 0.8 },
      { keywords: ['research', 'investigate', 'analyze'], type: 'research', confidence: 0.7 },
      { keywords: ['project', 'campaign', 'initiative'], type: 'project', confidence: 0.9 },
      { keywords: ['meeting', 'conference', 'event'], type: 'event', confidence: 0.8 },
      { keywords: ['trip', 'vacation', 'travel'], type: 'travel', confidence: 0.9 },
      { keywords: ['move', 'relocate', 'setup'], type: 'logistics', confidence: 0.8 },
      { keywords: ['launch', 'deploy', 'implement'], type: 'implementation', confidence: 0.8 }
    ];
    
    // Check for list-like content (numbered items, bullet points)
    const hasListStructure = content.includes('\n-') || content.includes('\n1.') || 
                            content.includes('\n•') || content.includes('\n*');
    
    // Check for multiple action words indicating complex task
    const actionWords = ['call', 'email', 'book', 'buy', 'schedule', 'contact', 'research', 
                        'prepare', 'organize', 'create', 'setup', 'configure'];
    const actionCount = actionWords.filter(word => content.includes(word)).length;
    
    let suggestionType = null;
    let confidence = 0;
    let suggestedSubtasks = [];
    
    // Pattern matching
    for (const pattern of complexTaskPatterns) {
      if (pattern.keywords.some(keyword => name.includes(keyword))) {
        suggestionType = pattern.type;
        confidence = pattern.confidence;
        suggestedSubtasks = generateSubtasksByType(task, pattern.type);
        break;
      }
    }
    
    // List structure detection
    if (hasListStructure) {
      confidence = Math.max(confidence, 0.9);
      suggestionType = suggestionType || 'list_breakdown';
      suggestedSubtasks = extractSubtasksFromList(task);
    }
    
    // Multiple action words
    if (actionCount >= 3) {
      confidence = Math.max(confidence, 0.7);
      suggestionType = suggestionType || 'multi_action';
    }
    
    // Only suggest if confidence is above threshold
    if (confidence < 0.6) {
      return null;
    }
    
    return {
      should_break_down: true,
      confidence: confidence,
      breakdown_type: suggestionType,
      suggested_subtasks: suggestedSubtasks,
      reasoning: getBreakdownReasoning(suggestionType, task, actionCount, hasListStructure)
    };
  }

  function generateSubtasksByType(task, type) {
    const name = task.name;
    
    switch (type) {
      case 'planning':
        return [
          { name: `Research options for ${name.toLowerCase()}`, tags: ['@research'] },
          { name: `Create plan for ${name.toLowerCase()}`, tags: ['@planning'] },
          { name: `Execute ${name.toLowerCase()}`, tags: ['@action'] },
          { name: `Review results of ${name.toLowerCase()}`, tags: ['@review'] }
        ];
        
      case 'travel':
        return [
          { name: 'Research destinations and dates' },
          { name: 'Book flights/transportation' },
          { name: 'Reserve accommodation' },
          { name: 'Plan activities and itinerary' },
          { name: 'Arrange work coverage' },
          { name: 'Pack and prepare for departure' }
        ];
        
      case 'event':
        return [
          { name: 'Set agenda and objectives' },
          { name: 'Invite participants' },
          { name: 'Book venue and resources' },
          { name: 'Prepare materials' },
          { name: 'Conduct event' },
          { name: 'Follow up and document outcomes' }
        ];
        
      case 'research':
        return [
          { name: 'Define research questions' },
          { name: 'Identify sources and resources' },
          { name: 'Gather and analyze information' },
          { name: 'Document findings' },
          { name: 'Present or share results' }
        ];
        
      case 'project':
        return [
          { name: 'Define project scope and goals' },
          { name: 'Plan project phases and timeline' },
          { name: 'Execute project phases' },
          { name: 'Monitor progress and adjust' },
          { name: 'Complete and deliver project' }
        ];
        
      default:
        return [];
    }
  }

  function extractSubtasksFromList(task) {
    const content = task.note || '';
    const subtasks = [];
    
    // Extract lines that look like list items
    const lines = content.split('\n');
    const listItemRegex = /^[\s]*[-•*]\s*(.+)$|^[\s]*\d+\.\s*(.+)$/;
    
    lines.forEach(line => {
      const match = line.match(listItemRegex);
      if (match) {
        const taskName = (match[1] || match[2]).trim();
        if (taskName.length > 3) { // Ignore very short items
          subtasks.push({ name: taskName });
        }
      }
    });
    
    return subtasks.slice(0, 8); // Limit to 8 subtasks
  }

  function getBreakdownReasoning(type, task, actionCount, hasListStructure) {
    if (hasListStructure) {
      return 'Task contains a list structure that could be broken into subtasks';
    }
    
    if (actionCount >= 3) {
      return `Task contains ${actionCount} action words, suggesting multiple steps`;
    }
    
    switch (type) {
      case 'planning':
        return 'Planning tasks typically benefit from breaking into research, planning, execution phases';
      case 'travel':
        return 'Travel arrangements involve multiple coordinated steps';
      case 'event':
        return 'Events require coordination of multiple preparation and execution steps';
      case 'research':
        return 'Research projects benefit from structured approach with defined phases';
      case 'project':
        return 'Project tasks should be broken into manageable phases';
      default:
        return 'Task appears complex enough to benefit from subtask breakdown';
    }
  }

  function classifyTaskContent(task) {
    const content = task.name + ' ' + (task.note || '');
    
    // Email detection
    if (content.includes('Fwd:') || content.includes('From:') || content.includes('@') && content.includes('Subject:')) {
      return 'email';
    }
    
    // Continuation signals
    if (content.includes('http://') || content.includes('https://') || 
        content.includes('>>') || content.includes('))') ||
        content.toLowerCase().includes('additional') || content.toLowerCase().includes('more info')) {
      return 'continuation_candidate';
    }
    
    return 'standard';
  }

  function analyzeEmailContent(task) {
    const content = task.name + ' ' + (task.note || '');
    
    if (task.name.startsWith('Fwd:') || content.includes('Subject:')) {
      const subjectMatch = content.match(/(?:Fwd:\s*|Subject:\s*)([^\n\r]+)/i);
      return {
        subject: subjectMatch ? subjectMatch[1].trim() : null,
        has_attachments: content.includes('attachment') || content.includes('attached'),
        sender: extractSenderFromEmail(content),
        extracted_task_name: extractTaskNameFromEmail(content),
        preservation_note: content
      };
    }
    
    return null;
  }

  function findContinuationSignals(task) {
    const signals = [];
    const content = task.name + ' ' + (task.note || '');
    
    // URL detection
    const urlMatches = content.match(/(https?:\/\/[^\s]+)/g);
    if (urlMatches) {
      signals.push({
        type: 'url',
        content: urlMatches[0],
        target_item_hints: findSimilarTasks(content)
      });
    }
    
    // Project reference detection
    if (content.toLowerCase().includes('project')) {
      signals.push({
        type: 'project_reference',
        content: content,
        target_item_hints: findProjectReferenceTargets(content)
      });
    }
    
    return signals;
  }

  function buildSimplifiedUserPatterns() {
    // Quick analysis with limited scope for performance
    const recentProjects = flattenedProjects
      .filter(p => p.effectiveActive && !p.completed)
      .slice(0, 10) // Just take first 10
      .map(p => ({
        id: bareId(p.id),
        name: p.name,
        task_count: p.flattenedTasks.length
      }));
    
    // Top 10 tags by simple count
    const commonTags = flattenedTags
      .slice(0, 10) // Just take first 10
      .map(t => ({
        id: bareId(t.id),
        name: t.name,
        usage_count: getTagUsageFrequency(t)
      }))
      .sort((a, b) => b.usage_count - a.usage_count);
    
    return {
      recent_projects: recentProjects,
      common_tags: commonTags,
      processing_velocity: 3,
      preferred_batch_size: 10
    };
  }

  function buildUserPatterns() {
    // Analyze recent project usage
    const recentProjects = flattenedProjects
      .filter(p => p.effectiveActive && !p.completed)
      .map(p => ({
        id: bareId(p.id),
        name: p.name,
        last_used: getProjectLastUsed(p),
        frequency_score: getProjectFrequencyScore(p),
        typical_tags: getTypicalTagsForProject(p)
      }))
      .sort((a, b) => new Date(b.last_used) - new Date(a.last_used))
      .slice(0, 10);
    
    // Analyze common tags
    const commonTags = flattenedTags
      .map(t => ({
        id: bareId(t.id),
        name: t.name,
        usage_count: getTagUsageCount(t),
        typical_projects: getTypicalProjectsForTag(t)
      }))
      .sort((a, b) => b.usage_count - a.usage_count)
      .slice(0, 15);
    
    return {
      recent_projects: recentProjects,
      common_tags: commonTags,
      processing_velocity: 3, // Default - could be calculated from history
      preferred_batch_size: 15,
      common_name_patterns: getCommonNamePatterns()
    };
  }

