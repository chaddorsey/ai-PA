  function extractSenderFromEmail(content) {
    const fromMatch = content.match(/From:\s*([^\n\r]+)/i);
    return fromMatch ? fromMatch[1].trim() : null;
  }

  function extractTaskNameFromEmail(content) {
    const subjectMatch = content.match(/(?:Fwd:\s*|Subject:\s*)([^\n\r]+)/i);
    if (subjectMatch) {
      return subjectMatch[1].replace(/^(Re:|Fwd:)\s*/i, '').trim();
    }
    return null;
  }

