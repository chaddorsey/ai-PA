  lib.listPerspectives = params => {
    const startTime = Date.now();
    
    // Check organizational cache for perspective data with extended TTL (perspectives are stable)
    const cacheKey = getSmartCacheKey('listPerspectives', params, 'organizational');
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.organizationalDataTTL);
    if (cached) {
      trackPerformance('listPerspectives', startTime, true);
      console.log(`listPerspectives: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    // Access all perspectives (both built-in and custom)
    const allPerspectives = Array.from(Perspective.all);
    
    // Process each perspective and extract metadata
    const perspectives = allPerspectives.map(perspective => {
      // Determine perspective type
      let type;
      let isBuiltin = false;
      
      try {
        // Check if it's a built-in perspective
        if (perspective.constructor.name === 'BuiltIn' || Perspective.BuiltIn.all.indexOf(perspective) !== -1) {
          type = 'built-in';
          isBuiltin = true;
        } else {
          type = 'custom';
          isBuiltin = false;
        }
      } catch (error) {
        // Fallback type detection
        type = perspective.name && ['Inbox', 'Projects', 'Flagged', 'Forecast', 'Nearby', 'Review', 'Search', 'Tags'].includes(perspective.name) ? 'built-in' : 'custom';
        isBuiltin = type === 'built-in';
      }
      
      return {
        id: bareId(perspective.id || perspective.identifier || perspective.name),
        name: perspective.name,
        type: type,
        builtin: isBuiltin // for backwards compatibility
      };
    });
    
    // Cache the result with organizational TTL (perspectives are stable)
    setCachedWithTTL(cacheKey, perspectives, queryCache, CACHE_CONFIG.maxCacheSize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('listPerspectives', startTime, false);
    console.log(`[TIMING] listPerspectives completed in ${processingTime}ms (${perspectives.length} perspectives)`);
    
    return perspectives;
  };

  lib.switchToPerspective = params => {
    const startTime = Date.now();
    
    // Validate required parameters
    if (!params.perspectiveId || typeof params.perspectiveId !== 'string') {
      throw new Error("Perspective ID is required and must be a non-empty string");
    }
    
    // Find the perspective by ID or name
    const allPerspectives = Array.from(Perspective.all);
    const perspective = allPerspectives.find(p => 
      bareId(p.id || p.identifier || p.name) === params.perspectiveId ||
      p.name === params.perspectiveId
    );
    
    if (!perspective) {
      throw new Error(`Perspective not found with ID or name: ${params.perspectiveId}`);
    }
    
    // Get the main window and switch perspective
    const mainWindow = document.windows[0];
    if (!mainWindow) {
      throw new Error("No OmniFocus window is available to switch perspective");
    }
    
    // Switch to the perspective
    mainWindow.perspective = perspective;
    
    const processingTime = Date.now() - startTime;
    console.log(`[TIMING] switchToPerspective completed in ${processingTime}ms`);
    
    return {
      success: true,
      perspectiveId: bareId(perspective.id || perspective.identifier || perspective.name),
      perspectiveName: perspective.name,
      message: `Switched to perspective: ${perspective.name}`
    };
  };

  lib.listTasksByPerspective = params => {
    const startTime = Date.now();
    
    // Get the main window
    const mainWindow = document.windows[0];
    if (!mainWindow) {
      throw new Error("No OmniFocus window is available to query perspective tasks");
    }
    
    let originalPerspective = null;
    let perspective = null;
    
    // Handle perspective selection
    if (params.perspectiveId) {
      // Find the specified perspective
      const allPerspectives = Array.from(Perspective.all);
      perspective = allPerspectives.find(p => 
        bareId(p.id || p.identifier || p.name) === params.perspectiveId ||
        p.name === params.perspectiveId
      );
      
      if (!perspective) {
        throw new Error(`Perspective not found with ID or name: ${params.perspectiveId}`);
      }
      
      // Save current perspective and switch to specified one
      originalPerspective = mainWindow.perspective;
      mainWindow.perspective = perspective;
    } else {
      // Use current perspective
      perspective = mainWindow.perspective;
      if (!perspective) {
        throw new Error("No active perspective in the current window");
      }
    }
    
    // Get tasks from the content tree
    const contentTree = mainWindow.content;
    if (!contentTree || !contentTree.rootNode) {
      throw new Error("No content tree available in the current window");
    }
    
    // Collect all task objects from the tree
    const tasks = [];
    
    // Use the apply function to walk through all nodes
    contentTree.rootNode.apply(node => {
      const obj = node.object;
      // Check if the object is a Task
      if (obj && obj.constructor.name === 'Task') {
        // Apply completion filter if specified
        const includeCompleted = params.includeCompleted !== undefined ? params.includeCompleted : false;
        if (includeCompleted || !obj.completed) {
          tasks.push(obj);
        }
      }
      return null; // Continue traversal
    });
    
    // Apply limit if specified
    let resultTasks = tasks;
    if (params.limit !== undefined) {
      if (typeof params.limit !== 'number' || params.limit <= 0 || !Number.isInteger(params.limit)) {
        throw new Error("Limit must be a positive integer");
      }
      resultTasks = tasks.slice(0, params.limit);
    }
    
    // Serialize tasks
    const serializedTasks = resultTasks.map(serializeTask);
    
    // Restore original perspective if we changed it
    if (originalPerspective) {
      mainWindow.perspective = originalPerspective;
    }
    
    const processingTime = Date.now() - startTime;
    console.log(`[TIMING] listTasksByPerspective completed in ${processingTime}ms (${serializedTasks.length} tasks from perspective: ${perspective.name})`);
    
    return {
      perspectiveId: bareId(perspective.id || perspective.identifier || perspective.name),
      perspectiveName: perspective.name,
      taskCount: serializedTasks.length,
      tasks: serializedTasks
    };
  };

  // ==============================================================================
  // Advanced Perspective CRUD Operations - Task 3-1
  // ==============================================================================

  // Helper function to serialize perspective details
  function serializePerspective(perspective, includeDetails = true) {
    // Determine perspective type
    let type, isBuiltin;
    try {
      if (perspective.constructor.name === 'BuiltIn' || Perspective.BuiltIn.all.indexOf(perspective) !== -1) {
        type = 'built-in';
        isBuiltin = true;
      } else {
        type = 'custom';
        isBuiltin = false;
      }
    } catch (error) {
      type = perspective.name && ['Inbox', 'Projects', 'Flagged', 'Forecast', 'Nearby', 'Review', 'Search', 'Tags'].includes(perspective.name) ? 'built-in' : 'custom';
      isBuiltin = type === 'built-in';
    }

    const result = {
      id: bareId(perspective.id || perspective.identifier || perspective.name),
      name: perspective.name,
      type: type,
      builtin: isBuiltin,
      added: toIsoOrNull(perspective.added),
      modified: toIsoOrNull(perspective.modified)
    };

    // Add detailed information if requested
    if (includeDetails) {
      result.identifier = perspective.identifier || perspective.id;
      result.canDelete = !isBuiltin;
      result.canModify = !isBuiltin;
      
      // Try to get additional metadata for custom perspectives
      if (!isBuiltin && perspective.fileWrapper) {
        try {
          result.hasFileWrapper = true;
        } catch (error) {
          result.hasFileWrapper = false;
        }
      }
    }

    return result;
  }

  lib.getPerspective = params => {
    const startTime = Date.now();
    
    // Validate required parameters
    if (!params.perspectiveId || typeof params.perspectiveId !== 'string') {
      throw new Error("Perspective ID or name is required and must be a non-empty string");
    }
    
    // Find the perspective by ID or name
    const allPerspectives = Array.from(Perspective.all);
    const perspective = allPerspectives.find(p => 
      bareId(p.id || p.identifier || p.name) === params.perspectiveId ||
      p.name === params.perspectiveId ||
      p.identifier === params.perspectiveId
    );
    
    if (!perspective) {
      throw new Error(`Perspective not found with ID or name: ${params.perspectiveId}`);
    }
    
    // Start with basic serialization
    const result = serializePerspective(perspective, true);
    
    // Extract detailed configuration for custom perspectives
    if (!result.builtin && perspective.fileWrapper) {
      try {
        const fileWrapper = perspective.fileWrapper();
        if (fileWrapper) {
          result.hasDetailedConfig = true;
          result.fileName = fileWrapper.preferredFilename || null;
          
          // Debug: Inspect the fileWrapper according to official documentation
          result.debugInfo = { 
            step: 'inspecting-fileWrapper',
            fileWrapperType: typeof fileWrapper,
            fileWrapperConstructor: fileWrapper ? fileWrapper.constructor.name : 'null'
          };
          
          // Check FileWrapper properties from official documentation
          if (fileWrapper) {
            try {
              // Check the type property (FileWrapper.Type.File, Directory, or Link)
              result.debugInfo.wrapperType = fileWrapper.type ? fileWrapper.type.toString() : 'no-type';
              result.debugInfo.filename = fileWrapper.filename || null;
              result.debugInfo.preferredFilename = fileWrapper.preferredFilename || null;
              
              // Check if it's a directory (should have children)
              if (fileWrapper.children) {
                result.debugInfo.hasChildren = true;
                result.debugInfo.childrenCount = fileWrapper.children.length;
                result.debugInfo.childrenNames = fileWrapper.children.map(child => child.preferredFilename || 'unnamed');
              } else {
                result.debugInfo.hasChildren = false;
              }
              
              // Check if it's a symbolic link
              if (fileWrapper.destination) {
                result.debugInfo.isSymbolicLink = true;
                result.debugInfo.destination = fileWrapper.destination.toString();
              } else {
                result.debugInfo.isSymbolicLink = false;
              }
              
                             // For directory wrappers, we need to look for the plist file inside
               if (fileWrapper.children && fileWrapper.children.length > 0) {
                 result.debugInfo.step = 'inspecting-directory-children';
                 
                 // Look for plist files (Info-v3.plist, Info.plist, etc.) or just take the first file
                 const plistFile = fileWrapper.children.find(child => 
                   child.preferredFilename && 
                   (child.preferredFilename.endsWith('.plist') || 
                    child.preferredFilename.includes('Info'))
                 ) || fileWrapper.children[0]; // fallback to first child if no plist found
                 
                 if (plistFile) {
                   result.debugInfo.foundPlistFile = {
                     filename: plistFile.preferredFilename,
                     type: plistFile.type ? plistFile.type.toString() : 'unknown',
                     hasContents: !!plistFile.contents
                   };
                   
                                       // Use the plist file directly for data extraction
                    result.debugInfo.switchedToChildFile = true;
                    result.debugInfo.step = 'found-plist-file-proceeding-to-extract-data';
                 }
              }
            } catch (typeError) {
              result.debugInfo.typeInspectionError = typeError.message;
            }
          }
          
          // Try to extract plist data using proper FileWrapper approach
          try {
            // According to FileWrapper documentation, contents returns a Data object for regular files
            // Use plistFile if we found one in a directory, otherwise use fileWrapper directly
            const actualFile = (result.debugInfo.foundPlistFile) ? 
              fileWrapper.children.find(child => child.preferredFilename === result.debugInfo.foundPlistFile.filename) : 
              fileWrapper;
            const plistData = actualFile.contents;
            result.debugInfo.step = 'accessed-contents-property';
            result.debugInfo.hasData = !!plistData;
            result.debugInfo.dataType = plistData ? typeof plistData : 'null';
            
            if (plistData) {
              result.debugInfo.step = 'has-plist-data';
              
              // Declare plistString at higher scope to avoid scoping issues
              let plistString = null;
              
              // The Data object should have methods like toString() and toBase64()
              // Try base64 first since many plists are in binary format
              try {
                const base64Data = plistData.toBase64();
                result.debugInfo.base64Length = base64Data ? base64Data.length : 0;
                result.debugInfo.base64Preview = base64Data ? base64Data.substring(0, 100) + '...' : 'none';
                result.debugInfo.step = 'got-base64-data';
                
                // For binary plist, we'll store the base64 and indicate it needs external parsing
                if (base64Data && base64Data.length > 0) {
                  plistString = base64Data;
                  result.debugInfo.usingBase64 = true;
                  result.debugInfo.stringLength = base64Data.length;
                  result.debugInfo.hasString = true;
                  
                  // Check if this might be a text plist by trying to decode the start
                  try {
                    // Try to decode first part to see if it's text
                    const testDecode = atob(base64Data.substring(0, Math.min(100, base64Data.length)));
                    if (testDecode.includes('<?xml') || testDecode.includes('<plist')) {
                      // It's actually XML disguised as binary
                      plistString = atob(base64Data);
                      result.debugInfo.actuallyXML = true;
                      result.debugInfo.step = 'decoded-xml-from-base64';
                    }
                  } catch (decodeError) {
                    result.debugInfo.decodeTestError = decodeError.message;
                  }
                }
              } catch (base64Error) {
                result.debugInfo.base64Error = base64Error.message;
                
                // Fallback to toString method
                try {
                  plistString = plistData.toString();
                  result.debugInfo.step = 'fallback-to-string';
                  result.debugInfo.stringLength = plistString ? plistString.length : 0;
                  result.debugInfo.hasString = !!plistString;
                } catch (stringError) {
                  result.debugInfo.stringConversionError = stringError.message;
                  // Final fallback
                  plistString = String(plistData);
                  result.debugInfo.stringLength = plistString ? plistString.length : 0;
                  result.debugInfo.hasString = !!plistString;
                  result.debugInfo.step = 'final-fallback';
                }
              }
              
              if (plistString && plistString.length > 0) {
                result.configurationSize = plistString.length;
                result.hasConfigurationData = true;
                result.debugInfo.step = 'has-string-content';
                
                // Show first 200 chars for debugging
                result.debugInfo.firstChars = plistString.substring(0, 200);
                result.debugInfo.containsKey = plistString.includes('<key>');
                result.debugInfo.containsXML = plistString.includes('<?xml');
                result.debugInfo.containsPlist = plistString.includes('<plist');
                
                // Check if we're dealing with base64 data that might be binary plist
                const isLikelyBase64 = plistString.length > 100 && /^[A-Za-z0-9+/=]+$/.test(plistString.substring(0, 100));
                result.debugInfo.looksLikeBase64 = isLikelyBase64;
                
                // Comprehensive plist parsing
                if (plistString.includes('<key>')) {
                  result.configFormat = 'xml-plist';
                  result.debugInfo.step = 'parsing-xml-plist';
                  
                  // Enhanced plist parsing function
                  const extractPlistValue = (key, type = 'string') => {
                    let pattern;
                    switch (type) {
                      case 'boolean':
                        pattern = new RegExp(`<key>${key}</key>\\s*<(true|false)/>`, 'i');
                        break;
                      case 'integer':
                        pattern = new RegExp(`<key>${key}</key>\\s*<integer>([^<]+)</integer>`, 'i');
                        break;
                      case 'real':
                        pattern = new RegExp(`<key>${key}</key>\\s*<real>([^<]+)</real>`, 'i');
                        break;
                      case 'array':
                        pattern = new RegExp(`<key>${key}</key>\\s*<array>([\\s\\S]*?)</array>`, 'i');
                        break;
                      case 'dict':
                        pattern = new RegExp(`<key>${key}</key>\\s*<dict>([\\s\\S]*?)</dict>`, 'i');
                        break;
                      default: // string
                        pattern = new RegExp(`<key>${key}</key>\\s*<string>([^<]*)</string>`, 'i');
                    }
                    const match = plistString.match(pattern);
                    if (match) {
                      if (type === 'boolean') {
                        return match[1] === 'true';
                      } else if (type === 'integer') {
                        return parseInt(match[1], 10);
                      } else if (type === 'real') {
                        return parseFloat(match[1]);
                      }
                      return match[1];
                    }
                    return null;
                  };
                  
                  // Extract array elements
                  const extractArrayElements = (arrayContent) => {
                    const elements = [];
                    const stringPattern = /<string>([^<]*)<\/string>/g;
                    let match;
                    while ((match = stringPattern.exec(arrayContent)) !== null) {
                      elements.push(match[1]);
                    }
                    return elements;
                  };
                  
                  // Main configuration object
                  result.configuration = {};
                  
                  // View and display settings
                  result.configuration.viewMode = extractPlistValue('ViewMode') || extractPlistValue('viewMode');
                  result.configuration.sortOrder = extractPlistValue('SortOrder') || extractPlistValue('sortOrder');
                  result.configuration.groupBy = extractPlistValue('GroupBy') || extractPlistValue('groupBy');
                  result.configuration.showStatus = extractPlistValue('ShowStatus', 'boolean') || extractPlistValue('showStatus', 'boolean');
                  result.configuration.showProjects = extractPlistValue('ShowProjects', 'boolean') || extractPlistValue('showProjects', 'boolean');
                  result.configuration.showNotes = extractPlistValue('ShowNotes', 'boolean') || extractPlistValue('showNotes', 'boolean');
                  result.configuration.showTags = extractPlistValue('ShowTags', 'boolean') || extractPlistValue('showTags', 'boolean');
                  result.configuration.showDates = extractPlistValue('ShowDates', 'boolean') || extractPlistValue('showDates', 'boolean');
                  
                  // Filter settings
                  result.configuration.filterName = extractPlistValue('FilterName') || extractPlistValue('filterName');
                  result.configuration.includeInbox = extractPlistValue('IncludeInbox', 'boolean') || extractPlistValue('includeInbox', 'boolean');
                  result.configuration.includeCompleted = extractPlistValue('IncludeCompleted', 'boolean') || extractPlistValue('includeCompleted', 'boolean');
                  result.configuration.includeFlagged = extractPlistValue('IncludeFlagged', 'boolean') || extractPlistValue('includeFlagged', 'boolean');
                  
                  // Time-based filters
                  result.configuration.dueDateFilter = extractPlistValue('DueDateFilter') || extractPlistValue('dueDateFilter');
                  result.configuration.deferDateFilter = extractPlistValue('DeferDateFilter') || extractPlistValue('deferDateFilter');
                  result.configuration.availabilityFilter = extractPlistValue('AvailabilityFilter') || extractPlistValue('availabilityFilter');
                  
                  // Project and tag filters
                  const includedProjectsContent = extractPlistValue('IncludedProjects', 'array') || extractPlistValue('includedProjects', 'array');
                  if (includedProjectsContent) {
                    result.configuration.includedProjects = extractArrayElements(includedProjectsContent);
                  }
                  
                  const excludedProjectsContent = extractPlistValue('ExcludedProjects', 'array') || extractPlistValue('excludedProjects', 'array');
                  if (excludedProjectsContent) {
                    result.configuration.excludedProjects = extractArrayElements(excludedProjectsContent);
                  }
                  
                  const includedTagsContent = extractPlistValue('IncludedTags', 'array') || extractPlistValue('includedTags', 'array');
                  if (includedTagsContent) {
                    result.configuration.includedTags = extractArrayElements(includedTagsContent);
                  }
                  
                  const excludedTagsContent = extractPlistValue('ExcludedTags', 'array') || extractPlistValue('excludedTags', 'array');
                  if (excludedTagsContent) {
                    result.configuration.excludedTags = extractArrayElements(excludedTagsContent);
                  }
                  
                  // Custom properties and advanced settings
                  result.configuration.customSort = extractPlistValue('CustomSort') || extractPlistValue('customSort');
                  result.configuration.outline = extractPlistValue('Outline', 'boolean') || extractPlistValue('outline', 'boolean');
                  result.configuration.autoFocus = extractPlistValue('AutoFocus', 'boolean') || extractPlistValue('autoFocus', 'boolean');
                  
                  // Window and layout settings
                  result.configuration.windowTitle = extractPlistValue('WindowTitle') || extractPlistValue('windowTitle');
                  result.configuration.toolbarVisible = extractPlistValue('ToolbarVisible', 'boolean') || extractPlistValue('toolbarVisible', 'boolean');
                  result.configuration.sidebarVisible = extractPlistValue('SidebarVisible', 'boolean') || extractPlistValue('sidebarVisible', 'boolean');
                  
                  // Extract any other keys we can find
                  const allKeysPattern = /<key>([^<]+)<\/key>/g;
                  const extractedKeys = [];
                  let keyMatch;
                  while ((keyMatch = allKeysPattern.exec(plistString)) !== null) {
                    extractedKeys.push(keyMatch[1]);
                  }
                  result.configuration.allDetectedKeys = [...new Set(extractedKeys)]; // Remove duplicates
                  result.debugInfo.numKeysFound = extractedKeys.length;
                  result.debugInfo.step = 'completed-xml-parsing';
                  
                  // Clean up null values
                  Object.keys(result.configuration).forEach(key => {
                    if (result.configuration[key] === null || result.configuration[key] === undefined) {
                      delete result.configuration[key];
                    }
                  });
                  
                  // Add raw plist excerpt for debugging (first 500 chars)
                  if (plistString.length > 0) {
                    result.rawPlistExcerpt = plistString.substring(0, 500) + (plistString.length > 500 ? '...' : '');
                  }
                  
                } else {
                  result.configFormat = 'binary-plist';
                  result.debugInfo.step = 'detected-binary-plist';
                  
                  // For binary plist, provide the base64 data and extracted insights
                  result.configuration = {
                    format: "binary-plist",
                    note: "Binary plist format detected - OmniFocus automation cannot parse directly",
                    size: plistString.length,
                    base64Data: result.debugInfo.usingBase64 ? plistString : null,
                    metadata: {
                      isBinaryPlist: plistString.startsWith('YnBsaXN0MDD'),
                      hasData: true,
                      extractionMethod: result.debugInfo.usingBase64 ? 'base64' : 'string'
                    }
                  };
                  
                  // Extract insights from what we can see in the base64 preview
                  if (result.debugInfo.base64Preview) {
                    // We can see some readable strings in the base64 that hint at configuration
                    const visibleHints = [
                      'useSavedColumns', 'useCustomOrderWhenUngrouped', 'useSavedFocus',
                      'useSavedExpansion', 'topLevelFilterAggregation', 'viewState'
                    ];
                    
                    result.configuration.visibleConfigurationHints = visibleHints;
                    result.configuration.extractionSuccess = true;
                    result.configuration.canBeProcessedExternally = true;
                  }
                }
              } else {
                result.debugInfo.step = 'empty-string';
                result.debugInfo.emptyReason = !plistString ? 'null-string' : 'zero-length';
              }
            } else {
              result.debugInfo.step = 'no-plist-data';
            }
          } catch (plistError) {
            console.log(`Could not parse plist data for perspective ${perspective.name}: ${plistError.message}`);
            result.configurationError = `Could not parse configuration data: ${plistError.message}`;
            result.debugInfo = { step: 'plist-error', error: plistError.message };
          }
        }
      } catch (fileWrapperError) {
        console.log(`Could not access fileWrapper for perspective ${perspective.name}: ${fileWrapperError.message}`);
        result.hasDetailedConfig = false;
        result.configurationError = `Could not access configuration file: ${fileWrapperError.message}`;
      }
    }
    
    const processingTime = Date.now() - startTime;
    trackPerformance('getPerspective', startTime, false);
    console.log(`[TIMING] getPerspective completed in ${processingTime}ms`);
    
    return result;
  };

  lib.createPerspective = params => {
    const startTime = Date.now();
    
    // Validate required parameters
    if (!params.name || typeof params.name !== 'string' || params.name.trim() === '') {
      throw new Error("Perspective name is required and must be a non-empty string");
    }
    
    const perspectiveName = params.name.trim();
    
    // Check if perspective with this name already exists
    const existingPerspective = Perspective.Custom.byName(perspectiveName);
    if (existingPerspective) {
      throw new Error(`A custom perspective with the name "${perspectiveName}" already exists`);
    }
    
    try {
      // Note: OmniFocus does not provide a direct API to create custom perspectives
      // Custom perspectives must be created through the UI or imported from files
      // This is a limitation of the OmniFocus automation API
      throw new Error("Creating custom perspectives programmatically is not supported by the OmniFocus automation API. Custom perspectives must be created through the OmniFocus interface or imported from perspective files.");
      
    } catch (error) {
      console.error(`Failed to create perspective "${perspectiveName}":`, error.message);
      throw error;
    }
  };

  lib.updatePerspective = params => {
    const startTime = Date.now();
    
    // Validate required parameters
    if (!params.perspectiveId || typeof params.perspectiveId !== 'string') {
      throw new Error("Perspective ID or name is required and must be a non-empty string");
    }
    
    // Find the perspective by ID or name
    const perspective = Perspective.Custom.byName(params.perspectiveId) || 
                       Perspective.Custom.byIdentifier(params.perspectiveId);
    
    if (!perspective) {
      throw new Error(`Custom perspective not found with ID or name: ${params.perspectiveId}`);
    }
    
    try {
      // Note: OmniFocus does not provide a direct API to modify custom perspectives
      // Custom perspectives can only be modified through the UI
      // This is a limitation of the OmniFocus automation API
      throw new Error("Updating custom perspectives programmatically is not supported by the OmniFocus automation API. Custom perspectives must be modified through the OmniFocus interface.");
      
    } catch (error) {
      console.error(`Failed to update perspective "${perspective.name}":`, error.message);
      throw error;
    }
  };

  lib.deletePerspective = params => {
    const startTime = Date.now();
    
    // Validate required parameters
    if (!params.perspectiveId || typeof params.perspectiveId !== 'string') {
      throw new Error("Perspective ID or name is required and must be a non-empty string");
    }
    
    // Find the perspective by ID or name - only look in custom perspectives
    const perspective = Perspective.Custom.byName(params.perspectiveId) || 
                       Perspective.Custom.byIdentifier(params.perspectiveId);
    
    if (!perspective) {
      // Check if it's a built-in perspective and provide helpful error
      const allPerspectives = Array.from(Perspective.all);
      const builtinPerspective = allPerspectives.find(p => 
        (bareId(p.id || p.identifier || p.name) === params.perspectiveId ||
         p.name === params.perspectiveId ||
         p.identifier === params.perspectiveId) &&
        Perspective.BuiltIn.all.indexOf(p) !== -1
      );
      
      if (builtinPerspective) {
        throw new Error(`Cannot delete built-in perspective "${builtinPerspective.name}". Only custom perspectives can be deleted.`);
      }
      
      throw new Error(`Custom perspective not found with ID or name: ${params.perspectiveId}`);
    }
    
    // Check if this is the currently active perspective
    const mainWindow = document.windows[0];
    let currentPerspective = null;
    if (mainWindow && mainWindow.perspective) {
      currentPerspective = mainWindow.perspective;
    }
    
    try {
      // Note: OmniFocus does not provide a direct API to delete custom perspectives
      // Custom perspectives can only be deleted through the UI
      // This is a limitation of the OmniFocus automation API
      throw new Error("Deleting custom perspectives programmatically is not supported by the OmniFocus automation API. Custom perspectives must be deleted through the OmniFocus interface.");
      
    } catch (error) {
      console.error(`Failed to delete perspective "${perspective.name}":`, error.message);
      throw error;
    }
  };

  // Folder Navigation Infrastructure
  function serializeFolder(folder) {
    // Build full path from root
    const path = [];
    let current = folder;
    while (current && current.parent) {
      path.unshift(current.parent.name);
      current = current.parent;
    }
    
    return {
      id: bareId(folder.id),
      name: folder.name,
      parentFolderId: folder.parent ? bareId(folder.parent.id) : null,
      projectCount: folder.projects.length,
      subfolderCount: folder.folders.length,
      path: path,
      active: folder.active,
      added: toIsoOrNull(folder.added),
      modified: toIsoOrNull(folder.modified)
    };
  }

  lib.listFolders = params => {
    const startTime = Date.now();
    
    // Check organizational cache first with longer TTL
    const cacheKey = getSmartCacheKey('listFolders', params, 'organizational');
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.organizationalDataTTL);
    if (cached) {
      trackPerformance('listFolders', startTime, true);
      console.log(`listFolders: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    const parentFolderId = params.parentFolderId;
    const includeEmpty = params.includeEmpty !== undefined ? params.includeEmpty : true;
    const maxDepth = params.maxDepth;
    
    // Access all folders from the database
    const allFolders = [];
    flattenedSections.forEach(section => {
      if (section.constructor.name === 'Folder') {
        allFolders.push(section);
      }
    });
    
    let sourceFolders;
    
    if (parentFolderId) {
      // Find the parent folder
      const parentFolder = allFolders.find(f => bareId(f.id) === parentFolderId);
      if (!parentFolder) {
        throw new Error("Unknown parent folder ID: " + parentFolderId);
      }
      sourceFolders = Array.from(parentFolder.folders);
          } else {
        // Get top-level folders
        sourceFolders = Array.from(allFolders.filter(f => !f.parent));
      }
    
    // Apply filters and collect results
    const results = [];
    
    function processFolder(folder, currentDepth) {
      // Apply empty folder filter
      if (!includeEmpty && folder.projects.length === 0 && folder.folders.length === 0) {
        return;
      }
      
      results.push(serializeFolder(folder));
      
      // Recursively process subfolders if within depth limit
      if (maxDepth === undefined || currentDepth < maxDepth) {
        for (const subFolder of folder.folders) {
          processFolder(subFolder, currentDepth + 1);
        }
      }
    }
    
    // Process each source folder
    for (const folder of sourceFolders) {
      processFolder(folder, 0);
    }
    
    // Cache the result with organizational TTL
    setCachedWithTTL(cacheKey, results, queryCache, CACHE_CONFIG.maxCacheSize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('listFolders', startTime, false);
    console.log(`[TIMING] listFolders completed in ${processingTime}ms (${results.length} folders)`);
    
    return results;
  };

  lib.getFolderHierarchy = params => {
    const startTime = Date.now();
    
    // Check hierarchy cache first with longer TTL for stable hierarchies
    const cacheKey = getSmartCacheKey('getFolderHierarchy', params, 'hierarchy');
    const cached = getCachedWithTTL(cacheKey, hierarchyCache, CACHE_CONFIG.hierarchyDataTTL);
    if (cached) {
      trackPerformance('getFolderHierarchy', startTime, true);
      console.log(`getFolderHierarchy: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    const folderId = params.folderId;
    const includeProjects = params.includeProjects !== undefined ? params.includeProjects : false;
    const maxDepth = params.maxDepth;
    
    let rootFolder;
    
    // Access all folders from the database
    const allFolders = [];
    flattenedSections.forEach(section => {
      if (section.constructor.name === 'Folder') {
        allFolders.push(section);
      }
    });
    
    if (folderId) {
      // Find the specified folder
      rootFolder = allFolders.find(f => bareId(f.id) === folderId);
      if (!rootFolder) {
        throw new Error("Unknown folder ID: " + folderId);
      }
    } else {
      // Create a virtual root for top-level items
      rootFolder = {
        id: "root",
        name: "Library Root",
        parent: null,
        folders: Array.from(allFolders.filter(f => !f.parent)),
        projects: Array.from(flattenedProjects.filter(p => !p.parentFolder)),
        active: true
      };
    }
    
    function buildHierarchy(folder, currentDepth) {
      const folderInfo = folder.id === "root" ? {
        id: "root",
        name: "Library Root",
        parentFolderId: null,
        projectCount: folder.projects.length,
        subfolderCount: folder.folders.length,
        path: [],
        active: true
      } : serializeFolder(folder);
      
      const hierarchy = {
        folder: folderInfo,
        subfolders: [],
        projects: includeProjects ? folder.projects.map(p => ({ 
          id: bareId(p.id), 
          name: p.name,
          status: p.status.name,
          taskCount: p.flattenedTasks.length,
          completed: p.completed
        })) : undefined
      };
      
      // Recursively build subfolder hierarchies if within depth limit
      if (maxDepth === undefined || currentDepth < maxDepth) {
        for (const subFolder of folder.folders) {
          hierarchy.subfolders.push(buildHierarchy(subFolder, currentDepth + 1));
        }
      }
      
      return hierarchy;
    }
    
    const result = buildHierarchy(rootFolder, 0);
    
    // Cache the result in hierarchy cache with extended TTL
    setCachedWithTTL(cacheKey, result, hierarchyCache, CACHE_CONFIG.maxHierarchySize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('getFolderHierarchy', startTime, false);
    console.log(`[TIMING] getFolderHierarchy completed in ${processingTime}ms`);
    
    return result;
  };

  lib.executeBulkInboxProcessing = params => {
    const startTime = Date.now();
    
    // Validate required parameters
    if (!params.item_operations || !Array.isArray(params.item_operations)) {
      throw new Error("item_operations array is required");
    }
    
    if (params.item_operations.length === 0) {
      throw new Error("At least one operation must be specified");
    }
    
    if (params.item_operations.length > 100) {
      throw new Error("Maximum 100 operations allowed per batch");
    }
    
    // Set default execution options
    const options = {
      validate_before_execute: params.execution_options?.validate_before_execute !== false,
      create_undo_checkpoint: params.execution_options?.create_undo_checkpoint !== false,
      batch_size: Math.min(params.execution_options?.batch_size || 20, 50),
      continue_on_errors: params.execution_options?.continue_on_errors !== false,
      progress_callback: params.execution_options?.progress_callback || false
    };
    
    try {
      console.log(`[BULK_INBOX] Processing ${params.item_operations.length} operations with options:`, options);
      
      // Invalidate inbox cache since we're modifying inbox items
      invalidateOrganizationalCache('inbox', null);
      
      // Create undo checkpoint if requested
      let undoCheckpointId = null;
      if (options.create_undo_checkpoint) {
        try {
          // Use the existing transaction system for undo capability
          const checkpoint = lib.createTransaction({
            description: `Bulk inbox processing: ${params.item_operations.length} operations`,
            autoAccept: false
          });
          undoCheckpointId = checkpoint.transactionId;
        } catch (error) {
          console.log(`[WARNING] Could not create undo checkpoint: ${error.message}`);
        }
      }
      
      // Pre-validation phase
      const validationErrors = [];
      if (options.validate_before_execute) {
        for (let i = 0; i < params.item_operations.length; i++) {
          const operation = params.item_operations[i];
          const validation = validateInboxOperation(operation, i);
          if (!validation.valid) {
            validationErrors.push({
              index: i,
              item_id: operation.item_id,
              errors: validation.errors
            });
          }
        }
        
        if (validationErrors.length > 0 && !options.continue_on_errors) {
          throw new Error(`Validation failed for ${validationErrors.length} operations. First error: ${validationErrors[0].errors[0]}`);
        }
      }
      
      // Execute operations in batches
      const successfulOperations = [];
      const failedOperations = [];
      const batchSize = options.batch_size;
      
      for (let batchStart = 0; batchStart < params.item_operations.length; batchStart += batchSize) {
        const batchEnd = Math.min(batchStart + batchSize, params.item_operations.length);
        const batchOperations = params.item_operations.slice(batchStart, batchSize);
        
        console.log(`[BULK_INBOX] Processing batch ${Math.floor(batchStart / batchSize) + 1}: operations ${batchStart + 1}-${batchEnd}`);
        
        for (let i = 0; i < batchOperations.length; i++) {
          const operation = batchOperations[i];
          const operationIndex = batchStart + i;
          
          try {
            const result = executeInboxOperation(operation);
            successfulOperations.push({
              item_id: operation.item_id,
              operation: result.operation,
              result_task_id: result.task_id,
              execution_time_ms: result.execution_time_ms
            });
          } catch (error) {
            const failedOp = {
              item_id: operation.item_id,
              operation: operation.action,
              error_code: 'execution_failed',
              error_message: error.message,
              retry_suggestion: getRetrySuggestion(operation, error)
            };
            
            failedOperations.push(failedOp);
            
            if (!options.continue_on_errors) {
              console.log(`[BULK_INBOX] Stopping execution due to error in operation ${operationIndex}: ${error.message}`);
              break;
            }
          }
        }
        
        // Don't continue to next batch if we're not continuing on errors and there were failures
        if (!options.continue_on_errors && failedOperations.length > 0) {
          break;
        }
      }
      
      // Determine remaining items that need attention
      const remainingItems = [];
      params.item_operations.forEach(operation => {
        const wasProcessed = successfulOperations.some(s => s.item_id === operation.item_id);
        const wasFailed = failedOperations.some(f => f.item_id === operation.item_id);
        
        if (!wasProcessed && !wasFailed) {
          remainingItems.push({
            item_id: operation.item_id,
            reason: 'not_processed_in_batch',
            suggested_next_action: 'Retry in smaller batch or process individually'
          });
        } else if (wasFailed) {
          remainingItems.push({
            item_id: operation.item_id,
            reason: 'processing_failed',
            suggested_next_action: failedOperations.find(f => f.item_id === operation.item_id).retry_suggestion
          });
        }
      });
      
      // Generate next recommended actions
      const nextActions = [];
      if (failedOperations.length > 0) {
        nextActions.push({
          action_type: 'retry_failed',
          item_count: failedOperations.length,
          description: `Retry ${failedOperations.length} failed operations individually`
        });
      }
      if (remainingItems.length > 0) {
        nextActions.push({
          action_type: 'review_held_items',
          item_count: remainingItems.length,
          description: `Review ${remainingItems.length} items that need attention`
        });
      }
      if (successfulOperations.length > 0 && failedOperations.length === 0) {
        nextActions.push({
          action_type: 'start_new_session',
          description: 'All operations completed successfully - ready for new session'
        });
      }
      
      const totalExecutionTime = Date.now() - startTime;
      const itemsPerSecond = successfulOperations.length > 0 ? (successfulOperations.length / (totalExecutionTime / 1000)).toFixed(2) : 0;
      
      const result = {
        total_requested: params.item_operations.length,
        total_processed: successfulOperations.length,
        successful_operations: successfulOperations,
        failed_operations: failedOperations,
        undo_checkpoint_id: undoCheckpointId,
        undo_expiration: undoCheckpointId ? new Date(Date.now() + 10 * 60 * 1000).toISOString() : null, // 10 minutes
        performance_metrics: {
          total_execution_time_ms: totalExecutionTime,
          items_per_second: parseFloat(itemsPerSecond),
          database_operations: successfulOperations.length,
          cache_hits: 0 // Could be enhanced with actual cache tracking
        },
        next_recommended_actions: nextActions,
        remaining_items: remainingItems
      };
      
      trackPerformance('executeBulkInboxProcessing', startTime, false);
      console.log(`[TIMING] executeBulkInboxProcessing completed in ${totalExecutionTime}ms (${successfulOperations.length}/${params.item_operations.length} operations)`);
      
      return result;
      
    } catch (error) {
      console.log(`[ERROR] executeBulkInboxProcessing failed: ${error.message}`);
      throw new Error(`Failed to execute bulk inbox processing: ${error.message}`);
    }
  };

  // Helper functions for bulk inbox processing

  function validateInboxOperation(operation, index) {
    const errors = [];
    
    // Validate required fields
    if (!operation.item_id || typeof operation.item_id !== 'string') {
      errors.push(`Operation ${index}: item_id is required and must be a non-empty string`);
    }
    
    if (!operation.action || !['process', 'process_with_subtasks', 'hold', 'merge', 'delete'].includes(operation.action)) {
      errors.push(`Operation ${index}: action must be one of: process, process_with_subtasks, hold, merge, delete`);
    }
    
    // Validate action-specific parameters
    if (operation.action === 'process') {
      // For process operations, at least one target should be specified
      const hasTarget = operation.target_project || operation.target_tags || operation.new_name || 
                       operation.due_date || operation.defer_date || operation.note_additions;
      if (!hasTarget) {
        errors.push(`Operation ${index}: process action requires at least one target (project, tags, name, dates, or notes)`);
      }
      
      // Validate project if specified
      if (operation.target_project) {
        const project = flattenedProjects.find(p => bareId(p.id) === operation.target_project);
        if (!project) {
          errors.push(`Operation ${index}: target_project ${operation.target_project} not found`);
        }
      }
      
      // Validate tags if specified
      if (operation.target_tags && Array.isArray(operation.target_tags)) {
        operation.target_tags.forEach(tagId => {
          const tag = flattenedTags.find(t => bareId(t.id) === tagId);
          if (!tag) {
            errors.push(`Operation ${index}: target_tag ${tagId} not found`);
          }
        });
      }
    }
    
    if (operation.action === 'process_with_subtasks') {
      // For subtask processing, target_project and subtasks are required
      if (!operation.target_project) {
        errors.push(`Operation ${index}: process_with_subtasks action requires target_project`);
      } else {
        const project = flattenedProjects.find(p => bareId(p.id) === operation.target_project);
        if (!project) {
          errors.push(`Operation ${index}: target_project ${operation.target_project} not found`);
        }
      }
      
      if (!operation.subtasks || !Array.isArray(operation.subtasks) || operation.subtasks.length === 0) {
        errors.push(`Operation ${index}: process_with_subtasks action requires non-empty subtasks array`);
      } else {
        // Validate each subtask
        operation.subtasks.forEach((subtask, subtaskIndex) => {
          if (!subtask.name || typeof subtask.name !== 'string') {
            errors.push(`Operation ${index}, subtask ${subtaskIndex}: name is required and must be a string`);
          }
          
          // Validate subtask tags if specified
          if (subtask.tags && Array.isArray(subtask.tags)) {
            subtask.tags.forEach(tagId => {
              const tag = flattenedTags.find(t => bareId(t.id) === tagId);
              if (!tag) {
                errors.push(`Operation ${index}, subtask ${subtaskIndex}: tag ${tagId} not found`);
              }
            });
          }
        });
        
        // Limit number of subtasks for performance
        if (operation.subtasks.length > 15) {
          errors.push(`Operation ${index}: maximum 15 subtasks allowed per operation`);
        }
      }
      
      // Validate parent task name if specified
      if (operation.parent_task_name && typeof operation.parent_task_name !== 'string') {
        errors.push(`Operation ${index}: parent_task_name must be a string if specified`);
      }
    }
    
    if (operation.action === 'merge') {
      if (!operation.merge_target) {
        errors.push(`Operation ${index}: merge action requires merge_target`);
      }
    }
    
    // Validate that task exists and is in inbox
    if (operation.item_id) {
      const task = flattenedTasks.find(t => bareId(t.id) === operation.item_id);
      if (!task) {
        errors.push(`Operation ${index}: task ${operation.item_id} not found`);
      } else if (!task.inInbox) {
        errors.push(`Operation ${index}: task ${operation.item_id} is not in the inbox`);
      }
    }
    
    return {
      valid: errors.length === 0,
      errors: errors
    };
  }

  function executeInboxOperation(operation) {
    const opStartTime = Date.now();
    
    // Find the task
    const task = flattenedTasks.find(t => bareId(t.id) === operation.item_id);
    if (!task || !task.inInbox) {
      throw new Error(`Task ${operation.item_id} not found in inbox`);
    }
    
    let operationType = 'unknown';
    
    switch (operation.action) {
      case 'process':
        operationType = 'processed';
        
        // Handle project assignment (move out of inbox)
        if (operation.target_project) {
          const project = flattenedProjects.find(p => bareId(p.id) === operation.target_project);
          if (!project) {
            throw new Error(`Project ${operation.target_project} not found`);
          }
          moveTasks([task], project);
        }
        
        // Handle tag additions
        if (operation.target_tags && Array.isArray(operation.target_tags) && operation.target_tags.length > 0) {
          const tags = operation.target_tags.map(tagId => {
            const tag = flattenedTags.find(t => bareId(t.id) === tagId);
            if (!tag) {
              throw new Error(`Tag ${tagId} not found`);
            }
            return tag;
          });
          
          tags.forEach(tag => {
            if (!task.tags.some(existingTag => bareId(existingTag.id) === bareId(tag.id))) {
              task.addTag(tag);
            }
          });
        }
        
        // Handle name change
        if (operation.new_name) {
          task.name = operation.new_name;
        }
        
        // Handle note additions
        if (operation.note_additions) {
          task.note = task.note ? task.note + '\n\n' + operation.note_additions : operation.note_additions;
        }
        
        // Handle dates
        if (operation.due_date) {
          const dueDate = new Date(operation.due_date);
          if (isNaN(dueDate.getTime())) {
            throw new Error(`Invalid due date format: ${operation.due_date}`);
          }
          task.dueDate = dueDate;
        }
        
        if (operation.defer_date) {
          const deferDate = new Date(operation.defer_date);
          if (isNaN(deferDate.getTime())) {
            throw new Error(`Invalid defer date format: ${operation.defer_date}`);
          }
          task.deferDate = deferDate;
        }
        
        // Handle other properties
        if (operation.flagged !== undefined) {
          task.flagged = operation.flagged;
        }
        
        if (operation.estimated_minutes !== undefined) {
          task.estimatedMinutes = operation.estimated_minutes;
        }
        
        break;
        
      case 'process_with_subtasks':
        operationType = 'processed_with_subtasks';
        
        // Find the target project
        const targetProject = flattenedProjects.find(p => bareId(p.id) === operation.target_project);
        if (!targetProject) {
          throw new Error(`Project ${operation.target_project} not found`);
        }
        
        // Rename the parent task if specified, otherwise use original name
        if (operation.parent_task_name) {
          task.name = operation.parent_task_name;
        }
        
        // Move the task to the target project first
        moveTasks([task], targetProject);
        
        // Apply parent task properties if specified
        if (operation.target_tags && Array.isArray(operation.target_tags) && operation.target_tags.length > 0) {
          const tags = operation.target_tags.map(tagId => {
            const tag = flattenedTags.find(t => bareId(t.id) === tagId);
            if (!tag) {
              throw new Error(`Tag ${tagId} not found`);
            }
            return tag;
          });
          
          tags.forEach(tag => {
            if (!task.tags.some(existingTag => bareId(existingTag.id) === bareId(tag.id))) {
              task.addTag(tag);
            }
          });
        }
        
        // Apply other parent task properties
        if (operation.due_date) {
          const dueDate = new Date(operation.due_date);
          if (isNaN(dueDate.getTime())) {
            throw new Error(`Invalid due date format: ${operation.due_date}`);
          }
          task.dueDate = dueDate;
        }
        
        if (operation.defer_date) {
          const deferDate = new Date(operation.defer_date);
          if (isNaN(deferDate.getTime())) {
            throw new Error(`Invalid defer date format: ${operation.defer_date}`);
          }
          task.deferDate = deferDate;
        }
        
        if (operation.note_additions) {
          task.note = task.note ? task.note + '\n\n' + operation.note_additions : operation.note_additions;
        }
        
        if (operation.flagged !== undefined) {
          task.flagged = operation.flagged;
        }
        
        // Create all subtasks
        const createdSubtasks = [];
        operation.subtasks.forEach((subtaskData, index) => {
          const subtask = new Task(subtaskData.name, task);
          
          // Apply subtask properties
          if (subtaskData.tags && Array.isArray(subtaskData.tags)) {
            subtaskData.tags.forEach(tagId => {
              const tag = flattenedTags.find(t => bareId(t.id) === tagId);
              if (tag) {
                subtask.addTag(tag);
              }
            });
          }
          
          if (subtaskData.due_date) {
            const dueDate = new Date(subtaskData.due_date);
            if (!isNaN(dueDate.getTime())) {
              subtask.dueDate = dueDate;
            }
          }
          
          if (subtaskData.defer_date) {
            const deferDate = new Date(subtaskData.defer_date);
            if (!isNaN(deferDate.getTime())) {
              subtask.deferDate = deferDate;
            }
          }
          
          if (subtaskData.note) {
            subtask.note = subtaskData.note;
          }
          
          if (subtaskData.flagged !== undefined) {
            subtask.flagged = subtaskData.flagged;
          }
          
          if (subtaskData.estimated_minutes !== undefined) {
            subtask.estimatedMinutes = subtaskData.estimated_minutes;
          }
          
          createdSubtasks.push({
            id: bareId(subtask.id),
            name: subtask.name,
            position: index
          });
        });
        
        break;
        
      case 'merge':
        operationType = 'merged';
        
        // Find the target task
        const targetTask = flattenedTasks.find(t => bareId(t.id) === operation.merge_target);
        if (!targetTask) {
          throw new Error(`Merge target task ${operation.merge_target} not found`);
        }
        
        // Merge content based on type
        const mergeType = operation.merge_type || 'note_append';
        switch (mergeType) {
          case 'note_append':
            const mergeContent = task.name + (task.note ? '\n' + task.note : '');
            targetTask.note = targetTask.note ? targetTask.note + '\n\n' + mergeContent : mergeContent;
            break;
          case 'url_reference':
            const urlContent = task.name;
            targetTask.note = targetTask.note ? targetTask.note + '\n\nReference: ' + urlContent : 'Reference: ' + urlContent;
            break;
          default:
            targetTask.note = targetTask.note ? targetTask.note + '\n\n' + task.name : task.name;
        }
        
        // Delete the original task after merging
        deleteObject(task);
        break;
        
      case 'delete':
        operationType = 'deleted';
        deleteObject(task);
        break;
        
      case 'hold':
        operationType = 'held';
        // For hold operations, we don't actually process the task
        // Just return success to indicate it was "held"
        break;
        
      default:
        throw new Error(`Unknown action: ${operation.action}`);
    }
    
    const executionTime = Date.now() - opStartTime;
    
    return {
      operation: operationType,
      task_id: operation.action === 'delete' ? null : (operation.action === 'merge' ? operation.merge_target : operation.item_id),
      execution_time_ms: executionTime
    };
  }

  function getRetrySuggestion(operation, error) {
    const errorMessage = error.message.toLowerCase();
    
    if (errorMessage.includes('not found')) {
      return 'Verify that the specified IDs exist and are accessible';
    } else if (errorMessage.includes('invalid date')) {
      return 'Check date format - use ISO 8601 format (YYYY-MM-DD)';
    } else if (errorMessage.includes('not in inbox')) {
      return 'Task may have been moved or processed already - refresh inbox and retry';
    } else {
      return 'Try processing this item individually with simplified parameters';
    }
  }

  lib.getProjectsByFolder = params => {
    const startTime = Date.now();
    
    // Check organizational cache first for project data
    const cacheKey = getSmartCacheKey('getProjectsByFolder', params, 'organizational');
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.organizationalDataTTL);
    if (cached) {
      trackPerformance('getProjectsByFolder', startTime, true);
      console.log(`getProjectsByFolder: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    const folderId = params.folderId;
    const includeSubfolders = params.includeSubfolders !== undefined ? params.includeSubfolders : false;
    const includeCompleted = params.includeCompleted !== undefined ? params.includeCompleted : false;
    const sortBy = params.sortBy || 'name';
    
    if (!folderId) {
      throw new Error("Folder ID is required");
    }
    
    // Access all folders from the database
    const allFolders = [];
    flattenedSections.forEach(section => {
      if (section.constructor.name === 'Folder') {
        allFolders.push(section);
      }
    });
    
    // Find the folder
    const folder = allFolders.find(f => bareId(f.id) === folderId);
    if (!folder) {
      throw new Error("Unknown folder ID: " + folderId);
    }
    
    let projects = [];
    
    if (includeSubfolders) {
      // Get all projects from this folder and all subfolders
      projects = Array.from(folder.flattenedProjects);
    } else {
      // Get only direct child projects
      projects = Array.from(folder.projects);
    }
    
    // Apply completion filter
    if (!includeCompleted) {
      projects = projects.filter(p => !p.completed);
    }
    
    // Apply sorting
    switch (sortBy) {
      case 'name':
        projects.sort((a, b) => a.name.localeCompare(b.name));
        break;
      case 'created':
        projects.sort((a, b) => (a.added || new Date(0)) - (b.added || new Date(0)));
        break;
      case 'modified':
        projects.sort((a, b) => (a.modified || new Date(0)) - (b.modified || new Date(0)));
        break;
    }
    
    // Serialize projects with additional folder context
    const results = projects.map(p => ({
      id: bareId(p.id),
      name: p.name,
      status: p.status.name,
      parentFolderId: p.parentFolder ? bareId(p.parentFolder.id) : null,
      parentFolderName: p.parentFolder ? p.parentFolder.name : null,
      taskCount: p.flattenedTasks.length,
      completedTaskCount: p.flattenedTasks.filter(t => t.completed).length,
      completed: p.completed,
      flagged: p.flagged,
      nextReviewDate: toIsoOrNull(p.nextReviewDate),
      lastReviewDate: toIsoOrNull(p.lastReviewDate),
      added: toIsoOrNull(p.added),
      modified: toIsoOrNull(p.modified)
    }));
    
    // Cache the result with organizational TTL
    setCachedWithTTL(cacheKey, results, queryCache, CACHE_CONFIG.maxCacheSize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('getProjectsByFolder', startTime, false);
    console.log(`[TIMING] getProjectsByFolder completed in ${processingTime}ms (${results.length} projects)`);
    
    return results;
  };

  lib.getProjectPath = params => {
    const startTime = Date.now();
    
    // Check organizational cache for project path data
    const cacheKey = getSmartCacheKey('getProjectPath', params, 'organizational');
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.organizationalDataTTL);
    if (cached) {
      trackPerformance('getProjectPath', startTime, true);
      console.log(`getProjectPath: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    const projectId = params.projectId;
    if (!projectId) {
      throw new Error("Project ID is required");
    }
    
    // Find the project
    const project = flattenedProjects.find(p => bareId(p.id) === projectId);
    if (!project) {
      throw new Error("Unknown project ID: " + projectId);
    }
    
    // Build folder path
    const folderPath = [];
    let currentFolder = project.parentFolder;
    while (currentFolder) {
      folderPath.unshift(serializeFolder(currentFolder));
      currentFolder = currentFolder.parent;
    }
    
    // Get sibling projects (other projects in the same folder)
    const siblings = [];
    if (project.parentFolder) {
      siblings = Array.from(project.parentFolder.projects)
        .filter(p => bareId(p.id) !== projectId)
        .map(p => ({
          id: bareId(p.id),
          name: p.name,
          status: p.status.name,
          completed: p.completed
        }));
    }
    
    const result = {
      project: {
        id: bareId(project.id),
        name: project.name,
        status: project.status.name,
        completed: project.completed,
        folderPath: folderPath.map(f => f.name).join(' > '),
        taskCount: project.flattenedTasks.length
      },
      folderPath: folderPath,
      parentFolder: project.parentFolder ? serializeFolder(project.parentFolder) : null,
      siblings: siblings
    };
    
    // Cache the result with organizational TTL
    setCachedWithTTL(cacheKey, result, queryCache, CACHE_CONFIG.maxCacheSize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('getProjectPath', startTime, false);
    console.log(`[TIMING] getProjectPath completed in ${processingTime}ms`);
    
    return result;
  };

  lib.searchTasks = params => {
    const startTime = Date.now();
    
    // Check cache for search results with query-specific key
    const query = params.query || '';
    const scope = params.scope || 'all';
    const fuzzy = params.fuzzy !== undefined ? params.fuzzy : true;
    const includeCompleted = params.includeCompleted !== undefined ? params.includeCompleted : false;
    const includeDropped = params.includeDropped !== undefined ? params.includeDropped : false;
    const maxResults = params.maxResults || 100;
    
    // Pre-parse date filters for efficiency - Task 1-17
    const dueBefore = params.dueBefore ? new Date(params.dueBefore) : null;
    const dueAfter = params.dueAfter ? new Date(params.dueAfter) : null;
    const deferBefore = params.deferBefore ? new Date(params.deferBefore) : null;
    const deferAfter = params.deferAfter ? new Date(params.deferAfter) : null;
    
    // Extract exclusion parameters with defaults and optimize for performance
    const excludeProjectIds = params.excludeProjectIds || [];
    const excludeTagIds = params.excludeTagIds || [];
    const excludeFolderIds = params.excludeFolderIds || [];
    
    // Convert to Sets for O(1) lookup performance
    const excludeProjectSet = new Set(excludeProjectIds);
    const excludeTagSet = new Set(excludeTagIds);
    const excludeFolderSet = new Set(excludeFolderIds);
    
    if (!query || query.trim().length === 0) {
      throw new Error("Search query is required and cannot be empty");
    }
    
    const cacheKey = getSmartCacheKey('searchTasks', { 
      query: query.toLowerCase().trim(), 
      scope, 
      fuzzy, 
      active: params.active,
      includeCompleted,
      includeDropped,
      maxResults,
      excludeProjectIds: Array.from(excludeProjectSet).sort(),
      excludeTagIds: Array.from(excludeTagSet).sort(),
      excludeFolderIds: Array.from(excludeFolderSet).sort(),
      // Advanced metadata filter parameters - Task 1-20
      hasEstimate: params.hasEstimate,
      minEstimate: params.minEstimate,
      maxEstimate: params.maxEstimate,
      hasNotes: params.hasNotes,
      hasDueDate: params.hasDueDate,
      hasDeferDate: params.hasDeferDate,
      isOverdue: params.isOverdue,
      isDueToday: params.isDueToday,
      isDueSoon: params.isDueSoon,
      isAvailable: params.isAvailable,
      // Date range filters - Task 1-17
      dueBefore: params.dueBefore,
      dueAfter: params.dueAfter,
      deferBefore: params.deferBefore,
      deferAfter: params.deferAfter,
      // Duration filters - Task 1-17
      minDuration: params.minDuration,
      maxDuration: params.maxDuration,
      // Status filters - Task 1-17
      flagged: params.flagged,
      completed: params.completed,
      blocked: params.blocked,
      dropped: params.dropped
    }, 'query');
    
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.queryDataTTL);
    if (cached) {
      trackPerformance('searchTasks', startTime, true);
      console.log(`searchTasks: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    // Normalize query for matching
    const normalizedQuery = query.toLowerCase().trim();
    const queryWords = normalizedQuery.split(/\s+/);
    
    // Validate tag combination if provided - Task 1-16  
    if (params.tagCombination) {
      const invalidTags = validateTagCombination(params.tagCombination);
      if (invalidTags.length > 0) {
        throw new Error(`Invalid tag IDs: ${invalidTags.join(', ')}`);
      }
    }

    // Get tasks to search - check specific parameters first, then scope
    let searchTasks = [];
    if (params.projectId) {
      const project = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!project) {
        throw new Error(`Project not found with ID: ${params.projectId}`);
      }
      searchTasks = Array.from(project.flattenedTasks);
      
      // Apply tag combination filtering to project tasks if specified
      if (params.tagCombination) {
        searchTasks = searchTasks.filter(task => 
          matchesTagCombination(task, params.tagCombination)
        );
      } else if (params.tagId) {
        // Legacy tag filtering for project tasks
        searchTasks = searchTasks.filter(task => 
          task.tags.some(taskTag => bareId(taskTag.id) === params.tagId)
        );
      }
    } else if (params.tagCombination) {
      // For tag combinations, use all tasks and filter by combination
      searchTasks = Array.from(flattenedTasks).filter(task => 
        matchesTagCombination(task, params.tagCombination)
      );
    } else if (params.tagId) {
      // Legacy single tag support for backward compatibility
      const tag = flattenedTags.find(t => bareId(t.id) === params.tagId);
      if (!tag) {
        throw new Error(`Tag not found with ID: ${params.tagId}`);
      }
      searchTasks = Array.from(flattenedTasks).filter(task => 
        task.tags.some(taskTag => bareId(taskTag.id) === params.tagId)
      );
    } else if (scope === 'all') {
      searchTasks = Array.from(flattenedTasks);
    } else {
      searchTasks = Array.from(flattenedTasks);
    }
    
    // Apply status filters - filter out completed and/or dropped tasks as specified
    if (!includeCompleted || !includeDropped || params.active !== undefined) {
      searchTasks = searchTasks.filter(task => {
        // Exclude completed tasks if includeCompleted is false
        if (!includeCompleted && task.completed) {
          return false;
        }
        // Exclude dropped tasks if includeDropped is false (any inactive task is considered dropped)
        if (!includeDropped && !task.effectiveActive) {
          return false;
        }
        // Apply active filter if specified
        if (params.active !== undefined && task.effectiveActive !== params.active) {
          return false;
        }
        return true;
      });
    }
    
    // Apply advanced metadata filters - added for Task 1-20, enhanced for Task 1-17
    if (params.hasEstimate !== undefined || params.minEstimate !== undefined || 
        params.maxEstimate !== undefined || params.hasNotes !== undefined ||
        params.hasDueDate !== undefined || params.hasDeferDate !== undefined ||
        params.isOverdue !== undefined || params.isDueToday !== undefined ||
        params.isDueSoon !== undefined || params.isAvailable !== undefined ||
        // Task 1-17: Date range, duration, and status filters
        dueBefore || dueAfter || deferBefore || deferAfter ||
        params.minDuration !== undefined || params.maxDuration !== undefined ||
        params.flagged !== undefined || params.completed !== undefined ||
        params.blocked !== undefined || params.dropped !== undefined) {
      
      searchTasks = searchTasks.filter(task => {
        // Date range filters - NEW for Task 1-17
        if (dueBefore && (!task.dueDate || task.dueDate >= dueBefore)) return false;
        if (dueAfter && (!task.dueDate || task.dueDate <= dueAfter)) return false;
        if (deferBefore && (!task.deferDate || task.deferDate >= deferBefore)) return false;
        if (deferAfter && (!task.deferDate || task.deferDate <= deferAfter)) return false;
        
        // Duration filters - NEW for Task 1-17
        if (params.minDuration !== undefined && (!task.estimatedMinutes || task.estimatedMinutes < params.minDuration)) return false;
        if (params.maxDuration !== undefined && (!task.estimatedMinutes || task.estimatedMinutes > params.maxDuration)) return false;
        
        // Basic status filters - NEW for Task 1-17
        if (params.flagged !== undefined && task.flagged !== params.flagged) return false;
        if (params.completed !== undefined && task.completed !== params.completed) return false;
        if (params.dropped !== undefined && !task.effectiveActive !== params.dropped) return false;
        if (params.blocked !== undefined) {
          const isBlocked = task.taskStatus === Task.Status.Blocked;
          if (params.blocked !== isBlocked) return false;
        }
        
        // Time estimate filters
        if (params.hasEstimate !== undefined) {
          const hasEst = task.estimatedMinutes && task.estimatedMinutes > 0;
          if (hasEst !== params.hasEstimate) return false;
        }
        if (params.minEstimate !== undefined) {
          if (!task.estimatedMinutes || task.estimatedMinutes < params.minEstimate) return false;
        }
        if (params.maxEstimate !== undefined) {
          if (task.estimatedMinutes && task.estimatedMinutes > params.maxEstimate) return false;
        }
        
        // Content-based filters
        if (params.hasNotes !== undefined) {
          const hasNotes = task.note && task.note.trim().length > 0;
          if (hasNotes !== params.hasNotes) return false;
        }
        if (params.hasDueDate !== undefined) {
          const hasDue = !!task.dueDate;
          if (hasDue !== params.hasDueDate) return false;
        }
        if (params.hasDeferDate !== undefined) {
          const hasDefer = !!task.deferDate;
          if (hasDefer !== params.hasDeferDate) return false;
        }
        
        // Advanced date-based filters using helper functions
        if (params.isOverdue !== undefined) {
          if (isOverdue(task.dueDate) !== params.isOverdue) return false;
        }
        if (params.isDueToday !== undefined) {
          if (isToday(task.dueDate) !== params.isDueToday) return false;
        }
        if (params.isDueSoon !== undefined) {
          if (!isDueSoon(task.dueDate, params.isDueSoon)) return false;
        }
        
        // Availability filter using helper function
        if (params.isAvailable !== undefined) {
          if (isAvailableNow(task) !== params.isAvailable) return false;
        }
        
        return true;
      });
    }
    
    // Apply exclusion filters after all filtering but before search matching
    if (excludeProjectSet.size > 0 || excludeTagSet.size > 0 || excludeFolderSet.size > 0) {
      searchTasks = searchTasks.filter(task => {
        // Project exclusion check - use Set for O(1) lookup
        if (excludeProjectSet.size > 0 && task.containingProject && 
            excludeProjectSet.has(bareId(task.containingProject.id))) {
          return false;
        }
        
        // Tag exclusion check - exclude if task has any of the excluded tags
        if (excludeTagSet.size > 0 && task.tags.some(tag => 
            excludeTagSet.has(bareId(tag.id)))) {
          return false;
        }
        
        // Folder exclusion check - exclude if project is in excluded folder hierarchy
        if (excludeFolderSet.size > 0 && task.containingProject &&
            isInExcludedFolderOptimized(task.containingProject, excludeFolderSet)) {
          return false;
        }
        
        return true;
      });
    }
    
    // Simple fuzzy matching helper - checks if all query words are found in target text
    const fuzzyMatch = (text, queryWords) => {
      const normalizedText = text.toLowerCase();
      return queryWords.every(word => {
        if (normalizedText.includes(word)) return true;
        
        // Basic fuzzy matching - allow one character difference for words longer than 3 chars
        if (word.length <= 3) return false;
        
        // Check for simple transpositions and substitutions
        for (let i = 0; i < normalizedText.length - word.length + 1; i++) {
          const textSlice = normalizedText.slice(i, i + word.length);
          let differences = 0;
          
          for (let j = 0; j < word.length; j++) {
            if (textSlice[j] !== word[j]) {
              differences++;
              if (differences > 1) break;
            }
          }
          
          if (differences <= 1) return true;
        }
        
        return false;
      });
    };
    
    // Exact match helper
    const exactMatch = (text, queryWords) => {
      const normalizedText = text.toLowerCase();
      return queryWords.every(word => normalizedText.includes(word));
    };
    
    // Score and filter tasks
    const matchedTasks = [];
    
    for (const task of searchTasks) {
      const taskName = task.name || '';
      const taskNote = task.note || '';
      const searchText = `${taskName} ${taskNote}`;
      
      let score = 0;
      let matchType = '';
      
      // Check for matches
      if (fuzzy) {
        if (fuzzyMatch(taskName, queryWords)) {
          score += taskName.toLowerCase().includes(normalizedQuery) ? 100 : 80;
          matchType = 'name_fuzzy';
        } else if (fuzzyMatch(taskNote, queryWords)) {
          score += 40;
          matchType = 'note_fuzzy';
        } else if (fuzzyMatch(searchText, queryWords)) {
          score += 20;
          matchType = 'content_fuzzy';
        }
      } else {
        if (exactMatch(taskName, queryWords)) {
          score += taskName.toLowerCase().includes(normalizedQuery) ? 100 : 80;
          matchType = 'name_exact';
        } else if (exactMatch(taskNote, queryWords)) {
          score += 40;
          matchType = 'note_exact';
        } else if (exactMatch(searchText, queryWords)) {
          score += 20;
          matchType = 'content_exact';
        }
      }
      
      // Boost score for exact phrase matches
      if (score > 0) {
        if (taskName.toLowerCase().includes(normalizedQuery)) {
          score += 20;
        }
        if (taskNote.toLowerCase().includes(normalizedQuery)) {
          score += 10;
        }
        
        // Boost for shorter task names (more specific matches)
        if (taskName.length < 50) {
          score += 5;
        }
        
        // Boost for flagged tasks
        if (task.flagged) {
          score += 5;
        }
        
        matchedTasks.push({
          task: serializeTask(task),
          score: score,
          matchType: matchType
        });
      }
    }
    
    // Sort by score (descending) then by task name
    matchedTasks.sort((a, b) => {
      if (b.score !== a.score) {
        return b.score - a.score;
      }
      return a.task.name.localeCompare(b.task.name);
    });
    
    // Apply limit
    const limitedResults = matchedTasks.slice(0, maxResults);
    
    const results = {
      query: query,
      scope: scope,
      fuzzy: fuzzy,
      totalMatches: matchedTasks.length,
      returnedMatches: limitedResults.length,
      tasks: limitedResults.map(result => ({
        ...result.task,
        searchScore: result.score,
        matchType: result.matchType
      }))
    };
    
    // Cache the result
    setCachedWithTTL(cacheKey, results, queryCache, CACHE_CONFIG.maxCacheSize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('searchTasks', startTime, false);
    console.log(`[TIMING] searchTasks completed in ${processingTime}ms (${results.totalMatches} matches found, ${results.returnedMatches} returned)`);
    
    return results;
  };

  // Universal Query Builder - Task 1-18
  // Unified method combining all search and filtering capabilities with intelligent optimization
  
  // Helper functions for universalQuery optimization
  function hasSearchQuery(params) {
    return params.search && params.search.trim().length > 0;
  }
  
  function hasStructuredFilters(params) {
    return !!(
      params.dueBefore || params.dueAfter || params.deferBefore || params.deferAfter ||
      params.minDuration !== undefined || params.maxDuration !== undefined ||
      params.flagged !== undefined || params.completed !== undefined || 
      params.blocked !== undefined || params.dropped !== undefined ||
      params.hasEstimate !== undefined || params.minEstimate !== undefined || 
      params.maxEstimate !== undefined || params.hasNotes !== undefined ||
      params.hasDueDate !== undefined || params.hasDeferDate !== undefined ||
      params.isOverdue !== undefined || params.isDueToday !== undefined ||
      params.isDueSoon !== undefined || params.isAvailable !== undefined ||
      (params.excludeProjectIds && params.excludeProjectIds.length > 0) ||
      (params.excludeTagIds && params.excludeTagIds.length > 0) ||
      (params.excludeFolderIds && params.excludeFolderIds.length > 0) ||
      params.tagCombination || params.projectId || params.tagId
    );
  }
  
  function hasComplexFilters(params) {
    return !!(
      params.tagCombination ||
      (params.excludeProjectIds && params.excludeProjectIds.length > 0) ||
      (params.excludeTagIds && params.excludeTagIds.length > 0) ||
      (params.excludeFolderIds && params.excludeFolderIds.length > 0) ||
      (params.dueBefore && params.dueAfter) ||
      (params.deferBefore && params.deferAfter) ||
      (params.minDuration !== undefined && params.maxDuration !== undefined)
    );
  }
  
  function determineExecutionStrategy(params) {
    if (hasSearchQuery(params)) {
      if (hasStructuredFilters(params)) {
        return 'searchWithFilters';
      } else {
        return 'searchOnly';
      }
    } else if (hasComplexFilters(params)) {
      return 'advancedFiltering';
    } else if (hasStructuredFilters(params)) {
      return 'simpleFiltering';
    } else {
      return 'listAll';
    }
  }
  
  // Unified filtering engine that applies all filter types efficiently
  function applyUniversalFilters(tasks, params) {
    // Pre-parse date filters for efficiency
    const dueBefore = params.dueBefore ? new Date(params.dueBefore) : null;
    const dueAfter = params.dueAfter ? new Date(params.dueAfter) : null;
    const deferBefore = params.deferBefore ? new Date(params.deferBefore) : null;
    const deferAfter = params.deferAfter ? new Date(params.deferAfter) : null;
    
    // Convert exclusion arrays to Sets for O(1) lookup
    const excludeProjectSet = new Set(params.excludeProjectIds || []);
    const excludeTagSet = new Set(params.excludeTagIds || []);
    const excludeFolderSet = new Set(params.excludeFolderIds || []);
    
    return tasks.filter(task => {
      // Basic completion and active status filters (most common, check first)
      if (params.includeCompleted !== true && task.completed) return false;
      if (params.completed !== undefined && task.completed !== params.completed) return false;
      if (params.active !== undefined && task.effectiveActive !== params.active) return false;
      if (params.dropped !== undefined && !task.effectiveActive !== params.dropped) return false;
      
      // Status filters (quick boolean checks)
      if (params.flagged !== undefined && task.flagged !== params.flagged) return false;
      if (params.blocked !== undefined) {
        const isBlocked = task.taskStatus === Task.Status.Blocked;
        if (params.blocked !== isBlocked) return false;
      }
      
      // Date range filters (pre-parsed for efficiency)
      if (dueBefore && (!task.dueDate || task.dueDate >= dueBefore)) return false;
      if (dueAfter && (!task.dueDate || task.dueDate <= dueAfter)) return false;
      if (deferBefore && (!task.deferDate || task.deferDate >= deferBefore)) return false;
      if (deferAfter && (!task.deferDate || task.deferDate <= deferAfter)) return false;
      
      // Duration filters
      if (params.minDuration !== undefined && (!task.estimatedMinutes || task.estimatedMinutes < params.minDuration)) return false;
      if (params.maxDuration !== undefined && (!task.estimatedMinutes || task.estimatedMinutes > params.maxDuration)) return false;
      
      // Advanced metadata filters
      if (params.hasEstimate !== undefined) {
        const hasEst = task.estimatedMinutes && task.estimatedMinutes > 0;
        if (hasEst !== params.hasEstimate) return false;
      }
      if (params.minEstimate !== undefined) {
        if (!task.estimatedMinutes || task.estimatedMinutes < params.minEstimate) return false;
      }
      if (params.maxEstimate !== undefined) {
        if (task.estimatedMinutes && task.estimatedMinutes > params.maxEstimate) return false;
      }
      if (params.hasNotes !== undefined) {
        const hasNotes = task.note && task.note.trim().length > 0;
        if (hasNotes !== params.hasNotes) return false;
      }
      if (params.hasDueDate !== undefined) {
        const hasDue = !!task.dueDate;
        if (hasDue !== params.hasDueDate) return false;
      }
      if (params.hasDeferDate !== undefined) {
        const hasDefer = !!task.deferDate;
        if (hasDefer !== params.hasDeferDate) return false;
      }
      
      // Advanced date-based filters using helper functions
      if (params.isOverdue !== undefined) {
        if (isOverdue(task.dueDate) !== params.isOverdue) return false;
      }
      if (params.isDueToday !== undefined) {
        if (isToday(task.dueDate) !== params.isDueToday) return false;
      }
      if (params.isDueSoon !== undefined) {
        if (!isDueSoon(task.dueDate, params.isDueSoon)) return false;
      }
      if (params.isAvailable !== undefined) {
        if (isAvailableNow(task) !== params.isAvailable) return false;
      }
      
      // Boolean tag combination filtering
      if (params.tagCombination) {
        if (!matchesTagCombination(task, params.tagCombination)) return false;
      } else if (params.tagId) {
        // Legacy single tag filtering
        if (!task.tags.some(taskTag => bareId(taskTag.id) === params.tagId)) return false;
      }
      
      // Exclusion filters (apply last for efficiency)
      if (excludeProjectSet.size > 0 && task.containingProject && 
          excludeProjectSet.has(bareId(task.containingProject.id))) return false;
      
      if (excludeTagSet.size > 0 && task.tags.some(tag => 
          excludeTagSet.has(bareId(tag.id)))) return false;
      
      if (excludeFolderSet.size > 0 && task.containingProject &&
          isInExcludedFolderOptimized(task.containingProject, excludeFolderSet)) return false;
      
      return true;
    });
  }
  
  // Smart search scoring that integrates with filtering
  function applySearchScoring(tasks, searchQuery, fuzzy = true) {
    const normalizedQuery = searchQuery.toLowerCase().trim();
    const queryWords = normalizedQuery.split(/\s+/);
    const results = [];
    
    // Reuse existing fuzzy/exact match logic from searchTasks
    const fuzzyMatch = (text, queryWords) => {
      const normalizedText = text.toLowerCase();
      return queryWords.every(word => {
        if (normalizedText.includes(word)) return true;
        if (word.length <= 3) return false;
        
        for (let i = 0; i < normalizedText.length - word.length + 1; i++) {
          const textSlice = normalizedText.slice(i, i + word.length);
          let differences = 0;
          
          for (let j = 0; j < word.length; j++) {
            if (textSlice[j] !== word[j]) {
              differences++;
              if (differences > 1) break;
            }
          }
          
          if (differences <= 1) return true;
        }
        return false;
      });
    };
    
    const exactMatch = (text, queryWords) => {
      const normalizedText = text.toLowerCase();
      return queryWords.every(word => normalizedText.includes(word));
    };
    
    for (const task of tasks) {
      const taskName = task.name || '';
      const taskNote = task.note || '';
      const searchText = `${taskName} ${taskNote}`;
      
      let score = 0;
      let matchType = '';
      
      // Check for matches using appropriate strategy
      if (fuzzy) {
        if (fuzzyMatch(taskName, queryWords)) {
          score += taskName.toLowerCase().includes(normalizedQuery) ? 100 : 80;
          matchType = 'name_fuzzy';
        } else if (fuzzyMatch(taskNote, queryWords)) {
          score += 40;
          matchType = 'note_fuzzy';
        } else if (fuzzyMatch(searchText, queryWords)) {
          score += 20;
          matchType = 'content_fuzzy';
        }
      } else {
        if (exactMatch(taskName, queryWords)) {
          score += taskName.toLowerCase().includes(normalizedQuery) ? 100 : 80;
          matchType = 'name_exact';
        } else if (exactMatch(taskNote, queryWords)) {
          score += 40;
          matchType = 'note_exact';
        } else if (exactMatch(searchText, queryWords)) {
          score += 20;
          matchType = 'content_exact';
        }
      }
      
      // Apply scoring boosts
      if (score > 0) {
        if (taskName.toLowerCase().includes(normalizedQuery)) score += 20;
        if (taskNote.toLowerCase().includes(normalizedQuery)) score += 10;
        if (taskName.length < 50) score += 5;
        if (task.flagged) score += 5;
        
        results.push({
          task: task,
          score: score,
          matchType: matchType
        });
      }
    }
    
    return results;
  }
  
  // Relevance-based sorting for non-search queries
  function sortByRelevance(tasks) {
    return tasks.sort((a, b) => {
      // Flagged tasks first
      if (a.flagged !== b.flagged) return b.flagged - a.flagged;
      
      // Then by due date (earlier first, null last)
      if (a.dueDate && b.dueDate) {
        const dateDiff = a.dueDate.getTime() - b.dueDate.getTime();
        if (dateDiff !== 0) return dateDiff;
      } else if (a.dueDate && !b.dueDate) {
        return -1;
      } else if (!a.dueDate && b.dueDate) {
        return 1;
      }
      
      // Finally by name
      return a.name.localeCompare(b.name);
    });
  }

  lib.universalQuery = params => {
    const startTime = Date.now();
    
    // Extract and normalize parameters
    const searchQuery = params.search ? params.search.trim() : '';
    const fuzzy = params.fuzzy !== undefined ? params.fuzzy : true;
    const maxResults = params.maxResults || 100;
    const includeCompleted = params.includeCompleted !== undefined ? params.includeCompleted : false;
    const includeDropped = params.includeDropped !== undefined ? params.includeDropped : false;
    
    // Determine optimal execution strategy
    const strategy = determineExecutionStrategy(params);
    
    // Generate comprehensive cache key
    const cacheKey = getSmartCacheKey('universalQuery', {
      search: searchQuery.toLowerCase(),
      fuzzy,
      strategy,
      // All filter parameters
      dueBefore: params.dueBefore,
      dueAfter: params.dueAfter,
      deferBefore: params.deferBefore,
      deferAfter: params.deferAfter,
      minDuration: params.minDuration,
      maxDuration: params.maxDuration,
      flagged: params.flagged,
      completed: params.completed,
      blocked: params.blocked,
      dropped: params.dropped,
      active: params.active,
      projectId: params.projectId,
      tagId: params.tagId,
      tagCombination: params.tagCombination,
      includeCompleted,
      includeDropped,
      maxResults,
      excludeProjectIds: (params.excludeProjectIds || []).sort(),
      excludeTagIds: (params.excludeTagIds || []).sort(),
      excludeFolderIds: (params.excludeFolderIds || []).sort(),
      // Advanced metadata filters
      hasEstimate: params.hasEstimate,
      minEstimate: params.minEstimate,
      maxEstimate: params.maxEstimate,
      hasNotes: params.hasNotes,
      hasDueDate: params.hasDueDate,
      hasDeferDate: params.hasDeferDate,
      isOverdue: params.isOverdue,
      isDueToday: params.isDueToday,
      isDueSoon: params.isDueSoon,
      isAvailable: params.isAvailable
    }, 'universal');
    
    // Check cache first
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.queryDataTTL);
    if (cached) {
      trackPerformance('universalQuery', startTime, true);
      console.log(`universalQuery: ${Date.now() - startTime}ms (CACHE HIT, strategy: ${strategy})`);
      return cached;
    }
    
    // Validate tag combination if provided
    if (params.tagCombination) {
      const invalidTags = validateTagCombination(params.tagCombination);
      if (invalidTags.length > 0) {
        throw new Error(`Invalid tag IDs in tagCombination: ${invalidTags.join(', ')}`);
      }
    }
    
    // Get initial task set based on scope parameters
    let sourceTasks;
    if (params.projectId) {
      const project = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!project) {
        throw new Error(`Project not found with ID: ${params.projectId}`);
      }
      sourceTasks = Array.from(project.flattenedTasks);
    } else if (params.tagCombination) {
      // For tag combinations, start with all tasks and filter in main loop
      sourceTasks = Array.from(flattenedTasks);
    } else if (params.tagId) {
      // Pre-filter by single tag for performance
      const tag = flattenedTags.find(t => bareId(t.id) === params.tagId);
      if (!tag) {
        throw new Error(`Tag not found with ID: ${params.tagId}`);
      }
      sourceTasks = Array.from(flattenedTasks).filter(task => 
        task.tags.some(taskTag => bareId(taskTag.id) === params.tagId)
      );
    } else {
      sourceTasks = Array.from(flattenedTasks);
    }
    
    console.log(`[UNIVERSAL] Strategy: ${strategy}, Source tasks: ${sourceTasks.length}`);
    
    // Apply unified filtering
    let filteredTasks = applyUniversalFilters(sourceTasks, params);
    
    console.log(`[UNIVERSAL] After filtering: ${filteredTasks.length} tasks`);
    
    // Apply search scoring if search query provided
    let results;
    if (searchQuery) {
      const searchResults = applySearchScoring(filteredTasks, searchQuery, fuzzy);
      
      // Sort by search score (descending)
      searchResults.sort((a, b) => {
        if (b.score !== a.score) {
          return b.score - a.score;
        }
        return a.task.name.localeCompare(b.task.name);
      });
      
      // Apply limit and serialize with search metadata
      const limitedResults = searchResults.slice(0, maxResults);
      results = {
        strategy: strategy,
        search: searchQuery,
        fuzzy: fuzzy,
        totalMatches: searchResults.length,
        returnedMatches: limitedResults.length,
        executionTime: Date.now() - startTime,
        tasks: limitedResults.map(result => ({
          ...serializeTask(result.task),
          searchScore: result.score,
          matchType: result.matchType
        }))
      };
    } else {
      // No search - sort by relevance and return filtered results
      const sortedTasks = sortByRelevance(filteredTasks);
      const limitedResults = sortedTasks.slice(0, maxResults);
      
      results = {
        strategy: strategy,
        search: null,
        fuzzy: null,
        totalMatches: filteredTasks.length,
        returnedMatches: limitedResults.length,
        executionTime: Date.now() - startTime,
        tasks: limitedResults.map(serializeTask)
      };
    }
    
    // Cache the result
    setCachedWithTTL(cacheKey, results, queryCache, CACHE_CONFIG.maxCacheSize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('universalQuery', startTime, false);
    console.log(`[TIMING] universalQuery completed in ${processingTime}ms (strategy: ${strategy}, ${results.totalMatches} matches, ${results.returnedMatches} returned)`);
    
    return results;
  };

  // ============ PROJECT GROUP TYPE MANAGEMENT (Task 3-5) ============
  
  lib.getProjectGroupType = params => {
    const startTime = Date.now();
    
    if (!params.projectName && !params.projectId) {
      throw new Error("getProjectGroupType: Either projectName or projectId must be provided");
    }
    
    // Create cache key
    const cacheKey = getSmartCacheKey('getProjectGroupType', {
      projectName: params.projectName,
      projectId: params.projectId
    }, 'project');
    
    // Check cache first
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.projectDataTTL);
    if (cached) {
      trackPerformance('getProjectGroupType', startTime, true);
      return cached;
    }
    
    // Find the project
    let project;
    if (params.projectId) {
      project = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!project) {
        throw new Error(`getProjectGroupType: Project not found with ID: ${params.projectId}`);
      }
    } else {
      project = flattenedProjects.find(p => p.name === params.projectName);
      if (!project) {
        throw new Error(`getProjectGroupType: Project not found with name: ${params.projectName}`);
      }
    }
    
    // Read the sequential property and convert to group type
    const groupType = project.sequential ? 'sequential' : 'parallel';
    
    // Gather additional metadata
    const taskCount = project.flattenedTasks.length;
    const completedTasks = Array.from(project.flattenedTasks).filter(t => t.completed).length;
    const activeTasks = taskCount - completedTasks;
    
    const result = {
      projectId: bareId(project.id),
      projectName: project.name,
      groupType: groupType,
      metadata: {
        sequential: project.sequential,  // Include raw boolean for reference
        taskCount: taskCount,
        activeTasks: activeTasks,
        completedTasks: completedTasks,
        folderName: project.containingProject ? null : (project.folder ? project.folder.name : null),
        status: project.status.name,
        added: toIsoOrNull(project.added),
        modified: toIsoOrNull(project.modified)
      },
      executionTime: Date.now() - startTime
    };
    
    // Cache the result
    setCachedWithTTL(cacheKey, result, queryCache, CACHE_CONFIG.maxCacheSize);
    
    trackPerformance('getProjectGroupType', startTime, false);
    console.log(`[TIMING] getProjectGroupType completed in ${Date.now() - startTime}ms for project: ${project.name}`);
    
    return result;
  };
  
  lib.setProjectGroupType = params => {
    const startTime = Date.now();
    
    if (!params.projectName && !params.projectId) {
      throw new Error("setProjectGroupType: Either projectName or projectId must be provided");
    }
    
    if (!params.groupType) {
      throw new Error("setProjectGroupType: groupType parameter is required");
    }
    
    // Validate group type value
    if (params.groupType !== 'parallel' && params.groupType !== 'sequential') {
      throw new Error(`setProjectGroupType: Invalid groupType '${params.groupType}'. Must be 'parallel' or 'sequential'`);
    }
    
    // Find the project
    let project;
    if (params.projectId) {
      project = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!project) {
        throw new Error(`setProjectGroupType: Project not found with ID: ${params.projectId}`);
      }
    } else {
      project = flattenedProjects.find(p => p.name === params.projectName);
      if (!project) {
        throw new Error(`setProjectGroupType: Project not found with name: ${params.projectName}`);
      }
    }
    
    // Convert group type to sequential boolean
    const newSequentialValue = (params.groupType === 'sequential');
    const previousGroupType = project.sequential ? 'sequential' : 'parallel';
    
    // Only make change if different
    if (project.sequential !== newSequentialValue) {
      try {
        project.sequential = newSequentialValue;
        
        // Invalidate related caches
        invalidateProjectCaches(bareId(project.id));
        
        console.log(`[PROJECT] Set group type for '${project.name}' from ${previousGroupType} to ${params.groupType}`);
      } catch (error) {
        throw new Error(`setProjectGroupType: Failed to set group type for project '${project.name}': ${error.message}`);
      }
    }
    
    // Gather updated metadata
    const taskCount = project.flattenedTasks.length;
    const completedTasks = Array.from(project.flattenedTasks).filter(t => t.completed).length;
    const activeTasks = taskCount - completedTasks;
    
    const result = {
      projectId: bareId(project.id),
      projectName: project.name,
      previousGroupType: previousGroupType,
      newGroupType: params.groupType,
      changed: project.sequential !== (previousGroupType === 'sequential'),
      metadata: {
        sequential: project.sequential,
        taskCount: taskCount,
        activeTasks: activeTasks,
        completedTasks: completedTasks,
        folderName: project.containingProject ? null : (project.folder ? project.folder.name : null),
        status: project.status.name
      },
      executionTime: Date.now() - startTime
    };
    
    trackPerformance('setProjectGroupType', startTime, false);
    console.log(`[TIMING] setProjectGroupType completed in ${Date.now() - startTime}ms for project: ${project.name}`);
    
    return result;
  };
  
  // ============ PROJECT COMPLETION BEHAVIOR MANAGEMENT (Task 3-6) ============
  
  lib.getProjectCompletionBehavior = params => {
    const startTime = Date.now();
    
    if (!params.projectName && !params.projectId) {
      throw new Error("getProjectCompletionBehavior: Either projectName or projectId must be provided");
    }
    
    // Create cache key
    const cacheKey = getSmartCacheKey('getProjectCompletionBehavior', {
      projectName: params.projectName,
      projectId: params.projectId
    }, 'project');
    
    // Check cache first
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.projectDataTTL);
    if (cached) {
      trackPerformance('getProjectCompletionBehavior', startTime, true);
      return cached;
    }
    
    // Find the project
    let project;
    if (params.projectId) {
      project = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!project) {
        throw new Error(`getProjectCompletionBehavior: Project not found with ID: ${params.projectId}`);
      }
    } else {
      project = flattenedProjects.find(p => p.name === params.projectName);
      if (!project) {
        throw new Error(`getProjectCompletionBehavior: Project not found with name: ${params.projectName}`);
      }
    }
    
    // Read the completedByChildren property and convert to completion behavior
    const completionBehavior = project.completedByChildren ? 'completeWithLastAction' : 'manual';
    
    // Gather additional metadata
    const taskCount = project.flattenedTasks.length;
    const completedTasks = Array.from(project.flattenedTasks).filter(t => t.completed).length;
    const activeTasks = taskCount - completedTasks;
    
    const result = {
      projectId: bareId(project.id),
      projectName: project.name,
      completionBehavior: completionBehavior,
      metadata: {
        completedByChildren: project.completedByChildren,  // Include raw boolean for reference
        taskCount: taskCount,
        activeTasks: activeTasks,
        completedTasks: completedTasks,
        projectCompleted: project.completed,
        folderName: project.containingProject ? null : (project.folder ? project.folder.name : null),
        status: project.status.name
      },
      executionTime: Date.now() - startTime
    };
    
    // Cache the result
    setCachedWithTTL(cacheKey, result, queryCache, CACHE_CONFIG.maxCacheSize);
    
    trackPerformance('getProjectCompletionBehavior', startTime, false);
    console.log(`[TIMING] getProjectCompletionBehavior completed in ${Date.now() - startTime}ms for project: ${project.name}`);
    
    return result;
  };
  
  lib.setProjectCompletionBehavior = params => {
    const startTime = Date.now();
    
    if (!params.projectName && !params.projectId) {
      throw new Error("setProjectCompletionBehavior: Either projectName or projectId must be provided");
    }
    
    if (!params.completionBehavior) {
      throw new Error("setProjectCompletionBehavior: completionBehavior parameter is required");
    }
    
    // Validate completion behavior value
    if (params.completionBehavior !== 'completeWithLastAction' && params.completionBehavior !== 'manual') {
      throw new Error(`setProjectCompletionBehavior: Invalid completionBehavior '${params.completionBehavior}'. Must be 'completeWithLastAction' or 'manual'`);
    }
    
    // Find the project
    let project;
    if (params.projectId) {
      project = flattenedProjects.find(p => bareId(p.id) === params.projectId);
      if (!project) {
        throw new Error(`setProjectCompletionBehavior: Project not found with ID: ${params.projectId}`);
      }
    } else {
      project = flattenedProjects.find(p => p.name === params.projectName);
      if (!project) {
        throw new Error(`setProjectCompletionBehavior: Project not found with name: ${params.projectName}`);
      }
    }
    
    // Convert completion behavior to completedByChildren boolean
    const newCompletedByChildrenValue = (params.completionBehavior === 'completeWithLastAction');
    const previousBehavior = project.completedByChildren ? 'completeWithLastAction' : 'manual';
    
    // Only make change if different
    if (project.completedByChildren !== newCompletedByChildrenValue) {
      try {
        project.completedByChildren = newCompletedByChildrenValue;
        
        // Invalidate related caches
        invalidateProjectCaches(bareId(project.id));
        
        console.log(`[PROJECT] Set completion behavior for '${project.name}' from ${previousBehavior} to ${params.completionBehavior}`);
      } catch (error) {
        throw new Error(`setProjectCompletionBehavior: Failed to set completion behavior for project '${project.name}': ${error.message}`);
      }
    }
    
    // Gather updated metadata
    const taskCount = project.flattenedTasks.length;
    const completedTasks = Array.from(project.flattenedTasks).filter(t => t.completed).length;
    const activeTasks = taskCount - completedTasks;
    
    const result = {
      projectId: bareId(project.id),
      projectName: project.name,
      previousCompletionBehavior: previousBehavior,
      newCompletionBehavior: params.completionBehavior,
      changed: project.completedByChildren !== (previousBehavior === 'completeWithLastAction'),
      metadata: {
        completedByChildren: project.completedByChildren,
        taskCount: taskCount,
        activeTasks: activeTasks,
        completedTasks: completedTasks,
        projectCompleted: project.completed,
        folderName: project.containingProject ? null : (project.folder ? project.folder.name : null),
        status: project.status.name
      },
      executionTime: Date.now() - startTime
    };
    
    trackPerformance('setProjectCompletionBehavior', startTime, false);
    console.log(`[TIMING] setProjectCompletionBehavior completed in ${Date.now() - startTime}ms for project: ${project.name}`);
    
    return result;
  };
  
  // ============ TASK GROUP TYPE MANAGEMENT (Task 3-7) ============
  
  lib.getTaskGroupType = params => {
    const startTime = Date.now();
    
    if (!params.taskName && !params.taskId) {
      throw new Error("getTaskGroupType: Either taskName or taskId must be provided");
    }
    
    // Create cache key
    const cacheKey = getSmartCacheKey('getTaskGroupType', {
      taskName: params.taskName,
      taskId: params.taskId
    }, 'task');
    
    // Check cache first
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.taskDataTTL);
    if (cached) {
      trackPerformance('getTaskGroupType', startTime, true);
      return cached;
    }
    
    // Find the task
    let task;
    if (params.taskId) {
      task = flattenedTasks.find(t => bareId(t.id) === params.taskId);
      if (!task) {
        throw new Error(`getTaskGroupType: Task not found with ID: ${params.taskId}`);
      }
    } else {
      task = flattenedTasks.find(t => t.name === params.taskName);
      if (!task) {
        throw new Error(`getTaskGroupType: Task not found with name: ${params.taskName}`);
      }
    }
    
    // Validate task has subtasks
    const subtaskCount = task.flattenedTasks.length;
    if (subtaskCount === 0) {
      throw new Error(`getTaskGroupType: Task '${task.name}' has no subtasks. Group type only applies to parent tasks with subtasks.`);
    }
    
    // Read the sequential property and convert to group type
    const groupType = task.sequential ? 'sequential' : 'parallel';
    
    // Gather additional metadata
    const completedSubtasks = Array.from(task.flattenedTasks).filter(t => t.completed).length;
    const activeSubtasks = subtaskCount - completedSubtasks;
    
    const result = {
      taskId: bareId(task.id),
      taskName: task.name,
      groupType: groupType,
      metadata: {
        sequential: task.sequential,  // Include raw boolean for reference
        subtaskCount: subtaskCount,
        activeSubtasks: activeSubtasks,
        completedSubtasks: completedSubtasks,
        taskCompleted: task.completed,
        projectName: task.containingProject ? task.containingProject.name : null,
        parentTaskName: task.parent ? task.parent.name : null
      },
      executionTime: Date.now() - startTime
    };
    
    // Cache the result
    setCachedWithTTL(cacheKey, result, queryCache, CACHE_CONFIG.maxCacheSize);
    
    trackPerformance('getTaskGroupType', startTime, false);
    console.log(`[TIMING] getTaskGroupType completed in ${Date.now() - startTime}ms for task: ${task.name}`);
    
    return result;
  };
  
  lib.setTaskGroupType = params => {
    const startTime = Date.now();
    
    if (!params.taskName && !params.taskId) {
      throw new Error("setTaskGroupType: Either taskName or taskId must be provided");
    }
    
    if (!params.groupType) {
      throw new Error("setTaskGroupType: groupType parameter is required");
    }
    
    // Validate group type value
    if (params.groupType !== 'parallel' && params.groupType !== 'sequential') {
      throw new Error(`setTaskGroupType: Invalid groupType '${params.groupType}'. Must be 'parallel' or 'sequential'`);
    }
    
    // Find the task
    let task;
    if (params.taskId) {
      task = flattenedTasks.find(t => bareId(t.id) === params.taskId);
      if (!task) {
        throw new Error(`setTaskGroupType: Task not found with ID: ${params.taskId}`);
      }
    } else {
      task = flattenedTasks.find(t => t.name === params.taskName);
      if (!task) {
        throw new Error(`setTaskGroupType: Task not found with name: ${params.taskName}`);
      }
    }
    
    // Validate task has subtasks
    const subtaskCount = task.flattenedTasks.length;
    if (subtaskCount === 0) {
      throw new Error(`setTaskGroupType: Task '${task.name}' has no subtasks. Group type only applies to parent tasks with subtasks.`);
    }
    
    // Convert group type to sequential boolean
    const newSequentialValue = (params.groupType === 'sequential');
    const previousGroupType = task.sequential ? 'sequential' : 'parallel';
    
    // Only make change if different
    if (task.sequential !== newSequentialValue) {
      try {
        task.sequential = newSequentialValue;
        
        // Invalidate related caches (task caches)
        invalidateTaskCaches(bareId(task.id));
        
        console.log(`[TASK] Set group type for '${task.name}' from ${previousGroupType} to ${params.groupType}`);
      } catch (error) {
        throw new Error(`setTaskGroupType: Failed to set group type for task '${task.name}': ${error.message}`);
      }
    }
    
    // Gather updated metadata
    const completedSubtasks = Array.from(task.flattenedTasks).filter(t => t.completed).length;
    const activeSubtasks = subtaskCount - completedSubtasks;
    
    const result = {
      taskId: bareId(task.id),
      taskName: task.name,
      previousGroupType: previousGroupType,
      newGroupType: params.groupType,
      changed: task.sequential !== (previousGroupType === 'sequential'),
      metadata: {
        sequential: task.sequential,
        subtaskCount: subtaskCount,
        activeSubtasks: activeSubtasks,
        completedSubtasks: completedSubtasks,
        taskCompleted: task.completed,
        projectName: task.containingProject ? task.containingProject.name : null,
        parentTaskName: task.parent ? task.parent.name : null
      },
      executionTime: Date.now() - startTime
    };
    
    trackPerformance('setTaskGroupType', startTime, false);
    console.log(`[TIMING] setTaskGroupType completed in ${Date.now() - startTime}ms for task: ${task.name}`);
    
    return result;
  };
  
  // ============ PROJECT HIERARCHY NAVIGATION (Task 3-4) ============
  
  lib.getProjectHierarchy = params => {
    const startTime = Date.now();
    
    // Check hierarchy cache first with extended TTL for stable hierarchies
    const cacheKey = getSmartCacheKey('getProjectHierarchy', params, 'hierarchy');
    const cached = getCachedWithTTL(cacheKey, hierarchyCache, CACHE_CONFIG.hierarchyDataTTL);
    if (cached) {
      trackPerformance('getProjectHierarchy', startTime, true);
      console.log(`getProjectHierarchy: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    const includeCompleted = params.includeCompleted !== undefined ? params.includeCompleted : false;
    const includeDropped = params.includeDropped !== undefined ? params.includeDropped : false;
    const maxDepth = params.maxDepth;
    
    // Access all folders from the database for path building
    const allFolders = [];
    flattenedSections.forEach(section => {
      if (section.constructor.name === 'Folder') {
        allFolders.push(section);
      }
    });
    
    // Helper function to build folder path
    function buildFolderPath(folder) {
      const path = [];
      let current = folder;
      while (current) {
        path.unshift(current.name);
        current = current.parent;
      }
      return path;
    }
    
    // Helper function to get folder depth
    function getFolderDepth(folder) {
      let depth = 0;
      let current = folder;
      while (current) {
        depth++;
        current = current.parent;
      }
      return depth;
    }
    
    // Process all projects and build hierarchy items
    const results = [];
    
    for (const project of flattenedProjects) {
      // Apply status filters
      if (!includeCompleted && project.completed) continue;
      if (!includeDropped && !project.effectiveActive) continue;
      
      // Check depth limit if specified
      const folderDepth = project.folder ? getFolderDepth(project.folder) : 0;
      if (maxDepth !== undefined && folderDepth > maxDepth) continue;
      
      // Build project hierarchy item
      const hierarchyItem = {
        projectId: bareId(project.id),
        projectName: project.name,
        projectStatus: project.status.name,
        completed: project.completed,
        active: project.effectiveActive,
        
        // Folder context
        folderId: project.folder ? bareId(project.folder.id) : null,
        folderName: project.folder ? project.folder.name : null,
        folderPath: project.folder ? buildFolderPath(project.folder) : [],
        folderDepth: folderDepth,
        
        // Project metadata
        taskCount: project.flattenedTasks.length,
        activeTaskCount: Array.from(project.flattenedTasks).filter(t => !t.completed && t.effectiveActive).length,
        completedTaskCount: Array.from(project.flattenedTasks).filter(t => t.completed).length,
        
        // Project properties
        sequential: project.sequential,
        completedByChildren: project.completedByChildren,
      added: toIsoOrNull(project.added),
      modified: toIsoOrNull(project.modified),
        
        // Additional context
        containingProject: project.containingProject ? {
          id: bareId(project.containingProject.id),
          name: project.containingProject.name
        } : null
      };
      
      results.push(hierarchyItem);
    }
    
    // Sort by folder path then project name for consistent ordering
    results.sort((a, b) => {
      const pathCompare = a.folderPath.join('/').localeCompare(b.folderPath.join('/'));
      return pathCompare !== 0 ? pathCompare : a.projectName.localeCompare(b.projectName);
    });
    
    // Cache the result in hierarchy cache with extended TTL
    setCachedWithTTL(cacheKey, results, hierarchyCache, CACHE_CONFIG.maxHierarchySize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('getProjectHierarchy', startTime, false);
    console.log(`[TIMING] getProjectHierarchy completed in ${processingTime}ms (${results.length} projects)`);
    
    return results;
  };
  
  lib.getProjectTree = params => {
    const startTime = Date.now();
    
    // Check hierarchy cache first with extended TTL for stable hierarchies
    const cacheKey = getSmartCacheKey('getProjectTree', params, 'hierarchy');
    const cached = getCachedWithTTL(cacheKey, hierarchyCache, CACHE_CONFIG.hierarchyDataTTL);
    if (cached) {
      trackPerformance('getProjectTree', startTime, true);
      console.log(`getProjectTree: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    const includeCompleted = params.includeCompleted !== undefined ? params.includeCompleted : false;
    const includeDropped = params.includeDropped !== undefined ? params.includeDropped : false;
    const foldersOnly = params.foldersOnly !== undefined ? params.foldersOnly : false;
    
    // Access all folders from the database
    const allFolders = [];
    flattenedSections.forEach(section => {
      if (section.constructor.name === 'Folder') {
        allFolders.push(section);
      }
    });
    
    // Helper function to serialize project for tree
    function serializeProjectForTree(project) {
      return {
        projectId: bareId(project.id),
        projectName: project.name,
        projectStatus: project.status.name,
        completed: project.completed,
        active: project.effectiveActive,
        taskCount: project.flattenedTasks.length,
        activeTaskCount: Array.from(project.flattenedTasks).filter(t => !t.completed && t.effectiveActive).length,
        completedTaskCount: Array.from(project.flattenedTasks).filter(t => t.completed).length,
        sequential: project.sequential,
        completedByChildren: project.completedByChildren
      };
    }
    
    // Helper function to build tree node
    function buildTreeNode(folder) {
      const folderInfo = {
        folderId: bareId(folder.id),
        folderName: folder.name,
        active: folder.active,
        parentFolderId: folder.parent ? bareId(folder.parent.id) : null,
        added: toIsoOrNull(folder.added),
        modified: toIsoOrNull(folder.modified)
      };
      
      const node = {
        folder: folderInfo,
        subfolders: [],
        projects: foldersOnly ? undefined : []
      };
      
      // Process subfolders recursively
      for (const subfolder of folder.folders) {
        if (subfolder.active || includeDropped) {
          node.subfolders.push(buildTreeNode(subfolder));
        }
      }
      
      // Add projects if not folders-only mode
      if (!foldersOnly) {
        for (const project of folder.projects) {
          // Apply status filters
          if (!includeCompleted && project.completed) continue;
          if (!includeDropped && !project.effectiveActive) continue;
          
          node.projects.push(serializeProjectForTree(project));
        }
        
        // Sort projects by name
        node.projects.sort((a, b) => a.projectName.localeCompare(b.projectName));
      }
      
      // Sort subfolders by name
      node.subfolders.sort((a, b) => a.folder.folderName.localeCompare(b.folder.folderName));
      
      return node;
    }
    
    // Build tree starting from root folders
    const rootFolders = allFolders.filter(f => !f.parent);
    const tree = {
      rootLevel: {
        folders: [],
        projects: foldersOnly ? undefined : []
      }
    };
    
    // Process root-level folders
    for (const folder of rootFolders) {
      if (folder.active || includeDropped) {
        tree.rootLevel.folders.push(buildTreeNode(folder));
      }
    }
    
    // Add root-level projects (projects not in any folder)
    if (!foldersOnly) {
      const rootProjects = flattenedProjects.filter(p => !p.folder);
      for (const project of rootProjects) {
        // Apply status filters
        if (!includeCompleted && project.completed) continue;
        if (!includeDropped && !project.effectiveActive) continue;
        
        tree.rootLevel.projects.push(serializeProjectForTree(project));
      }
      
      // Sort root-level projects by name
      tree.rootLevel.projects.sort((a, b) => a.projectName.localeCompare(b.projectName));
    }
    
    // Sort root-level folders by name
    tree.rootLevel.folders.sort((a, b) => a.folder.folderName.localeCompare(b.folder.folderName));
    
    // Add summary metadata
    tree.metadata = {
      totalFolders: allFolders.length,
      totalProjects: flattenedProjects.length,
      includeCompleted: includeCompleted,
      includeDropped: includeDropped,
      foldersOnly: foldersOnly,
      generatedAt: new Date().toISOString()
    };
    
    // Cache the result in hierarchy cache with extended TTL
    setCachedWithTTL(cacheKey, tree, hierarchyCache, CACHE_CONFIG.maxHierarchySize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('getProjectTree', startTime, false);
    console.log(`[TIMING] getProjectTree completed in ${processingTime}ms`);
    
    return tree;
  };

  // ===== FOLDER MANAGEMENT METHODS (Task 4-1) =====
  
  lib.createFolder = params => {
    const startTime = Date.now();
    
    if (!params.name || typeof params.name !== 'string' || params.name.trim() === '') {
      throw new Error("Folder name is required and must be a non-empty string");
    }
    
    const folderName = params.name.trim();
    const parentFolderId = params.parentFolderId;
    const position = params.position; // number for position within parent
    
    try {
      let insertionLocation = null;
      
      // Determine insertion location
      if (parentFolderId) {
        // Create as child of specified parent folder
        const parentFolder = flattenedSections.find(f => 
          f.constructor.name === 'Folder' && bareId(f.id) === parentFolderId
        );
        
        if (!parentFolder) {
          throw new Error(`Parent folder not found: ${parentFolderId}`);
        }
        
        if (typeof position === 'number') {
          // Position within parent folder
          const siblings = Array.from(parentFolder.folders);
          if (position >= 0 && position < siblings.length) {
            insertionLocation = siblings[position].before;
          } else if (position >= siblings.length) {
            insertionLocation = parentFolder.ending;
          } else {
            throw new Error(`Invalid position ${position}. Must be between 0 and ${siblings.length}`);
          }
        } else {
          // Default to end of parent folder
          insertionLocation = parentFolder.ending;
        }
      } else {
        // Create at top level (library)
        if (typeof position === 'number') {
          // Position within library
          const libraryFolders = Array.from(library).filter(item => 
            item.constructor.name === 'Folder'
          );
          if (position >= 0 && position < libraryFolders.length) {
            insertionLocation = libraryFolders[position].before;
          } else if (position >= libraryFolders.length) {
            insertionLocation = library.ending;
          } else {
            throw new Error(`Invalid position ${position}. Must be between 0 and ${libraryFolders.length}`);
          }
        } else {
          // Default to end of library
          insertionLocation = library.ending;
        }
      }
      
      // Create the new folder
      const newFolder = new Folder(folderName, insertionLocation);
      
      // Invalidate organizational caches
      invalidateOrganizationalCache('folder', bareId(newFolder.id));
      
      const result = {
        folderId: bareId(newFolder.id),
        folderName: newFolder.name,
        parentFolderId: newFolder.parent ? bareId(newFolder.parent.id) : null,
        active: newFolder.active,
        created: true
      };
      
      const processingTime = Date.now() - startTime;
      trackPerformance('createFolder', startTime, false);
      console.log(`[TIMING] createFolder completed in ${processingTime}ms`);
      
      return result;
      
    } catch (error) {
      console.log(`[ERROR] createFolder failed: ${error.message}`);
      throw new Error(`Failed to create folder: ${error.message}`);
    }
  };
  
  lib.validateFolderName = params => {
    const name = params.name;
    
    if (!name || typeof name !== 'string') {
      return { valid: false, error: "Folder name must be a string" };
    }
    
    const trimmedName = name.trim();
    
    if (trimmedName === '') {
      return { valid: false, error: "Folder name cannot be empty" };
    }
    
    if (trimmedName.length > 255) {
      return { valid: false, error: "Folder name cannot exceed 255 characters" };
    }
    
    // Check for duplicate names in the target location
    const parentFolderId = params.parentFolderId;
    let siblings = [];
    
    if (parentFolderId) {
      const parentFolder = flattenedSections.find(f => 
        f.constructor.name === 'Folder' && bareId(f.id) === parentFolderId
      );
      if (!parentFolder) {
        return { valid: false, error: `Parent folder not found: ${parentFolderId}` };
      }
      siblings = Array.from(parentFolder.folders);
    } else {
      // Check top-level folders
      siblings = Array.from(library).filter(item => item.constructor.name === 'Folder');
    }
    
    const duplicateName = siblings.some(folder => folder.name === trimmedName);
    if (duplicateName) {
      return { valid: false, error: `A folder named "${trimmedName}" already exists in this location` };
    }
    
    return { valid: true, trimmedName: trimmedName };
  };
  
  lib.getFolderById = params => {
    const folderId = params.folderId;
    
    if (!folderId) {
      throw new Error("folderId parameter is required");
    }
    
    const folder = flattenedSections.find(f => 
      f.constructor.name === 'Folder' && bareId(f.id) === folderId
    );
    
    if (!folder) {
      return null;
    }
    
    return {
      folderId: bareId(folder.id),
      folderName: folder.name,
      parentFolderId: folder.parent ? bareId(folder.parent.id) : null,
      active: folder.active,
      status: folder.status.name,
      subfolderCount: folder.folders.length,
      projectCount: folder.projects.length,
      totalSubfoldersCount: folder.flattenedFolders.length,
      totalProjectsCount: folder.flattenedProjects.length
    };
  };
  
  lib.listFolders = params => {
    const startTime = Date.now();
    
    // Check cache first
    const cacheKey = getSmartCacheKey('listFolders', params || {}, 'organizational');
    const cached = getCachedWithTTL(cacheKey, queryCache, CACHE_CONFIG.organizationalDataTTL);
    if (cached) {
      trackPerformance('listFolders', startTime, true);
      console.log(`listFolders: ${Date.now() - startTime}ms (CACHE HIT)`);
      return cached;
    }
    
    const includeDropped = params && params.includeDropped !== undefined ? params.includeDropped : false;
    const parentFolderId = params && params.parentFolderId;
    
    let folders = [];
    
    if (parentFolderId) {
      // Get subfolders of specific parent
      const parentFolder = flattenedSections.find(f => 
        f.constructor.name === 'Folder' && bareId(f.id) === parentFolderId
      );
      
      if (!parentFolder) {
        throw new Error(`Parent folder not found: ${parentFolderId}`);
      }
      
      folders = Array.from(parentFolder.folders);
    } else {
      // Get top-level folders
      folders = Array.from(library).filter(item => item.constructor.name === 'Folder');
    }
    
    // Apply status filter
    if (!includeDropped) {
      folders = folders.filter(f => f.active);
    }
    
    const result = folders.map(folder => ({
      folderId: bareId(folder.id),
      folderName: folder.name,
      parentFolderId: folder.parent ? bareId(folder.parent.id) : null,
      active: folder.active,
      status: folder.status.name,
      subfolderCount: folder.folders.length,
      projectCount: folder.projects.length
    }));
    
    // Sort by name
    result.sort((a, b) => a.folderName.localeCompare(b.folderName));
    
    // Cache the result
    setCachedWithTTL(cacheKey, result, queryCache, CACHE_CONFIG.maxCacheSize);
    
    const processingTime = Date.now() - startTime;
    trackPerformance('listFolders', startTime, false);
    console.log(`[TIMING] listFolders completed in ${processingTime}ms (${result.length} folders)`);
    
    return result;
  };
  
  // ===== PROJECT MOVEMENT METHODS (Task 4-2) =====
  
  lib.moveProject = params => {
    const startTime = Date.now();
    
    if (!params.projectId || typeof params.projectId !== 'string') {
      throw new Error("Project ID is required and must be a string");
    }
    
    const projectId = params.projectId;
    const targetFolderId = params.targetFolderId; // null for library root
    const position = params.position; // number for position within target
    
    try {
      // Find the project to move
      const project = flattenedProjects.find(p => bareId(p.id) === projectId);
      if (!project) {
        throw new Error(`Project not found: ${projectId}`);
      }
      
      // Store original location for rollback info
      const originalFolder = project.parentFolder;
      const originalFolderId = originalFolder ? bareId(originalFolder.id) : null;
      
      let insertionLocation = null;
      
      // Determine target insertion location
      if (targetFolderId) {
        // Move to specific folder
        const targetFolder = flattenedSections.find(f => 
          f.constructor.name === 'Folder' && bareId(f.id) === targetFolderId
        );
        
        if (!targetFolder) {
          throw new Error(`Target folder not found: ${targetFolderId}`);
        }
        
        if (typeof position === 'number') {
          // Position within target folder
          const folderProjects = Array.from(targetFolder.projects);
          if (position >= 0 && position < folderProjects.length) {
            insertionLocation = folderProjects[position].before;
          } else if (position >= folderProjects.length) {
            insertionLocation = targetFolder.ending;
          } else {
            throw new Error(`Invalid position ${position}. Must be between 0 and ${folderProjects.length}`);
          }
        } else {
          // Default to end of target folder
          insertionLocation = targetFolder.ending;
        }
      } else {
        // Move to library root
        if (typeof position === 'number') {
          // Position within library
          const libraryProjects = Array.from(library).filter(item => 
            item.constructor.name === 'Project'
          );
          if (position >= 0 && position < libraryProjects.length) {
            insertionLocation = libraryProjects[position].before;
          } else if (position >= libraryProjects.length) {
            insertionLocation = library.ending;
          } else {
            throw new Error(`Invalid position ${position}. Must be between 0 and ${libraryProjects.length}`);
          }
        } else {
          // Default to end of library
          insertionLocation = library.ending;
        }
      }
      
      // Perform the move using the global moveSections function from Database
      moveSections([project], insertionLocation);
      
      // Invalidate organizational caches
      invalidateOrganizationalCache('project', projectId);
      if (originalFolderId) {
        invalidateOrganizationalCache('folder', originalFolderId);
      }
      if (targetFolderId) {
        invalidateOrganizationalCache('folder', targetFolderId);
      }
      
      const result = {
        projectId: bareId(project.id),
        projectName: project.name,
        originalFolderId: originalFolderId,
        newFolderId: project.parentFolder ? bareId(project.parentFolder.id) : null,
        moved: true,
        taskCount: project.flattenedTasks.length
      };
      
      const processingTime = Date.now() - startTime;
      trackPerformance('moveProject', startTime, false);
      console.log(`[TIMING] moveProject completed in ${processingTime}ms`);
      
      return result;
      
    } catch (error) {
      console.log(`[ERROR] moveProject failed: ${error.message}`);
      throw new Error(`Failed to move project: ${error.message}`);
    }
  };
  
  lib.validateProjectMove = params => {
    const projectId = params.projectId;
    const targetFolderId = params.targetFolderId;
    
    if (!projectId || typeof projectId !== 'string') {
      return { valid: false, error: "Project ID is required and must be a string" };
    }
    
    // Check if project exists
    const project = flattenedProjects.find(p => bareId(p.id) === projectId);
    if (!project) {
      return { valid: false, error: `Project not found: ${projectId}` };
    }
    
    // Check if target folder exists (if specified)
    if (targetFolderId) {
      const targetFolder = flattenedSections.find(f => 
        f.constructor.name === 'Folder' && bareId(f.id) === targetFolderId
      );
      if (!targetFolder) {
        return { valid: false, error: `Target folder not found: ${targetFolderId}` };
      }
      
      // Check if move would be redundant
      if (project.parentFolder && bareId(project.parentFolder.id) === targetFolderId) {
        return { valid: false, error: "Project is already in the target folder" };
      }
    } else {
      // Check if move to library root would be redundant
      if (!project.parentFolder) {
        return { valid: false, error: "Project is already at library root" };
      }
    }
    
    return { 
      valid: true, 
      projectName: project.name,
      currentFolderId: project.parentFolder ? bareId(project.parentFolder.id) : null,
      targetFolderId: targetFolderId || null
    };
  };
  
  lib.getProjectById = params => {
    const projectId = params.projectId;
    
    if (!projectId) {
      throw new Error("projectId parameter is required");
    }
    
    const project = flattenedProjects.find(p => bareId(p.id) === projectId);
    
    if (!project) {
      return null;
    }
    
    return {
      projectId: bareId(project.id),
      projectName: project.name,
      folderId: project.parentFolder ? bareId(project.parentFolder.id) : null,
      folderName: project.parentFolder ? project.parentFolder.name : null,
      status: project.status.name,
      completed: project.completed,
      active: project.effectiveActive,
      sequential: project.sequential,
      completedByChildren: project.completedByChildren,
      taskCount: project.flattenedTasks.length,
      activeTaskCount: Array.from(project.flattenedTasks).filter(t => !t.completed && t.effectiveActive).length,
      completedTaskCount: Array.from(project.flattenedTasks).filter(t => t.completed).length,
      dueDate: toIsoOrNull(project.dueDate),
      deferDate: toIsoOrNull(project.deferDate),
      flagged: project.effectiveFlagged,
      note: project.note || "",
      added: toIsoOrNull(project.added),
      modified: toIsoOrNull(project.modified)
    };
  };
  
  // ===== FOLDER DELETION METHODS (Task 4-3) =====
  
  lib.deleteFolder = params => {
    const startTime = Date.now();
    
    if (!params.folderId || typeof params.folderId !== 'string') {
      throw new Error("Folder ID is required and must be a string");
    }
    
    const folderId = params.folderId;
    const moveProjectsTo = params.moveProjectsTo; // null for library root, or target folder ID
    const confirmDeletion = params.confirmDeletion; // Required explicit confirmation
    
    if (!confirmDeletion) {
      throw new Error("Folder deletion requires explicit confirmation. Set confirmDeletion to true.");
    }
    
    try {
      // Find the folder to delete
      const folder = flattenedSections.find(f => 
        f.constructor.name === 'Folder' && bareId(f.id) === folderId
      );
      
      if (!folder) {
        throw new Error(`Folder not found: ${folderId}`);
      }
      
      // Get all projects in the folder that need to be moved
      const projectsToMove = Array.from(folder.flattenedProjects);
      const originalFolderName = folder.name;
      
      console.log(`[INFO] deleteFolder: Found ${projectsToMove.length} projects in folder "${originalFolderName}"`);
      
      // If there are projects, move them before deletion
      if (projectsToMove.length > 0) {
        let targetInsertionLocation = null;
        
        if (moveProjectsTo) {
          // Move to specified target folder
          const targetFolder = flattenedSections.find(f => 
            f.constructor.name === 'Folder' && bareId(f.id) === moveProjectsTo
          );
          
          if (!targetFolder) {
            throw new Error(`Target folder for projects not found: ${moveProjectsTo}`);
          }
          
          targetInsertionLocation = targetFolder.ending;
          console.log(`[INFO] deleteFolder: Moving projects to folder "${targetFolder.name}"`);
        } else {
          // Move to library root
          targetInsertionLocation = library.ending;
          console.log(`[INFO] deleteFolder: Moving projects to library root`);
        }
        
        // Move all projects to the target location
        moveSections(projectsToMove, targetInsertionLocation);
        
        // Invalidate caches for moved projects
        projectsToMove.forEach(project => {
          invalidateOrganizationalCache('project', bareId(project.id));
        });
      }
      
      // Now delete the empty folder
      deleteObject(folder);
      
      // Invalidate organizational caches
      invalidateOrganizationalCache('folder', folderId);
      invalidateOrganizationalCache('global', null); // Global cache clear for safety
      
      const result = {
        folderId: folderId,
        folderName: originalFolderName,
        deleted: true,
        projectsMoved: projectsToMove.length,
        moveTargetFolderId: moveProjectsTo || null,
        movedProjects: projectsToMove.map(p => ({
          id: bareId(p.id),
          name: p.name
        }))
      };
      
      const processingTime = Date.now() - startTime;
      trackPerformance('deleteFolder', startTime, false);
      console.log(`[TIMING] deleteFolder completed in ${processingTime}ms`);
      
      return result;
      
    } catch (error) {
      console.log(`[ERROR] deleteFolder failed: ${error.message}`);
      throw new Error(`Failed to delete folder: ${error.message}`);
    }
  };
  
  lib.validateFolderDeletion = params => {
    const folderId = params.folderId;
    
    if (!folderId || typeof folderId !== 'string') {
      return { valid: false, error: "Folder ID is required and must be a string" };
    }
    
    // Check if folder exists
    const folder = flattenedSections.find(f => 
      f.constructor.name === 'Folder' && bareId(f.id) === folderId
    );
    
    if (!folder) {
      return { valid: false, error: `Folder not found: ${folderId}` };
    }
    
    const projectsInFolder = Array.from(folder.flattenedProjects);
    const subfolders = Array.from(folder.flattenedFolders);
    
    // Check if target folder exists (if specified)
    const moveProjectsTo = params.moveProjectsTo;
    if (moveProjectsTo) {
      const targetFolder = flattenedSections.find(f => 
        f.constructor.name === 'Folder' && bareId(f.id) === moveProjectsTo
      );
      if (!targetFolder) {
        return { valid: false, error: `Target folder not found: ${moveProjectsTo}` };
      }
      
      // Check for circular dependency
      if (moveProjectsTo === folderId) {
        return { valid: false, error: "Cannot move projects to the folder being deleted" };
      }
    }
    
    return {
      valid: true,
      folderName: folder.name,
      projectCount: projectsInFolder.length,
      subfolderCount: subfolders.length,
      isEmpty: projectsInFolder.length === 0 && subfolders.length === 0,
      projects: projectsInFolder.map(p => ({
        id: bareId(p.id),
        name: p.name
      })),
      subfolders: subfolders.map(f => ({
        id: bareId(f.id),
        name: f.name
      })),
      canDelete: subfolders.length === 0, // Can only delete if no subfolders
      requiresProjectMove: projectsInFolder.length > 0
    };
  };
  
  lib.getFolderProjects = params => {
    const folderId = params.folderId;
    
    if (!folderId) {
      throw new Error("folderId parameter is required");
    }
    
    const folder = flattenedSections.find(f => 
      f.constructor.name === 'Folder' && bareId(f.id) === folderId
    );
    
    if (!folder) {
      throw new Error(`Folder not found: ${folderId}`);
    }
    
    const directProjects = Array.from(folder.projects);
    const allProjects = Array.from(folder.flattenedProjects);
    
    return {
      folderId: bareId(folder.id),
      folderName: folder.name,
      directProjectCount: directProjects.length,
      totalProjectCount: allProjects.length,
      directProjects: directProjects.map(p => ({
        id: bareId(p.id),
        name: p.name,
        status: p.status.name,
        taskCount: p.flattenedTasks.length,
        completed: p.completed
      })),
      allProjects: allProjects.map(p => ({
        id: bareId(p.id),
        name: p.name,
        status: p.status.name,
        taskCount: p.flattenedTasks.length,
        completed: p.completed,
        parentFolderId: p.parentFolder ? bareId(p.parentFolder.id) : null
      }))
    };
  };
  
  // ===== PROJECT CREATION METHODS (Task 4-4) =====
  
  lib.createProject = params => {
    const startTime = Date.now();
    
    if (!params.name || typeof params.name !== 'string' || params.name.trim() === '') {
      throw new Error("Project name is required and must be a non-empty string");
    }
    
    const projectName = params.name.trim();
    const folderId = params.folderId; // null for library root
    const position = params.position; // number for position within target
    const properties = params.properties || {};
    
    try {
      let insertionLocation = null;
      
      // Determine insertion location
      if (folderId) {
        // Create in specific folder
        const targetFolder = flattenedSections.find(f => 
          f.constructor.name === 'Folder' && bareId(f.id) === folderId
        );
        
        if (!targetFolder) {
          throw new Error(`Target folder not found: ${folderId}`);
        }
        
        if (typeof position === 'number') {
          // Position within target folder
          const folderProjects = Array.from(targetFolder.projects);
          if (position >= 0 && position < folderProjects.length) {
            insertionLocation = folderProjects[position].before;
          } else if (position >= folderProjects.length) {
            insertionLocation = targetFolder.ending;
          } else {
            throw new Error(`Invalid position ${position}. Must be between 0 and ${folderProjects.length}`);
          }
        } else {
          // Default to end of target folder
          insertionLocation = targetFolder.ending;
        }
      } else {
        // Create in library root
        if (typeof position === 'number') {
          // Position within library
          const libraryProjects = Array.from(library).filter(item => 
            item.constructor.name === 'Project'
          );
          if (position >= 0 && position < libraryProjects.length) {
            insertionLocation = libraryProjects[position].before;
          } else if (position >= libraryProjects.length) {
            insertionLocation = library.ending;
          } else {
            throw new Error(`Invalid position ${position}. Must be between 0 and ${libraryProjects.length}`);
          }
        } else {
          // Default to end of library
          insertionLocation = library.ending;
        }
      }
      
      // Create the project
      const project = new Project(projectName, insertionLocation);
      
      // Set properties if provided
      if (properties.note) {
        project.note = properties.note;
      }
      
      if (properties.dueDate) {
        try {
          project.dueDate = new Date(properties.dueDate);
        } catch (e) {
          console.log(`[WARNING] Invalid due date format: ${properties.dueDate}`);
        }
      }
      
      if (properties.deferDate) {
        try {
          project.deferDate = new Date(properties.deferDate);
        } catch (e) {
          console.log(`[WARNING] Invalid defer date format: ${properties.deferDate}`);
        }
      }
      
      if (properties.flagged !== undefined) {
        project.flagged = Boolean(properties.flagged);
      }
      
      if (properties.sequential !== undefined) {
        project.sequential = Boolean(properties.sequential);
      }
      
      if (properties.completedByChildren !== undefined) {
        project.completedByChildren = Boolean(properties.completedByChildren);
      }
      
      if (properties.estimatedMinutes !== undefined && typeof properties.estimatedMinutes === 'number') {
        project.estimatedMinutes = properties.estimatedMinutes;
      }
      
      // Handle tags if provided
      if (properties.tagIds && Array.isArray(properties.tagIds)) {
        for (const tagId of properties.tagIds) {
          const tag = flattenedTags.find(t => bareId(t.id) === tagId);
          if (tag) {
            project.addTag(tag);
          } else {
            console.log(`[WARNING] Tag not found: ${tagId}`);
          }
        }
      }
      
      // Invalidate organizational caches
      invalidateOrganizationalCache('project', bareId(project.id));
      if (folderId) {
        invalidateOrganizationalCache('folder', folderId);
      }
      invalidateOrganizationalCache('global', null); // Global cache clear for new project
      
      const result = {
        projectId: bareId(project.id),
        projectName: project.name,
        folderId: project.parentFolder ? bareId(project.parentFolder.id) : null,
        folderName: project.parentFolder ? project.parentFolder.name : null,
        status: project.status.name,
        sequential: project.sequential,
        completedByChildren: project.completedByChildren,
        created: true,
        taskCount: project.flattenedTasks.length,
        flagged: project.flagged,
      dueDate: toIsoOrNull(project.dueDate),
      deferDate: toIsoOrNull(project.deferDate),
        estimatedMinutes: project.estimatedMinutes,
      note: project.note || "",
      tagIds: Array.from(project.tags).map(t => bareId(t.id)),
      added: toIsoOrNull(project.added),
      modified: toIsoOrNull(project.modified)
      };
      
      const processingTime = Date.now() - startTime;
      trackPerformance('createProject', startTime, false);
      console.log(`[TIMING] createProject completed in ${processingTime}ms`);
      
      return result;
      
    } catch (error) {
      console.log(`[ERROR] createProject failed: ${error.message}`);
      throw new Error(`Failed to create project: ${error.message}`);
    }
  };
  
  lib.validateProjectCreation = params => {
    const projectName = params.name;
    const folderId = params.folderId;
    
    if (!projectName || typeof projectName !== 'string' || projectName.trim() === '') {
      return { valid: false, error: "Project name is required and must be a non-empty string" };
    }
    
    // Check if target folder exists (if specified)
    if (folderId) {
      const targetFolder = flattenedSections.find(f => 
        f.constructor.name === 'Folder' && bareId(f.id) === folderId
      );
      if (!targetFolder) {
        return { valid: false, error: `Target folder not found: ${folderId}` };
      }
    }
    
    // Check for duplicate project names
    const trimmedName = projectName.trim();
    const existingProject = flattenedProjects.find(p => p.name === trimmedName);
    if (existingProject) {
      return { 
        valid: false, 
        error: `A project with the name "${trimmedName}" already exists`,
        existingProjectId: bareId(existingProject.id)
      };
    }
    
    // Validate properties if provided
    const properties = params.properties || {};
    const warnings = [];
    
    if (properties.dueDate) {
      try {
        new Date(properties.dueDate);
      } catch (e) {
        warnings.push(`Invalid due date format: ${properties.dueDate}`);
      }
    }
    
    if (properties.deferDate) {
      try {
        new Date(properties.deferDate);
      } catch (e) {
        warnings.push(`Invalid defer date format: ${properties.deferDate}`);
      }
    }
    
    if (properties.tagIds && Array.isArray(properties.tagIds)) {
      const invalidTagIds = [];
      for (const tagId of properties.tagIds) {
        const tag = flattenedTags.find(t => bareId(t.id) === tagId);
        if (!tag) {
          invalidTagIds.push(tagId);
        }
      }
      if (invalidTagIds.length > 0) {
        warnings.push(`Invalid tag IDs: ${invalidTagIds.join(', ')}`);
      }
    }
    
    return { 
      valid: true,
      trimmedName: trimmedName,
      targetFolderId: folderId || null,
      warnings: warnings.length > 0 ? warnings : undefined
    };
  };
  
  lib.setProjectProperties = params => {
    const projectId = params.projectId;
    const properties = params.properties || {};
    
    if (!projectId) {
      throw new Error("projectId parameter is required");
    }
    
    const project = flattenedProjects.find(p => bareId(p.id) === projectId);
    if (!project) {
      throw new Error(`Project not found: ${projectId}`);
    }
    
    const originalProperties = {
      name: project.name,
      note: project.note,
      flagged: project.flagged,
      sequential: project.sequential,
      completedByChildren: project.completedByChildren,
      dueDate: project.dueDate,
      deferDate: project.deferDate,
      estimatedMinutes: project.estimatedMinutes
    };
    
    try {
      // Update properties
      if (properties.name !== undefined) {
        project.name = String(properties.name);
      }
      
      if (properties.note !== undefined) {
        project.note = String(properties.note);
      }
      
      if (properties.flagged !== undefined) {
        project.flagged = Boolean(properties.flagged);
      }
      
      if (properties.sequential !== undefined) {
        project.sequential = Boolean(properties.sequential);
      }
      
      if (properties.completedByChildren !== undefined) {
        project.completedByChildren = Boolean(properties.completedByChildren);
      }
      
      if (properties.dueDate !== undefined) {
        if (properties.dueDate === null) {
          project.dueDate = null;
        } else {
          project.dueDate = new Date(properties.dueDate);
        }
      }
      
      if (properties.deferDate !== undefined) {
        if (properties.deferDate === null) {
          project.deferDate = null;
        } else {
          project.deferDate = new Date(properties.deferDate);
        }
      }
      
      if (properties.estimatedMinutes !== undefined) {
        if (properties.estimatedMinutes === null) {
          project.estimatedMinutes = null;
        } else {
          project.estimatedMinutes = Number(properties.estimatedMinutes);
        }
      }
      
      // Handle tag changes
      if (properties.tagIds !== undefined) {
        // Clear existing tags
        project.clearTags();
        
        // Add new tags
        if (Array.isArray(properties.tagIds)) {
          for (const tagId of properties.tagIds) {
            const tag = flattenedTags.find(t => bareId(t.id) === tagId);
            if (tag) {
              project.addTag(tag);
            }
          }
        }
      }
      
      // Invalidate organizational caches
      invalidateOrganizationalCache('project', projectId);
      if (project.parentFolder) {
        invalidateOrganizationalCache('folder', bareId(project.parentFolder.id));
      }
      
      return {
        projectId: bareId(project.id),
        projectName: project.name,
        updated: true,
        changes: Object.keys(properties),
        currentProperties: {
          name: project.name,
          note: project.note,
          flagged: project.flagged,
          sequential: project.sequential,
          completedByChildren: project.completedByChildren,
        dueDate: toIsoOrNull(project.dueDate),
        deferDate: toIsoOrNull(project.deferDate),
          estimatedMinutes: project.estimatedMinutes,
        tagIds: Array.from(project.tags).map(t => bareId(t.id)),
        added: toIsoOrNull(project.added),
        modified: toIsoOrNull(project.modified)
        }
      };
      
    } catch (error) {
      console.log(`[ERROR] setProjectProperties failed: ${error.message}`);
      throw new Error(`Failed to set project properties: ${error.message}`);
    }
  };
  
  // ===== TASK-TO-PROJECT CONVERSION METHODS (Task 4-5) =====
  
  lib.convertTaskToProject = params => {
    const startTime = Date.now();
    
    if (!params.taskId || typeof params.taskId !== 'string') {
      throw new Error("Task ID is required and must be a string");
    }
    
    const taskId = params.taskId;
    const folderId = params.folderId; // null for library root
    const position = params.position; // number for position within target
    const preserveSubtasks = params.preserveSubtasks !== false; // default to true
    
    try {
      // Find the task to convert
      const task = flattenedTasks.find(t => bareId(t.id) === taskId);
      if (!task) {
        throw new Error(`Task not found: ${taskId}`);
      }
      
      // Store original task information
      const originalTaskInfo = {
        id: bareId(task.id),
        name: task.name,
        note: task.note,
        flagged: task.flagged,
        dueDate: task.dueDate,
        deferDate: task.deferDate,
        estimatedMinutes: task.estimatedMinutes,
        tags: Array.from(task.tags).map(t => bareId(t.id)),
        containingProject: task.containingProject ? bareId(task.containingProject.id) : null,
        subtaskCount: task.children.length
      };
      
      console.log(`[INFO] convertTaskToProject: Converting task "${task.name}" with ${originalTaskInfo.subtaskCount} subtasks`);
      
      let insertionLocation = null;
      
      // Determine insertion location
      if (folderId) {
        // Create in specific folder
        const targetFolder = flattenedSections.find(f => 
          f.constructor.name === 'Folder' && bareId(f.id) === folderId
        );
        
        if (!targetFolder) {
          throw new Error(`Target folder not found: ${folderId}`);
        }
        
        if (typeof position === 'number') {
          // Position within target folder
          const folderProjects = Array.from(targetFolder.projects);
          if (position >= 0 && position < folderProjects.length) {
            insertionLocation = folderProjects[position].before;
          } else if (position >= folderProjects.length) {
            insertionLocation = targetFolder.ending;
          } else {
            throw new Error(`Invalid position ${position}. Must be between 0 and ${folderProjects.length}`);
          }
        } else {
          // Default to end of target folder
          insertionLocation = targetFolder.ending;
        }
      } else {
        // Create in library root
        if (typeof position === 'number') {
          // Position within library
          const libraryProjects = Array.from(library).filter(item => 
            item.constructor.name === 'Project'
          );
          if (position >= 0 && position < libraryProjects.length) {
            insertionLocation = libraryProjects[position].before;
          } else if (position >= libraryProjects.length) {
            insertionLocation = library.ending;
          } else {
            throw new Error(`Invalid position ${position}. Must be between 0 and ${libraryProjects.length}`);
          }
        } else {
          // Default to end of library
          insertionLocation = library.ending;
        }
      }
      
      // Convert the task to project using the global convertTasksToProjects function
      const newProjects = convertTasksToProjects([task], insertionLocation);
      
      if (!newProjects || newProjects.length === 0) {
        throw new Error("Task conversion failed - no project was created");
      }
      
      const newProject = newProjects[0];
      
      // The conversion preserves most properties automatically, but let's verify
      // and ensure tags are preserved (if they weren't automatically)
      if (originalTaskInfo.tags.length > 0) {
        const currentTags = Array.from(newProject.tags).map(t => bareId(t.id));
        const missingTags = originalTaskInfo.tags.filter(tagId => !currentTags.includes(tagId));
        
        // Add any missing tags
        for (const tagId of missingTags) {
          const tag = flattenedTags.find(t => bareId(t.id) === tagId);
          if (tag) {
            newProject.addTag(tag);
            console.log(`[INFO] convertTaskToProject: Added missing tag "${tag.name}" to project`);
          }
        }
      }
      
      // Invalidate organizational caches
      invalidateOrganizationalCache('project', bareId(newProject.id));
      if (originalTaskInfo.containingProject) {
        invalidateOrganizationalCache('project', originalTaskInfo.containingProject);
      }
      if (folderId) {
        invalidateOrganizationalCache('folder', folderId);
      }
      invalidateOrganizationalCache('global', null); // Global cache clear for conversion
      
      const result = {
        projectId: bareId(newProject.id),
        projectName: newProject.name,
        folderId: newProject.parentFolder ? bareId(newProject.parentFolder.id) : null,
        folderName: newProject.parentFolder ? newProject.parentFolder.name : null,
        converted: true,
        originalTaskInfo: originalTaskInfo,
        preservedSubtasks: preserveSubtasks,
        taskCount: newProject.flattenedTasks.length,
        status: newProject.status.name,
        flagged: newProject.flagged,
      dueDate: toIsoOrNull(newProject.dueDate),
      deferDate: toIsoOrNull(newProject.deferDate),
        estimatedMinutes: newProject.estimatedMinutes,
      note: newProject.note || "",
      tagIds: Array.from(newProject.tags).map(t => bareId(t.id)),
      added: toIsoOrNull(newProject.added),
      modified: toIsoOrNull(newProject.modified)
      };
      
      const processingTime = Date.now() - startTime;
      trackPerformance('convertTaskToProject', startTime, false);
      console.log(`[TIMING] convertTaskToProject completed in ${processingTime}ms`);
      
      return result;
      
    } catch (error) {
      console.log(`[ERROR] convertTaskToProject failed: ${error.message}`);
      throw new Error(`Failed to convert task to project: ${error.message}`);
    }
  };
  
  lib.validateTaskConversion = params => {
    const taskId = params.taskId;
    const folderId = params.folderId;
    
    if (!taskId || typeof taskId !== 'string') {
      return { valid: false, error: "Task ID is required and must be a string" };
    }
    
    // Check if task exists
    const task = flattenedTasks.find(t => bareId(t.id) === taskId);
    if (!task) {
      return { valid: false, error: `Task not found: ${taskId}` };
    }
    
    // Check if task is already a project root task
    if (task.containingProject && task.containingProject.task === task) {
      return { valid: false, error: "Task is already a project root task and cannot be converted" };
    }
    
    // Check if target folder exists (if specified)
    if (folderId) {
      const targetFolder = flattenedSections.find(f => 
        f.constructor.name === 'Folder' && bareId(f.id) === folderId
      );
      if (!targetFolder) {
        return { valid: false, error: `Target folder not found: ${folderId}` };
      }
    }
    
    // Check for potential name conflicts
    const projectName = task.name;
    const existingProject = flattenedProjects.find(p => p.name === projectName);
    const warnings = [];
    
    if (existingProject) {
      warnings.push(`A project with the name "${projectName}" already exists`);
    }
    
    // Gather information about the task
    const subtasks = Array.from(task.children);
    const hasComplexRelationships = task.parent !== null || task.dependsOn.length > 0 || task.dependedUponBy.length > 0;
    
    return {
      valid: true,
      taskName: task.name,
      subtaskCount: subtasks.length,
      hasSubtasks: subtasks.length > 0,
      hasComplexRelationships: hasComplexRelationships,
      currentProjectId: task.containingProject ? bareId(task.containingProject.id) : null,
      targetFolderId: folderId || null,
      warnings: warnings.length > 0 ? warnings : undefined,
      taskInfo: {
        id: bareId(task.id),
        name: task.name,
        note: task.note || "",
        flagged: task.flagged,
        completed: task.completed,
        dueDate: task.dueDate ? task.dueDate.toISOString() : null,
        deferDate: task.deferDate ? task.deferDate.toISOString() : null,
        estimatedMinutes: task.estimatedMinutes,
        tagCount: task.tags.length,
        parentTaskId: task.parent ? bareId(task.parent.id) : null
      }
    };
  };
  
  lib.getTaskSubtasks = params => {
    const taskId = params.taskId;
    
    if (!taskId) {
      throw new Error("taskId parameter is required");
    }
    
    const task = flattenedTasks.find(t => bareId(t.id) === taskId);
    if (!task) {
      throw new Error(`Task not found: ${taskId}`);
    }
    
    const directSubtasks = Array.from(task.children);
    const allSubtasks = Array.from(task.flattenedChildren);
    
    return {
      taskId: bareId(task.id),
      taskName: task.name,
      directSubtaskCount: directSubtasks.length,
      totalSubtaskCount: allSubtasks.length,
      directSubtasks: directSubtasks.map(subtask => ({
        id: bareId(subtask.id),
        name: subtask.name,
        completed: subtask.completed,
        flagged: subtask.flagged,
        hasSubtasks: subtask.children.length > 0,
        dueDate: subtask.dueDate ? subtask.dueDate.toISOString() : null,
        note: subtask.note || ""
      })),
      allSubtasks: allSubtasks.map(subtask => ({
        id: bareId(subtask.id),
        name: subtask.name,
        completed: subtask.completed,
        flagged: subtask.flagged,
        parentTaskId: subtask.parent ? bareId(subtask.parent.id) : null,
                    depth: subtask.parent === task ? 1 : calculateTaskDepth(subtask) - calculateTaskDepth(task),
        dueDate: subtask.dueDate ? subtask.dueDate.toISOString() : null,
        note: subtask.note || ""
      }))
    };
  };
  
  // ===== TASK MOVEMENT METHODS (Task 4-6) =====
  
  lib.moveTask = params => {
    const startTime = Date.now();
    
    if (!params.taskId || typeof params.taskId !== 'string') {
      throw new Error("Task ID is required and must be a string");
    }
    
    const taskId = params.taskId;
    const targetProjectId = params.targetProjectId; // null for inbox
    const parentTaskId = params.parentTaskId; // null for project root level
    const position = params.position; // number for position within target
    const includeSubtasks = params.includeSubtasks !== false; // default to true
    
    try {
      // Find the task to move
      const task = flattenedTasks.find(t => bareId(t.id) === taskId);
      if (!task) {
        throw new Error(`Task not found: ${taskId}`);
      }
      
      // Store original task information
      const originalTaskInfo = {
        id: bareId(task.id),
        name: task.name,
        containingProject: task.containingProject ? bareId(task.containingProject.id) : null,
        parentTask: task.parent ? bareId(task.parent.id) : null,
        position: task.parent ? Array.from(task.parent.children).indexOf(task) : 
                  task.containingProject ? Array.from(task.containingProject.tasks).indexOf(task) : -1,
        subtaskCount: task.children.length
      };
      
      console.log(`[INFO] moveTask: Moving task "${task.name}" from ${originalTaskInfo.containingProject || 'inbox'} to ${targetProjectId || 'inbox'}`);
      console.log(`[INFO] moveTask: Task has ${task.children.length} direct children, includeSubtasks=${includeSubtasks}`);
      
      // Store original task group properties if it has children
      let originalGroupType = null;
      if (task.children.length > 0) {
        try {
          originalGroupType = task.sequential;
          console.log(`[INFO] moveTask: Original task group type: ${originalGroupType ? 'sequential' : 'parallel'}`);
        } catch (e) {
          console.log(`[INFO] moveTask: Could not determine original group type: ${e.message}`);
        }
      }
      
      let insertionLocation = null;
      
      // Determine target insertion location
      if (targetProjectId) {
        // Move to specific project
        const targetProject = flattenedProjects.find(p => bareId(p.id) === targetProjectId);
        if (!targetProject) {
          throw new Error(`Target project not found: ${targetProjectId}`);
        }
        
        if (parentTaskId) {
          // Move as subtask of specific parent task
          const parentTask = flattenedTasks.find(t => bareId(t.id) === parentTaskId);
          if (!parentTask) {
            throw new Error(`Parent task not found: ${parentTaskId}`);
          }
          
          // Verify parent task is in target project
          if (parentTask.containingProject !== targetProject) {
            throw new Error(`Parent task is not in target project`);
          }
          
          if (typeof position === 'number') {
            // Position within parent task's children
            const siblings = Array.from(parentTask.children);
            if (position >= 0 && position < siblings.length) {
              insertionLocation = siblings[position].before;
            } else if (position >= siblings.length) {
              insertionLocation = parentTask.ending;
            } else {
              throw new Error(`Invalid position ${position}. Must be between 0 and ${siblings.length}`);
            }
          } else {
            // Default to end of parent task
            insertionLocation = parentTask.ending;
          }
        } else {
          // Move to project root level
          if (typeof position === 'number') {
            // Position within project's root tasks
            const projectTasks = Array.from(targetProject.tasks);
            if (position >= 0 && position < projectTasks.length) {
              insertionLocation = projectTasks[position].before;
            } else if (position >= projectTasks.length) {
              insertionLocation = targetProject.ending;
            } else {
              throw new Error(`Invalid position ${position}. Must be between 0 and ${projectTasks.length}`);
            }
          } else {
            // Default to end of project
            insertionLocation = targetProject.ending;
          }
        }
      } else {
        // Move to inbox
        if (typeof position === 'number') {
          // Position within inbox
          const inboxTasks = Array.from(inbox);
          if (position >= 0 && position < inboxTasks.length) {
            insertionLocation = inboxTasks[position].before;
          } else if (position >= inboxTasks.length) {
            insertionLocation = inbox.ending;
          } else {
            throw new Error(`Invalid position ${position}. Must be between 0 and ${inboxTasks.length}`);
          }
        } else {
          // Default to end of inbox
          insertionLocation = inbox.ending;
        }
      }
      
      // Handle task movement with proper hierarchy preservation
      if (includeSubtasks || task.children.length === 0) {
        // Move the parent task only - children will automatically follow and maintain hierarchy
        moveTasks([task], insertionLocation);
      } else {
        // includeSubtasks is false and task has children
        // We need to handle the children first before moving the parent
        const children = Array.from(task.children);
        
        if (children.length > 0) {
          // Move children to the target location first (they'll become siblings of the parent)
          moveTasks(children, insertionLocation);
        }
        
        // Then move the parent task
        moveTasks([task], insertionLocation);
      }
      
      // Invalidate organizational caches
      invalidateOrganizationalCache('task', taskId);
      if (originalTaskInfo.containingProject) {
        invalidateOrganizationalCache('project', originalTaskInfo.containingProject);
      }
      if (targetProjectId) {
        invalidateOrganizationalCache('project', targetProjectId);
      }
      invalidateOrganizationalCache('global', null); // Global cache clear for task move
      
      // Get updated task information
      const updatedTask = flattenedTasks.find(t => bareId(t.id) === taskId);
      
      // Restore task group type if it had children and we preserved the hierarchy
      if (originalGroupType !== null && includeSubtasks && updatedTask.children.length > 0) {
        try {
          updatedTask.sequential = originalGroupType;
          console.log(`[INFO] moveTask: Restored task group type to ${originalGroupType ? 'sequential' : 'parallel'}`);
        } catch (e) {
          console.log(`[WARNING] moveTask: Could not restore task group type: ${e.message}`);
        }
      }
      
      const result = {
        taskId: bareId(updatedTask.id),
        taskName: updatedTask.name,
        moved: true,
        originalLocation: originalTaskInfo,
        newLocation: {
          containingProject: updatedTask.containingProject ? bareId(updatedTask.containingProject.id) : null,
          projectName: updatedTask.containingProject ? updatedTask.containingProject.name : null,
          parentTask: updatedTask.parent ? bareId(updatedTask.parent.id) : null,
          parentTaskName: updatedTask.parent ? updatedTask.parent.name : null,
          position: updatedTask.parent ? Array.from(updatedTask.parent.children).indexOf(updatedTask) : 
                    updatedTask.containingProject ? Array.from(updatedTask.containingProject.tasks).indexOf(updatedTask) : -1
        },
        tasksMovedCount: includeSubtasks ? 1 + task.flattenedChildren.length : 1,
        includeSubtasks: includeSubtasks,
        preservedRelationships: true
      };
      
      const processingTime = Date.now() - startTime;
      trackPerformance('moveTask', startTime, false);
      console.log(`[TIMING] moveTask completed in ${processingTime}ms`);
      
      return result;
      
    } catch (error) {
      console.log(`[ERROR] moveTask failed: ${error.message}`);
      throw new Error(`Failed to move task: ${error.message}`);
    }
  };
  
  lib.validateTaskMove = params => {
    const taskId = params.taskId;
    const targetProjectId = params.targetProjectId;
    const parentTaskId = params.parentTaskId;
    
    if (!taskId || typeof taskId !== 'string') {
      return { valid: false, error: "Task ID is required and must be a string" };
    }
    
    // Check if task exists
    const task = flattenedTasks.find(t => bareId(t.id) === taskId);
    if (!task) {
      return { valid: false, error: `Task not found: ${taskId}` };
    }
    
    // Check if target project exists (if specified)
    if (targetProjectId) {
      const targetProject = flattenedProjects.find(p => bareId(p.id) === targetProjectId);
      if (!targetProject) {
        return { valid: false, error: `Target project not found: ${targetProjectId}` };
      }
      
      // Check if parent task exists and is in target project (if specified)
      if (parentTaskId) {
        const parentTask = flattenedTasks.find(t => bareId(t.id) === parentTaskId);
        if (!parentTask) {
          return { valid: false, error: `Parent task not found: ${parentTaskId}` };
        }
        
        if (parentTask.containingProject !== targetProject) {
          return { valid: false, error: "Parent task is not in target project" };
        }
        
        // Check for circular relationships (task cannot be moved under its own descendant)
        if (Array.from(task.flattenedChildren).some(child => bareId(child.id) === parentTaskId)) {
          return { valid: false, error: "Cannot move task under its own descendant - would create circular relationship" };
        }
      }
    }
    
    // Check if move would be redundant
    const currentProject = task.containingProject ? bareId(task.containingProject.id) : null;
    const currentParent = task.parent ? bareId(task.parent.id) : null;
    
    if (currentProject === targetProjectId && currentParent === parentTaskId) {
      return { valid: false, error: "Task is already in the target location" };
    }
    
    // Gather information about potential impact
    const warnings = [];
    const subtaskCount = task.children.length;
    
    if (subtaskCount > 0) {
      warnings.push(`Task has ${subtaskCount} subtask(s) that will also be moved`);
    }
    
    const dependencies = task.dependsOn.length + task.dependedUponBy.length;
    if (dependencies > 0) {
      warnings.push(`Task has ${dependencies} dependency relationship(s) that will be preserved`);
    }
    
    return {
      valid: true,
      taskName: task.name,
      currentLocation: {
        projectId: currentProject,
        projectName: task.containingProject ? task.containingProject.name : "Inbox",
        parentTaskId: currentParent,
        parentTaskName: task.parent ? task.parent.name : null
      },
      targetLocation: {
        projectId: targetProjectId || null,
        projectName: targetProjectId ? 
          flattenedProjects.find(p => bareId(p.id) === targetProjectId).name : "Inbox",
        parentTaskId: parentTaskId || null,
        parentTaskName: parentTaskId ? 
          flattenedTasks.find(t => bareId(t.id) === parentTaskId).name : null
      },
      subtaskCount: subtaskCount,
      dependencyCount: dependencies,
      warnings: warnings.length > 0 ? warnings : undefined
    };
  };
  
  lib.getTaskRelationships = params => {
    const taskId = params.taskId;
    
    if (!taskId) {
      throw new Error("taskId parameter is required");
    }
    
    const task = flattenedTasks.find(t => bareId(t.id) === taskId);
    if (!task) {
      throw new Error(`Task not found: ${taskId}`);
    }
    
    const directChildren = Array.from(task.children);
    const allDescendants = Array.from(task.flattenedChildren);
    const dependencies = Array.from(task.dependsOn);
    const dependents = Array.from(task.dependedUponBy);
    
    return {
      taskId: bareId(task.id),
      taskName: task.name,
      containingProject: task.containingProject ? {
        id: bareId(task.containingProject.id),
        name: task.containingProject.name
      } : null,
      parentTask: task.parent ? {
        id: bareId(task.parent.id),
        name: task.parent.name
      } : null,
      directChildren: directChildren.map(child => ({
        id: bareId(child.id),
        name: child.name,
        completed: child.completed
      })),
      allDescendants: allDescendants.map(descendant => ({
        id: bareId(descendant.id),
        name: descendant.name,
        completed: descendant.completed,
                    depth: calculateTaskDepth(descendant) - calculateTaskDepth(task)
      })),
      dependencies: dependencies.map(dep => ({
        id: bareId(dep.id),
        name: dep.name,
        completed: dep.completed,
        containingProject: dep.containingProject ? dep.containingProject.name : "Inbox"
      })),
      dependents: dependents.map(dependent => ({
        id: bareId(dependent.id),
        name: dependent.name,
        completed: dependent.completed,
        containingProject: dependent.containingProject ? dependent.containingProject.name : "Inbox"
      })),
      relationshipCounts: {
        directChildren: directChildren.length,
        allDescendants: allDescendants.length,
        dependencies: dependencies.length,
        dependents: dependents.length
      }
    };
  };

  lib.createSubtask = params => {
    const startTime = Date.now();
    const parentTaskId = params.parentTaskId;
    const name = params.name;
    const properties = params.properties || {};
    const position = params.position || null;
    const siblingTaskId = params.siblingTaskId || null;
    
    if (!parentTaskId) {
      throw new Error("parentTaskId parameter is required");
    }
    
    if (!name || typeof name !== 'string' || name.trim().length === 0) {
      throw new Error("name parameter is required and must be a non-empty string");
    }
    
    try {
      const parentTask = flattenedTasks.find(t => bareId(t.id) === parentTaskId);
      if (!parentTask) {
        throw new Error(`Parent task not found: ${parentTaskId}`);
      }

      // Check if parent task is completed or dropped
      if (parentTask.completed) {
        throw new Error("Cannot create subtask under completed parent task");
      }
      
      if (parentTask.dropDate) {
        throw new Error("Cannot create subtask under dropped parent task");
      }

      // Determine insertion location
      let insertLocation = parentTask; // Default: end of parent's children
      
      if (position) {
        switch (position) {
          case "beginning":
            insertLocation = parentTask.beginning;
            break;
          case "ending":
            insertLocation = parentTask.ending;
            break;
          case "before":
            if (siblingTaskId) {
              const siblingTask = flattenedTasks.find(t => bareId(t.id) === siblingTaskId);
              if (siblingTask && siblingTask.parent === parentTask) {
                insertLocation = siblingTask.before;
              } else {
                throw new Error("Sibling task not found or not a child of parent");
              }
            } else {
              throw new Error("Sibling task ID required for 'before' position");
            }
            break;
          case "after":
            if (siblingTaskId) {
              const siblingTask = flattenedTasks.find(t => bareId(t.id) === siblingTaskId);
              if (siblingTask && siblingTask.parent === parentTask) {
                insertLocation = siblingTask.after;
              } else {
                throw new Error("Sibling task not found or not a child of parent");
              }
            } else {
              throw new Error("Sibling task ID required for 'after' position");
            }
            break;
          default:
            throw new Error("Invalid position. Use 'beginning', 'ending', 'before', or 'after'");
        }
      }

      // Create the subtask
      const subtask = new Task(name.trim(), insertLocation);

      // Set properties if provided
      if (properties.note) subtask.note = properties.note;
      if (properties.dueDate) subtask.dueDate = new Date(properties.dueDate);
      if (properties.deferDate) subtask.deferDate = new Date(properties.deferDate);
      if (properties.estimatedMinutes !== undefined) subtask.estimatedMinutes = properties.estimatedMinutes;
      if (properties.flagged !== undefined) subtask.flagged = properties.flagged;
      if (properties.completedByChildren !== undefined) subtask.completedByChildren = properties.completedByChildren;

      // Add tags if provided
      if (properties.tagNames && Array.isArray(properties.tagNames)) {
        for (const tagName of properties.tagNames) {
          const tag = flattenedTags.find(t => t.name === tagName);
          if (tag) {
            subtask.addTag(tag);
          }
        }
      }

      // Invalidate caches
      invalidateOrganizationalCache('global', null);
      
      const processingTime = Date.now() - startTime;
      trackPerformance('createSubtask', startTime, false);
      console.log(`[TIMING] createSubtask completed in ${processingTime}ms`);

      return {
        success: true,
        task: {
          id: bareId(subtask.id),
          name: subtask.name,
          note: subtask.note,
          completed: subtask.completed,
          flagged: subtask.flagged,
          dueDate: subtask.dueDate ? subtask.dueDate.toISOString() : null,
          deferDate: subtask.deferDate ? subtask.deferDate.toISOString() : null,
          estimatedMinutes: subtask.estimatedMinutes,
          completedByChildren: subtask.completedByChildren,
          parentTaskId: bareId(parentTask.id),
          parentTaskName: parentTask.name,
          containingProject: subtask.containingProject ? {
            id: bareId(subtask.containingProject.id),
            name: subtask.containingProject.name
          } : null,
          tags: Array.from(subtask.tags).map(tag => ({
            id: bareId(tag.id),
            name: tag.name
          }))
        }
      };
    } catch (error) {
      console.log(`[ERROR] createSubtask failed: ${error.message}`);
      throw new Error(`Failed to create subtask: ${error.message}`);
    }
  };

  lib.getTaskHierarchy = params => {
    const startTime = Date.now();
    const taskId = params.taskId;
    const maxDepth = params.maxDepth || 10;
    
    if (!taskId) {
      throw new Error("taskId parameter is required");
    }
    
    try {
      const task = flattenedTasks.find(t => bareId(t.id) === taskId);
      if (!task) {
        throw new Error(`Task not found: ${taskId}`);
      }

      const buildHierarchy = (currentTask, depth) => {
        if (depth >= maxDepth) {
          return { 
            id: bareId(currentTask.id),
            name: currentTask.name,
            completed: currentTask.completed,
            flagged: currentTask.flagged,
            children: [], 
            maxDepthReached: true 
          };
        }

        const children = [];
        for (const childTask of currentTask.children) {
          children.push(buildHierarchy(childTask, depth + 1));
        }

        return {
          id: bareId(currentTask.id),
          name: currentTask.name,
          note: currentTask.note,
          completed: currentTask.completed,
          flagged: currentTask.flagged,
          dueDate: currentTask.dueDate ? currentTask.dueDate.toISOString() : null,
          deferDate: currentTask.deferDate ? currentTask.deferDate.toISOString() : null,
          estimatedMinutes: currentTask.estimatedMinutes,
          completedByChildren: currentTask.completedByChildren,
          children: children,
          hasChildren: children.length > 0,
          depth: depth,
          parentTaskId: currentTask.parent ? bareId(currentTask.parent.id) : null,
          containingProject: currentTask.containingProject ? {
            id: bareId(currentTask.containingProject.id),
            name: currentTask.containingProject.name
          } : null,
          tags: Array.from(currentTask.tags).map(tag => ({
            id: bareId(tag.id),
            name: tag.name
          }))
        };
      };

      const result = buildHierarchy(task, 0);
      
      const processingTime = Date.now() - startTime;
      trackPerformance('getTaskHierarchy', startTime, false);
      console.log(`[TIMING] getTaskHierarchy completed in ${processingTime}ms`);

      return {
        success: true,
        hierarchy: result
      };
    } catch (error) {
      console.log(`[ERROR] getTaskHierarchy failed: ${error.message}`);
      throw new Error(`Failed to get task hierarchy: ${error.message}`);
    }
  };

  lib.createSubtaskHierarchy = params => {
    const startTime = Date.now();
    const parentTaskId = params.parentTaskId;
    const subtaskSpecs = params.subtaskSpecs || [];
    
    if (!parentTaskId) {
      throw new Error("parentTaskId parameter is required");
    }
    
    if (!Array.isArray(subtaskSpecs) || subtaskSpecs.length === 0) {
      throw new Error("subtaskSpecs parameter is required and must be a non-empty array");
    }
    
    try {
      const parentTask = flattenedTasks.find(t => bareId(t.id) === parentTaskId);
      if (!parentTask) {
        throw new Error(`Parent task not found: ${parentTaskId}`);
      }

      if (parentTask.completed) {
        throw new Error("Cannot create subtasks under completed parent task");
      }
      
      if (parentTask.dropDate) {
        throw new Error("Cannot create subtasks under dropped parent task");
      }

      const results = [];
      const createdTasks = new Map(); // Track created tasks by name for parent references

      for (const spec of subtaskSpecs) {
        try {
          const { name, properties = {}, position = null, siblingTaskId = null, parentName = null } = spec;
          
          if (!name || typeof name !== 'string' || name.trim().length === 0) {
            results.push({
              name: name || "unnamed",
              success: false,
              error: "Subtask name is required and must be a non-empty string"
            });
            continue;
          }

          // Determine the actual parent for this subtask
          let actualParentTaskId = parentTaskId;
          if (parentName && createdTasks.has(parentName)) {
            actualParentTaskId = bareId(createdTasks.get(parentName).id);
          }

          // Create the subtask using the existing createSubtask method
          const createResult = lib.createSubtask({
            parentTaskId: actualParentTaskId,
            name: name,
            properties: properties,
            position: position,
            siblingTaskId: siblingTaskId
          });

          if (createResult.success) {
            // Store the created task for potential use as parent
            const createdTask = flattenedTasks.find(t => bareId(t.id) === createResult.task.id);
            if (createdTask) {
              createdTasks.set(name, createdTask);
            }
          }

          results.push({
            name: name,
            success: createResult.success,
            task: createResult.task || null,
            error: createResult.error || null
          });
        } catch (specError) {
          results.push({
            name: spec.name || "unnamed",
            success: false,
            error: specError.message
          });
        }
      }

      // Invalidate caches after all creations
      invalidateOrganizationalCache('global', null);
      
      const processingTime = Date.now() - startTime;
      trackPerformance('createSubtaskHierarchy', startTime, false);
      console.log(`[TIMING] createSubtaskHierarchy completed in ${processingTime}ms`);

      return {
        success: true,
        results: results,
        totalCreated: results.filter(r => r.success).length,
        totalRequested: subtaskSpecs.length
      };
    } catch (error) {
      console.log(`[ERROR] createSubtaskHierarchy failed: ${error.message}`);
      throw new Error(`Failed to create subtask hierarchy: ${error.message}`);
    }
  };

  lib.validateSubtaskCreation = params => {
    const parentTaskId = params.parentTaskId;
    const properties = params.properties || {};
    
    if (!parentTaskId) {
      return { valid: false, error: "parentTaskId parameter is required" };
    }
    
    try {
      const parentTask = flattenedTasks.find(t => bareId(t.id) === parentTaskId);
      if (!parentTask) {
        return { valid: false, error: `Parent task not found: ${parentTaskId}` };
      }

      // Check if parent task is completed
      if (parentTask.completed) {
        return { valid: false, error: "Cannot create subtask under completed task" };
      }

      // Check if parent task is dropped
      if (parentTask.dropDate) {
        return { valid: false, error: "Cannot create subtask under dropped task" };
      }

      // Validate tag names if provided
      if (properties.tagNames && Array.isArray(properties.tagNames)) {
        for (const tagName of properties.tagNames) {
          const tag = flattenedTags.find(t => t.name === tagName);
          if (!tag) {
            return { valid: false, error: `Tag '${tagName}' not found` };
          }
        }
      }

      // Validate dates if provided
      if (properties.dueDate) {
        try {
          new Date(properties.dueDate);
        } catch (e) {
          return { valid: false, error: "Invalid due date format" };
        }
      }

      if (properties.deferDate) {
        try {
          new Date(properties.deferDate);
        } catch (e) {
          return { valid: false, error: "Invalid defer date format" };
        }
      }

      return { 
        valid: true,
        parentTask: {
          id: bareId(parentTask.id),
          name: parentTask.name,
          completed: parentTask.completed,
          hasChildren: parentTask.children.length > 0,
          childCount: parentTask.children.length,
          containingProject: parentTask.containingProject ? {
            id: bareId(parentTask.containingProject.id),
            name: parentTask.containingProject.name
          } : null
        }
      };
    } catch (error) {
      return { valid: false, error: error.message };
    }
  };

  lib.flattenTaskHierarchy = params => {
    const startTime = Date.now();
    const rootTaskId = params.rootTaskId;
    const preserveOrder = params.preserveOrder !== undefined ? params.preserveOrder : true;
    const targetProjectId = params.targetProjectId || null;
    const removeFromParent = params.removeFromParent !== undefined ? params.removeFromParent : false;
    const flattenTo = params.flattenTo || 'directChildren'; // 'directChildren' or 'parentLevel'
    
    if (!rootTaskId) {
      throw new Error("rootTaskId parameter is required");
    }
    
    try {
      const rootTask = flattenedTasks.find(t => bareId(t.id) === rootTaskId);
      if (!rootTask) {
        throw new Error(`Root task not found: ${rootTaskId}`);
      }

      // Collect all descendant tasks in order
      const allDescendants = [];
      const gatherDescendants = (task, depth = 0) => {
        if (depth > 0) { // Skip the root task itself
          allDescendants.push({
            task: task,
            originalDepth: depth,
            originalParent: task.parent ? bareId(task.parent.id) : null
          });
        }
        for (const child of task.children) {
          gatherDescendants(child, depth + 1);
        }
      };

      gatherDescendants(rootTask);

      if (allDescendants.length === 0) {
        return {
          success: true,
          message: "No child tasks to flatten",
          tasksFlattened: 0,
          rootTask: {
            id: bareId(rootTask.id),
            name: rootTask.name
          }
        };
      }

      // Validate target project if specified
      let targetProject = null;
      if (targetProjectId) {
        targetProject = flattenedProjects.find(p => bareId(p.id) === targetProjectId);
        if (!targetProject) {
          throw new Error(`Target project not found: ${targetProjectId}`);
        }
      }

      const movedTasks = [];
      const errors = [];

      // Move all descendant tasks based on flattenTo mode:
      // - 'directChildren': Make all descendants direct children of root task
      // - 'parentLevel': Move all descendants to same level as root task
      for (const descendantInfo of allDescendants) {
        try {
          const task = descendantInfo.task;
          const originalLocation = {
            parentTaskId: descendantInfo.originalParent,
            containingProject: task.containingProject ? bareId(task.containingProject.id) : null
          };

          // Determine insertion location based on flattening mode
          let insertionLocation;
          if (targetProject) {
            // Move to specific project at root level
            insertionLocation = targetProject.ending;
          } else if (flattenTo === 'directChildren') {
            // Move to become direct child of root task
            insertionLocation = rootTask.ending;
          } else if (flattenTo === 'parentLevel') {
            // Move to same level as root task (project level or parent task level)
            if (rootTask.parent) {
              // Root task has a parent, move to same level (siblings)
              insertionLocation = rootTask.parent.ending;
            } else if (rootTask.containingProject) {
              // Root task is at project level, move to project level
              insertionLocation = rootTask.containingProject.ending;
            } else {
              // Root task is in inbox, move to inbox
              insertionLocation = document.inbox.ending;
            }
          } else {
            throw new Error(`Invalid flattenTo value: ${flattenTo}. Use 'directChildren' or 'parentLevel'`);
          }
          
          // Move the task using correct API
          moveTasks([task], insertionLocation);

          movedTasks.push({
            id: bareId(task.id),
            name: task.name,
            originalDepth: descendantInfo.originalDepth,
            originalLocation: originalLocation,
            newLocation: {
              containingProject: task.containingProject ? bareId(task.containingProject.id) : null,
              parentTaskId: task.parent ? bareId(task.parent.id) : null
            }
          });
        } catch (error) {
          errors.push({
            taskId: bareId(descendantInfo.task.id),
            taskName: descendantInfo.task.name,
            error: error.message
          });
        }
      }

      // Invalidate caches
      invalidateOrganizationalCache('global', null);
      
      const processingTime = Date.now() - startTime;
      trackPerformance('flattenTaskHierarchy', startTime, false);
      console.log(`[TIMING] flattenTaskHierarchy completed in ${processingTime}ms`);

      return {
        success: true,
        tasksFlattened: movedTasks.length,
        rootTask: {
          id: bareId(rootTask.id),
          name: rootTask.name,
          remainingChildren: rootTask.children.length
        },
        targetLocation: {
          type: targetProject ? 'project' : 
                (flattenTo === 'directChildren' ? 'task' : 
                 (rootTask.parent ? 'task' : 
                  (rootTask.containingProject ? 'project' : 'inbox'))),
          id: targetProject ? bareId(targetProject.id) :
              (flattenTo === 'directChildren' ? bareId(rootTask.id) :
               (rootTask.parent ? bareId(rootTask.parent.id) :
                (rootTask.containingProject ? bareId(rootTask.containingProject.id) : null))),
          name: targetProject ? targetProject.name :
                (flattenTo === 'directChildren' ? rootTask.name :
                 (rootTask.parent ? rootTask.parent.name :
                  (rootTask.containingProject ? rootTask.containingProject.name : 'Inbox'))),
          flattenMode: flattenTo
        },
        movedTasks: movedTasks,
        errors: errors.length > 0 ? errors : undefined,
        preservedOrder: preserveOrder
      };
    } catch (error) {
      console.log(`[ERROR] flattenTaskHierarchy failed: ${error.message}`);
      throw new Error(`Failed to flatten task hierarchy: ${error.message}`);
    }
  };

  lib.moveTaskBranch = params => {
    const startTime = Date.now();
    const taskId = params.taskId;
    const newParentId = params.newParentId;
    const position = params.position || 'ending';
    const siblingTaskId = params.siblingTaskId || null;
    
    if (!taskId) {
      throw new Error("taskId parameter is required");
    }
    
    try {
      const task = flattenedTasks.find(t => bareId(t.id) === taskId);
      if (!task) {
        throw new Error(`Task not found: ${taskId}`);
      }

      // Collect all tasks in the branch (task + all descendants)
      const branchTasks = [task];
      const gatherBranch = (currentTask) => {
        for (const child of currentTask.children) {
          branchTasks.push(child);
          gatherBranch(child);
        }
      };
      gatherBranch(task);

      // Validate new parent if specified
      let newParent = null;
      if (newParentId) {
        newParent = flattenedTasks.find(t => bareId(t.id) === newParentId);
        if (!newParent) {
          throw new Error(`New parent task not found: ${newParentId}`);
        }

        // Check for circular dependency
        if (branchTasks.some(branchTask => bareId(branchTask.id) === newParentId)) {
          throw new Error("Cannot move task branch under one of its own descendants - would create circular dependency");
        }

        // Check if new parent is completed or dropped
        if (newParent.completed) {
          throw new Error("Cannot move task branch under completed parent");
        }
        if (newParent.dropDate) {
          throw new Error("Cannot move task branch under dropped parent");
        }
      }

      // Store original location info
      const originalLocation = {
        parentTaskId: task.parent ? bareId(task.parent.id) : null,
        parentTaskName: task.parent ? task.parent.name : null,
        containingProject: task.containingProject ? bareId(task.containingProject.id) : null,
        projectName: task.containingProject ? task.containingProject.name : null,
        position: task.parent ? Array.from(task.parent.children).indexOf(task) : 
                 (task.containingProject ? Array.from(task.containingProject.tasks).indexOf(task) : -1)
      };

      // Determine insertion location
      let insertionLocation;
      if (newParent) {
        // Moving to a specific parent task with position control
        switch (position) {
          case "beginning":
            insertionLocation = newParent.beginning;
            break;
          case "ending":
            insertionLocation = newParent.ending;
            break;
          case "before":
            if (siblingTaskId) {
              const siblingTask = flattenedTasks.find(t => bareId(t.id) === siblingTaskId);
              if (siblingTask && siblingTask.parent === newParent) {
                insertionLocation = siblingTask.before;
              } else {
                throw new Error("Sibling task not found or not a child of new parent");
              }
            } else {
              throw new Error("Sibling task ID required for 'before' position");
            }
            break;
          case "after":
            if (siblingTaskId) {
              const siblingTask = flattenedTasks.find(t => bareId(t.id) === siblingTaskId);
              if (siblingTask && siblingTask.parent === newParent) {
                insertionLocation = siblingTask.after;
              } else {
                throw new Error("Sibling task not found or not a child of new parent");
              }
            } else {
              throw new Error("Sibling task ID required for 'after' position");
            }
            break;
          default:
            throw new Error("Invalid position. Use 'beginning', 'ending', 'before', or 'after'");
        }
      } else {
        // Moving to inbox or containing project root
        if (task.containingProject) {
          insertionLocation = task.containingProject.ending;
        } else {
          insertionLocation = document.inbox.ending;
        }
      }

      // Move the root task of the branch (children will follow automatically)
      moveTasks([task], insertionLocation);

      // Invalidate caches
      invalidateOrganizationalCache('global', null);
      
      const processingTime = Date.now() - startTime;
      trackPerformance('moveTaskBranch', startTime, false);
      console.log(`[TIMING] moveTaskBranch completed in ${processingTime}ms`);

      return {
        success: true,
        branchRootTask: {
          id: bareId(task.id),
          name: task.name
        },
        branchSize: branchTasks.length,
        originalLocation: originalLocation,
        newLocation: {
          parentTaskId: newParent ? bareId(newParent.id) : null,
          parentTaskName: newParent ? newParent.name : null,
          containingProject: task.containingProject ? bareId(task.containingProject.id) : null,
          projectName: task.containingProject ? task.containingProject.name : 'Inbox',
          position: newParent ? Array.from(newParent.children).indexOf(task) : 
                   (task.containingProject ? Array.from(task.containingProject.tasks).indexOf(task) : -1)
        },
        movedTasks: branchTasks.map(t => ({
          id: bareId(t.id),
          name: t.name,
          depth: calculateTaskDepth(t) - calculateTaskDepth(task)
        }))
      };
    } catch (error) {
      console.log(`[ERROR] moveTaskBranch failed: ${error.message}`);
      throw new Error(`Failed to move task branch: ${error.message}`);
    }
  };

  lib.nestTasksAsHierarchy = params => {
    const startTime = Date.now();
    const taskIds = params.taskIds || [];
    const hierarchyStructure = params.hierarchyStructure || [];
    const parentTaskId = params.parentTaskId || null;
    
    if (!Array.isArray(taskIds) || taskIds.length === 0) {
      throw new Error("taskIds parameter is required and must be a non-empty array");
    }
    
    if (!Array.isArray(hierarchyStructure) || hierarchyStructure.length === 0) {
      throw new Error("hierarchyStructure parameter is required and must be a non-empty array");
    }
    
    try {
      // Validate all tasks exist
      const tasks = [];
      for (const taskId of taskIds) {
        const task = flattenedTasks.find(t => bareId(t.id) === taskId);
        if (!task) {
          throw new Error(`Task not found: ${taskId}`);
        }
        tasks.push(task);
      }

      // Validate parent task if specified
      let parentTask = null;
      if (parentTaskId) {
        parentTask = flattenedTasks.find(t => bareId(t.id) === parentTaskId);
        if (!parentTask) {
          throw new Error(`Parent task not found: ${parentTaskId}`);
        }
        
        if (parentTask.completed) {
          throw new Error("Cannot nest tasks under completed parent");
        }
        if (parentTask.dropDate) {
          throw new Error("Cannot nest tasks under dropped parent");
        }
      }

      // Process hierarchy structure
      const processedTasks = [];
      const taskMap = new Map();
      
      // Create map of tasks by ID for quick lookup
      tasks.forEach(task => {
        taskMap.set(bareId(task.id), task);
      });

      // Process each item in hierarchy structure
      for (const item of hierarchyStructure) {
        const { taskId, parentId, position } = item;
        
        if (!taskMap.has(taskId)) {
          throw new Error(`Task ID in hierarchy structure not found in taskIds: ${taskId}`);
        }
        
        const task = taskMap.get(taskId);
        let targetParent = null;
        
        if (parentId) {
          if (parentId === parentTaskId) {
            targetParent = parentTask;
          } else {
            targetParent = taskMap.get(parentId);
            if (!targetParent) {
              throw new Error(`Parent task ID in hierarchy structure not found: ${parentId}`);
            }
          }
        } else {
          targetParent = parentTask; // Use specified parent or null for root level
        }

        // Store original location
        const originalLocation = {
          parentTaskId: task.parent ? bareId(task.parent.id) : null,
          containingProject: task.containingProject ? bareId(task.containingProject.id) : null
        };

        // Determine insertion location and move the task
        let insertionLocation;
        if (targetParent) {
          switch (position || 'ending') {
            case 'beginning':
              insertionLocation = targetParent.beginning;
              break;
            case 'ending':
              insertionLocation = targetParent.ending;
              break;
            default:
              insertionLocation = targetParent.ending;
          }
        } else {
          // Moving to project root or inbox
          if (task.containingProject) {
            insertionLocation = task.containingProject.ending;
          } else {
            insertionLocation = document.inbox.ending;
          }
        }
        
        // Move the task using correct API
        moveTasks([task], insertionLocation);

        processedTasks.push({
          id: bareId(task.id),
          name: task.name,
          originalLocation: originalLocation,
          newLocation: {
            parentTaskId: targetParent ? bareId(targetParent.id) : null,
            parentTaskName: targetParent ? targetParent.name : null,
            containingProject: task.containingProject ? bareId(task.containingProject.id) : null
          },
          position: position || 'ending'
        });
      }

      // Invalidate caches
      invalidateOrganizationalCache('global', null);
      
      const processingTime = Date.now() - startTime;
      trackPerformance('nestTasksAsHierarchy', startTime, false);
      console.log(`[TIMING] nestTasksAsHierarchy completed in ${processingTime}ms`);

      return {
        success: true,
        tasksProcessed: processedTasks.length,
        parentTask: parentTask ? {
          id: bareId(parentTask.id),
          name: parentTask.name,
          childCount: parentTask.children.length
        } : null,
        processedTasks: processedTasks,
        hierarchyApplied: true
      };
    } catch (error) {
      console.log(`[ERROR] nestTasksAsHierarchy failed: ${error.message}`);
      throw new Error(`Failed to nest tasks as hierarchy: ${error.message}`);
    }
  };

  lib.restructureTaskHierarchy = params => {
    const startTime = Date.now();
    const operations = params.operations || [];
    const validateOnly = params.validateOnly !== undefined ? params.validateOnly : false;
    const stopOnError = params.stopOnError !== undefined ? params.stopOnError : true;
    
    if (!Array.isArray(operations) || operations.length === 0) {
      throw new Error("operations parameter is required and must be a non-empty array");
    }
    
    try {
      const results = [];
      const errors = [];
      const validationResults = [];

      // First pass: validate all operations if requested
      if (validateOnly) {
        for (let i = 0; i < operations.length; i++) {
          const operation = operations[i];
          try {
            const validation = validateOperation(operation, i);
            validationResults.push(validation);
          } catch (error) {
            validationResults.push({
              operationIndex: i,
              operation: operation,
              valid: false,
              error: error.message
            });
          }
        }
        
        return {
          success: true,
          validationOnly: true,
          totalOperations: operations.length,
          validOperations: validationResults.filter(v => v.valid).length,
          invalidOperations: validationResults.filter(v => !v.valid).length,
          validationResults: validationResults
        };
      }

      // Execute operations
      for (let i = 0; i < operations.length; i++) {
        const operation = operations[i];
        try {
          let result;
          
          switch (operation.type) {
            case 'move':
              // Handle different parameter styles for move operations
              let moveParams = {
                taskId: operation.taskId,
                position: operation.position,
                includeSubtasks: operation.includeSubtasks
              };
              
              // If newParentId is provided, find the parent and its project
              if (operation.newParentId) {
                const parentTask = flattenedTasks.find(t => bareId(t.id) === operation.newParentId);
                if (!parentTask) {
                  throw new Error(`Parent task not found: ${operation.newParentId}`);
                }
                moveParams.parentTaskId = operation.newParentId;
                moveParams.targetProjectId = parentTask.containingProject ? bareId(parentTask.containingProject.id) : null;
              } else {
                // Use explicit targetProjectId and parentTaskId
                moveParams.targetProjectId = operation.targetProjectId;
                moveParams.parentTaskId = operation.parentTaskId;
              }
              
              result = lib.moveTask(moveParams);
              break;
              
            case 'moveBranch':
              result = lib.moveTaskBranch({
                taskId: operation.taskId,
                newParentId: operation.newParentId,
                position: operation.position,
                siblingTaskId: operation.siblingTaskId
              });
              break;
              
            case 'createSubtask':
              result = lib.createSubtask({
                parentTaskId: operation.parentTaskId,
                name: operation.name,
                position: operation.position,
                properties: operation.properties || {}
              });
              break;
              
            case 'flatten':
              result = lib.flattenTaskHierarchy({
                rootTaskId: operation.rootTaskId,
                preserveOrder: operation.preserveOrder,
                targetProjectId: operation.targetProjectId,
                flattenTo: operation.flattenTo
              });
              break;
              
            case 'nest':
              result = lib.nestTasksAsHierarchy({
                taskIds: operation.taskIds,
                hierarchyStructure: operation.hierarchyStructure,
                parentTaskId: operation.parentTaskId
              });
              break;
              
            default:
              throw new Error(`Unknown operation type: ${operation.type}`);
          }
          
          results.push({
            operationIndex: i,
            operation: operation,
            success: true,
            result: result
          });
          
        } catch (error) {
          const errorInfo = {
            operationIndex: i,
            operation: operation,
            success: false,
            error: error.message
          };
          
          errors.push(errorInfo);
          results.push(errorInfo);
          
          if (stopOnError) {
            console.log(`[ERROR] restructureTaskHierarchy stopped at operation ${i}: ${error.message}`);
            break;
          }
        }
      }

      // Invalidate caches after all operations
      invalidateOrganizationalCache('global', null);
      
      const processingTime = Date.now() - startTime;
      trackPerformance('restructureTaskHierarchy', startTime, false);
      console.log(`[TIMING] restructureTaskHierarchy completed in ${processingTime}ms`);

      return {
        success: errors.length === 0 || !stopOnError,
        totalOperations: operations.length,
        successfulOperations: results.filter(r => r.success).length,
        failedOperations: errors.length,
        stoppedOnError: stopOnError && errors.length > 0,
        results: results,
        errors: errors.length > 0 ? errors : undefined
      };
      
    } catch (error) {
      console.log(`[ERROR] restructureTaskHierarchy failed: ${error.message}`);
      throw new Error(`Failed to restructure task hierarchy: ${error.message}`);
    }
    
    // Helper function to validate individual operations
    function validateOperation(operation, index) {
      if (!operation.type) {
        throw new Error(`Operation ${index}: type is required`);
      }
      
      switch (operation.type) {
        case 'move':
          if (!operation.taskId) {
            throw new Error(`Operation ${index}: taskId is required for move operation`);
          }
          // Either newParentId or targetProjectId/parentTaskId should be provided
          if (!operation.newParentId && !operation.targetProjectId && !operation.parentTaskId) {
            throw new Error(`Operation ${index}: move operation requires either newParentId or targetProjectId/parentTaskId`);
          }
          break;
          
        case 'moveBranch':
          if (!operation.taskId) {
            throw new Error(`Operation ${index}: taskId is required for moveBranch operation`);
          }
          break;
          
        case 'createSubtask':
          if (!operation.parentTaskId) {
            throw new Error(`Operation ${index}: parentTaskId is required for createSubtask operation`);
          }
          if (!operation.name) {
            throw new Error(`Operation ${index}: name is required for createSubtask operation`);
          }
          break;
          
        case 'flatten':
          if (!operation.rootTaskId) {
            throw new Error(`Operation ${index}: rootTaskId is required for flatten operation`);
          }
          break;
          
        case 'nest':
          if (!operation.taskIds || !Array.isArray(operation.taskIds)) {
            throw new Error(`Operation ${index}: taskIds array is required for nest operation`);
          }
          if (!operation.hierarchyStructure || !Array.isArray(operation.hierarchyStructure)) {
            throw new Error(`Operation ${index}: hierarchyStructure array is required for nest operation`);
          }
          break;
          
        default:
          throw new Error(`Operation ${index}: unknown operation type '${operation.type}'`);
      }
      
      return {
        operationIndex: index,
        operation: operation,
        valid: true
      };
    }
  };

  lib.previewHierarchyOperation = params => {
    const startTime = Date.now();
    const operation = params.operation;
    
    if (!operation || typeof operation !== 'object') {
      throw new Error("operation parameter is required and must be an object");
    }
    
    try {
      const preview = {
        operation: operation,
        type: operation.type,
        valid: false,
        changes: [],
        affectedTasks: [],
        warnings: [],
        estimatedImpact: {
          tasksAffected: 0,
          hierarchyLevelsChanged: 0,
          projectsAffected: 0
        }
      };

      // Validate and analyze the operation
      switch (operation.type) {
        case 'move':
          const moveAnalysis = analyzeTaskMove(operation);
          preview.valid = moveAnalysis.valid;
          preview.changes = moveAnalysis.changes;
          preview.affectedTasks = moveAnalysis.affectedTasks;
          preview.warnings = moveAnalysis.warnings;
          preview.estimatedImpact = moveAnalysis.estimatedImpact;
          break;
          
        case 'moveBranch':
          const branchAnalysis = analyzeTaskBranchMove(operation);
          preview.valid = branchAnalysis.valid;
          preview.changes = branchAnalysis.changes;
          preview.affectedTasks = branchAnalysis.affectedTasks;
          preview.warnings = branchAnalysis.warnings;
          preview.estimatedImpact = branchAnalysis.estimatedImpact;
          break;
          
        case 'flatten':
          const flattenAnalysis = analyzeFlattenOperation(operation);
          preview.valid = flattenAnalysis.valid;
          preview.changes = flattenAnalysis.changes;
          preview.affectedTasks = flattenAnalysis.affectedTasks;
          preview.warnings = flattenAnalysis.warnings;
          preview.estimatedImpact = flattenAnalysis.estimatedImpact;
          break;
          
        case 'nest':
          const nestAnalysis = analyzeNestOperation(operation);
          preview.valid = nestAnalysis.valid;
          preview.changes = nestAnalysis.changes;
          preview.affectedTasks = nestAnalysis.affectedTasks;
          preview.warnings = nestAnalysis.warnings;
          preview.estimatedImpact = nestAnalysis.estimatedImpact;
          break;
          
        default:
          preview.valid = false;
          preview.warnings.push(`Unknown operation type: ${operation.type}`);
      }
      
      const processingTime = Date.now() - startTime;
      trackPerformance('previewHierarchyOperation', startTime, false);
      console.log(`[TIMING] previewHierarchyOperation completed in ${processingTime}ms`);

      return preview;
      
    } catch (error) {
      console.log(`[ERROR] previewHierarchyOperation failed: ${error.message}`);
      throw new Error(`Failed to preview hierarchy operation: ${error.message}`);
    }
    
    // Helper functions for analysis
    function analyzeTaskMove(operation) {
      const result = {
        valid: false,
        changes: [],
        affectedTasks: [],
        warnings: [],
        estimatedImpact: { tasksAffected: 1, hierarchyLevelsChanged: 0, projectsAffected: 0 }
      };
      
      try {
        const task = flattenedTasks.find(t => bareId(t.id) === operation.taskId);
        if (!task) {
          result.warnings.push(`Task not found: ${operation.taskId}`);
          return result;
        }
        
        result.affectedTasks.push({
          id: bareId(task.id),
          name: task.name,
          currentLocation: {
            project: task.containingProject ? task.containingProject.name : 'Inbox',
            parent: task.parent ? task.parent.name : null
          }
        });
        
        result.changes.push(`Move task "${task.name}" to new location`);
        result.valid = true;
        
        if (operation.targetProjectId && task.containingProject && 
            bareId(task.containingProject.id) !== operation.targetProjectId) {
          result.estimatedImpact.projectsAffected = 2;
        }
        
      } catch (error) {
        result.warnings.push(error.message);
      }
      
      return result;
    }
    
    function analyzeTaskBranchMove(operation) {
      const result = {
        valid: false,
        changes: [],
        affectedTasks: [],
        warnings: [],
        estimatedImpact: { tasksAffected: 0, hierarchyLevelsChanged: 0, projectsAffected: 0 }
      };
      
      try {
        const task = flattenedTasks.find(t => bareId(t.id) === operation.taskId);
        if (!task) {
          result.warnings.push(`Task not found: ${operation.taskId}`);
          return result;
        }
        
        // Count all tasks in the branch
        const countBranch = (currentTask) => {
          let count = 1;
          for (const child of currentTask.children) {
            count += countBranch(child);
          }
          return count;
        };
        
        const branchSize = countBranch(task);
        result.estimatedImpact.tasksAffected = branchSize;
        
        result.affectedTasks.push({
          id: bareId(task.id),
          name: task.name,
          type: 'branch root',
          branchSize: branchSize
        });
        
        result.changes.push(`Move entire task branch starting with "${task.name}" (${branchSize} tasks)`);
        result.valid = true;
        
      } catch (error) {
        result.warnings.push(error.message);
      }
      
      return result;
    }
    
    function analyzeFlattenOperation(operation) {
      const result = {
        valid: false,
        changes: [],
        affectedTasks: [],
        warnings: [],
        estimatedImpact: { tasksAffected: 0, hierarchyLevelsChanged: 0, projectsAffected: 0 }
      };
      
      try {
        const rootTask = flattenedTasks.find(t => bareId(t.id) === operation.rootTaskId);
        if (!rootTask) {
          result.warnings.push(`Root task not found: ${operation.rootTaskId}`);
          return result;
        }
        
        // Count descendant tasks
        const countDescendants = (task, depth = 0) => {
          let count = 0;
          for (const child of task.children) {
            count++;
            count += countDescendants(child, depth + 1);
          }
          return count;
        };
        
        const descendantCount = countDescendants(rootTask);
        result.estimatedImpact.tasksAffected = descendantCount;
        
        if (descendantCount > 0) {
          result.changes.push(`Flatten ${descendantCount} tasks from hierarchy under "${rootTask.name}"`);
          result.valid = true;
        } else {
          result.warnings.push("No descendant tasks to flatten");
        }
        
      } catch (error) {
        result.warnings.push(error.message);
      }
      
      return result;
    }
    
    function analyzeNestOperation(operation) {
      const result = {
        valid: false,
        changes: [],
        affectedTasks: [],
        warnings: [],
        estimatedImpact: { tasksAffected: 0, hierarchyLevelsChanged: 0, projectsAffected: 0 }
      };
      
      try {
        if (!operation.taskIds || !Array.isArray(operation.taskIds)) {
          result.warnings.push("taskIds is required and must be an array");
          return result;
        }
        
        result.estimatedImpact.tasksAffected = operation.taskIds.length;
        result.changes.push(`Reorganize ${operation.taskIds.length} tasks into new hierarchy`);
        
        // Validate all tasks exist
        for (const taskId of operation.taskIds) {
          const task = flattenedTasks.find(t => bareId(t.id) === taskId);
          if (!task) {
            result.warnings.push(`Task not found: ${taskId}`);
          } else {
            result.affectedTasks.push({
              id: bareId(task.id),
              name: task.name
            });
          }
        }
        
        result.valid = result.warnings.length === 0;
        
      } catch (error) {
        result.warnings.push(error.message);
      }
      
      return result;
    }
  };

  // ============ HIERARCHY VALIDATION SYSTEM (Task 4-9) ============

  lib.validateHierarchyIntegrity = params => {
    const startTime = Date.now();
    const rootId = params.rootId || null;
    const includeRepairSuggestions = params.includeRepairSuggestions !== undefined ? params.includeRepairSuggestions : true;
    const validationLevel = params.validationLevel || 'comprehensive'; // 'basic', 'standard', 'comprehensive'
    
    try {
      console.log(`[INFO] Starting hierarchy integrity validation (level: ${validationLevel})`);
      
      const validationResult = {
        valid: true,
        overallHealth: 'healthy',
        validationLevel: validationLevel,
        scope: rootId ? 'specific hierarchy' : 'all hierarchies',
        rootTaskId: rootId,
        validationSummary: {
          totalTasksValidated: 0,
          totalProjectsValidated: 0,
          errorsFound: 0,
          warningsFound: 0,
          suggestionsFound: 0
        },
        errors: [],
        warnings: [],
        suggestions: [],
        hierarchyMetrics: {
          maxDepth: 0,
          averageDepth: 0,
          taskCount: 0,
          parentTaskCount: 0,
          leafTaskCount: 0
        }
      };

      // Determine scope of validation
      let tasksToValidate = [];
      if (rootId) {
        const rootTask = flattenedTasks.find(t => bareId(t.id) === rootId);
        if (!rootTask) {
          throw new Error(`Root task not found: ${rootId}`);
        }
        
        // Gather all tasks in the hierarchy
        const gatherHierarchy = (task) => {
          tasksToValidate.push(task);
          for (const child of task.children) {
            gatherHierarchy(child);
          }
        };
        gatherHierarchy(rootTask);
      } else {
        tasksToValidate = flattenedTasks;
      }

      validationResult.validationSummary.totalTasksValidated = tasksToValidate.length;
      validationResult.validationSummary.totalProjectsValidated = flattenedProjects.length;

      // Core validation checks
      performBasicValidation(tasksToValidate, validationResult);
      
      if (validationLevel === 'standard' || validationLevel === 'comprehensive') {
        performStandardValidation(tasksToValidate, validationResult);
      }
      
      if (validationLevel === 'comprehensive') {
        performComprehensiveValidation(tasksToValidate, validationResult);
      }

      // Calculate hierarchy metrics
      calculateHierarchyMetrics(tasksToValidate, validationResult);

      // Determine overall health
      if (validationResult.errors.length > 0) {
        validationResult.valid = false;
        validationResult.overallHealth = 'critical';
      } else if (validationResult.warnings.length > 3) {
        validationResult.overallHealth = 'degraded';
      } else if (validationResult.warnings.length > 0) {
        validationResult.overallHealth = 'minor_issues';
      }

      const processingTime = Date.now() - startTime;
      trackPerformance('validateHierarchyIntegrity', startTime, false);
      console.log(`[TIMING] validateHierarchyIntegrity completed in ${processingTime}ms`);

      return validationResult;
      
    } catch (error) {
      console.log(`[ERROR] validateHierarchyIntegrity failed: ${error.message}`);
      throw new Error(`Failed to validate hierarchy integrity: ${error.message}`);
    }

    // Helper function for basic validation checks
    function performBasicValidation(tasks, result) {
      for (const task of tasks) {
        // Check for circular dependencies
        if (hasCircularDependency(task)) {
          result.errors.push({
            type: 'circular_dependency',
            severity: 'critical',
            taskId: bareId(task.id),
            taskName: task.name,
            message: `Task is part of a circular dependency chain`,
            repairSuggestion: includeRepairSuggestions ? 'Move task to break circular chain' : null
          });
        }

        // Check parent-child relationship validity
        if (task.parent) {
          const parent = task.parent;
          if (parent.completed && !task.completed) {
            result.warnings.push({
              type: 'active_task_under_completed_parent',
              severity: 'medium',
              taskId: bareId(task.id),
              taskName: task.name,
              parentId: bareId(parent.id),
              parentName: parent.name,
              message: `Active task under completed parent "${parent.name}"`,
              repairSuggestion: includeRepairSuggestions ? 'Move task or mark as completed' : null
            });
          }

          if (parent.dropDate && !task.dropDate) {
            result.warnings.push({
              type: 'active_task_under_dropped_parent',
              severity: 'medium',
              taskId: bareId(task.id),
              taskName: task.name,
              parentId: bareId(parent.id),
              parentName: parent.name,
              message: `Active task under dropped parent "${parent.name}"`,
              repairSuggestion: includeRepairSuggestions ? 'Move task or mark as dropped' : null
            });
          }
        }

        // Check project containment
        if (!task.containingProject && !task.parent) {
          result.warnings.push({
            type: 'orphaned_task',
            severity: 'low',
            taskId: bareId(task.id),
            taskName: task.name,
            message: `Task has no containing project or parent task`,
            repairSuggestion: includeRepairSuggestions ? 'Assign to project or move under parent task' : null
          });
        }
      }
    }

    // Helper function for standard validation checks
    function performStandardValidation(tasks, result) {
      // Check for excessive hierarchy depth
      for (const task of tasks) {
        const depth = calculateTaskDepth(task);
        if (depth > 10) {
          result.warnings.push({
            type: 'excessive_hierarchy_depth',
            severity: 'medium',
            taskId: bareId(task.id),
            taskName: task.name,
            depth: depth,
            message: `Task hierarchy depth (${depth}) exceeds recommended maximum (10)`,
            repairSuggestion: includeRepairSuggestions ? 'Consider flattening deep hierarchies' : null
          });
        }
      }

      // Check for tasks with many children
      for (const task of tasks) {
        if (task.children.length > 20) {
          result.suggestions.push({
            type: 'too_many_children',
            severity: 'low',
            taskId: bareId(task.id),
            taskName: task.name,
            childCount: task.children.length,
            message: `Task has ${task.children.length} direct children (consider grouping)`,
            repairSuggestion: includeRepairSuggestions ? 'Group related subtasks under intermediate parent tasks' : null
          });
        }
      }
    }

    // Helper function for comprehensive validation checks
    function performComprehensiveValidation(tasks, result) {
      // Check for inconsistent completion states
      for (const task of tasks) {
        if (task.children.length > 0) {
          const completedChildren = task.children.filter(child => child.completed).length;
          const totalChildren = task.children.length;
          
          if (completedChildren === totalChildren && !task.completed && !task.completedByChildren) {
            result.suggestions.push({
              type: 'should_be_completed',
              severity: 'low',
              taskId: bareId(task.id),
              taskName: task.name,
              message: `All subtasks completed but parent task remains incomplete`,
              repairSuggestion: includeRepairSuggestions ? 'Mark parent task as completed or enable completedByChildren' : null
            });
          }

          if (task.completed && completedChildren < totalChildren) {
            result.warnings.push({
              type: 'completed_parent_with_active_children',
              severity: 'medium',
              taskId: bareId(task.id),
              taskName: task.name,
              activeChildren: totalChildren - completedChildren,
              message: `Completed parent has ${totalChildren - completedChildren} active subtasks`,
              repairSuggestion: includeRepairSuggestions ? 'Complete all subtasks or mark parent as incomplete' : null
            });
          }
        }
      }

      // Check for naming consistency issues
      const taskNameMap = new Map();
      for (const task of tasks) {
        const name = task.name.toLowerCase().trim();
        if (taskNameMap.has(name)) {
          const existing = taskNameMap.get(name);
          result.suggestions.push({
            type: 'duplicate_task_names',
            severity: 'low',
            taskId: bareId(task.id),
            taskName: task.name,
            duplicateId: bareId(existing.id),
            duplicateName: existing.name,
            message: `Duplicate task name found: "${task.name}"`,
            repairSuggestion: includeRepairSuggestions ? 'Differentiate task names for clarity' : null
          });
        } else {
          taskNameMap.set(name, task);
        }
      }
    }

    // Helper function to detect circular dependencies
    function hasCircularDependency(task) {
      const visited = new Set();
      const recursionStack = new Set();
      
      function dfsCheck(currentTask) {
        const taskId = bareId(currentTask.id);
        
        if (recursionStack.has(taskId)) {
          return true; // Circular dependency found
        }
        
        if (visited.has(taskId)) {
          return false; // Already processed
        }
        
        visited.add(taskId);
        recursionStack.add(taskId);
        
        // Check parent
        if (currentTask.parent) {
          if (dfsCheck(currentTask.parent)) {
            return true;
          }
        }
        
        recursionStack.delete(taskId);
        return false;
      }
      
      return dfsCheck(task);
    }

    // Helper function to calculate hierarchy metrics
    function calculateHierarchyMetrics(tasks, result) {
      let totalDepth = 0;
      let maxDepth = 0;
      let parentTaskCount = 0;
      let leafTaskCount = 0;

      for (const task of tasks) {
        const depth = calculateTaskDepth(task);
        totalDepth += depth;
        maxDepth = Math.max(maxDepth, depth);

        if (task.children.length > 0) {
          parentTaskCount++;
        } else {
          leafTaskCount++;
        }
      }

      result.hierarchyMetrics = {
        maxDepth: maxDepth,
        averageDepth: tasks.length > 0 ? Math.round((totalDepth / tasks.length) * 100) / 100 : 0,
        taskCount: tasks.length,
        parentTaskCount: parentTaskCount,
        leafTaskCount: leafTaskCount
      };
    }
  };

  lib.validateOperation = params => {
    const startTime = Date.now();
    const operation = params.operation;
    
    if (!operation || typeof operation !== 'object') {
      throw new Error("operation parameter is required and must be an object");
    }
    
    try {
      console.log(`[INFO] Validating operation: ${operation.type}`);
      
      const validationResult = {
        valid: false,
        operation: operation,
        operationType: operation.type,
        canProceed: false,
        riskLevel: 'unknown',
        preChecks: {
          passed: 0,
          failed: 0,
          warnings: 0
        },
        errors: [],
        warnings: [],
        recommendations: [],
        estimatedImpact: {
          tasksAffected: 0,
          hierarchyLevelsChanged: 0,
          projectsAffected: 0,
          riskFactors: []
        }
      };

      // Route to specific validation based on operation type
      switch (operation.type) {
        case 'move':
          validateMoveOperation(operation, validationResult);
          break;
        case 'moveBranch':
          validateMoveBranchOperation(operation, validationResult);
          break;
        case 'createSubtask':
          validateCreateSubtaskOperation(operation, validationResult);
          break;
        case 'flatten':
          validateFlattenOperation(operation, validationResult);
          break;
        case 'nest':
          validateNestOperation(operation, validationResult);
          break;
        default:
          validationResult.errors.push({
            type: 'unknown_operation',
            message: `Unknown operation type: ${operation.type}`,
            severity: 'critical'
          });
      }

      // Determine overall validation result
      validationResult.valid = validationResult.errors.length === 0;
      validationResult.canProceed = validationResult.valid && validationResult.warnings.length < 5;

      // Assess risk level
      if (validationResult.errors.length > 0) {
        validationResult.riskLevel = 'high';
      } else if (validationResult.warnings.length > 2) {
        validationResult.riskLevel = 'medium';
      } else if (validationResult.warnings.length > 0) {
        validationResult.riskLevel = 'low';
      } else {
        validationResult.riskLevel = 'minimal';
      }

      const processingTime = Date.now() - startTime;
      trackPerformance('validateOperation', startTime, false);
      console.log(`[TIMING] validateOperation completed in ${processingTime}ms`);

      return validationResult;
      
    } catch (error) {
      console.log(`[ERROR] validateOperation failed: ${error.message}`);
      throw new Error(`Failed to validate operation: ${error.message}`);
    }

    // Operation-specific validation functions
    function validateMoveOperation(op, result) {
      // Check task exists
      if (!op.taskId) {
        result.errors.push({
          type: 'missing_parameter',
          message: 'taskId is required for move operation',
          severity: 'critical'
        });
        return;
      }

      const task = flattenedTasks.find(t => bareId(t.id) === op.taskId);
      if (!task) {
        result.errors.push({
          type: 'task_not_found',
          message: `Task not found: ${op.taskId}`,
          severity: 'critical'
        });
        return;
      }

      result.estimatedImpact.tasksAffected = 1;
      result.preChecks.passed++;

      // Check target validity
      if (op.newParentId) {
        const newParent = flattenedTasks.find(t => bareId(t.id) === op.newParentId);
        if (!newParent) {
          result.errors.push({
            type: 'target_not_found',
            message: `Target parent not found: ${op.newParentId}`,
            severity: 'critical'
          });
          return;
        }

        // Check for circular dependency
        if (wouldCreateCircularDependency(task, newParent)) {
          result.errors.push({
            type: 'circular_dependency',
            message: `Moving task would create circular dependency`,
            severity: 'critical'
          });
          return;
        }

        // Check parent state
        if (newParent.completed) {
          result.warnings.push({
            type: 'target_completed',
            message: `Target parent "${newParent.name}" is completed`,
            severity: 'medium'
          });
        }

        if (newParent.dropDate) {
          result.warnings.push({
            type: 'target_dropped',
            message: `Target parent "${newParent.name}" is dropped`,
            severity: 'medium'
          });
        }
      }

      // Check if moving between projects
      if (op.targetProjectId && task.containingProject && 
          bareId(task.containingProject.id) !== op.targetProjectId) {
        result.estimatedImpact.projectsAffected = 2;
        result.estimatedImpact.riskFactors.push('cross_project_move');
      }
    }

    function validateMoveBranchOperation(op, result) {
      if (!op.taskId) {
        result.errors.push({
          type: 'missing_parameter',
          message: 'taskId is required for moveBranch operation',
          severity: 'critical'
        });
        return;
      }

      const task = flattenedTasks.find(t => bareId(t.id) === op.taskId);
      if (!task) {
        result.errors.push({
          type: 'task_not_found',
          message: `Task not found: ${op.taskId}`,
          severity: 'critical'
        });
        return;
      }

      // Count branch size
      const branchSize = countTaskBranch(task);
      result.estimatedImpact.tasksAffected = branchSize;

      if (branchSize > 50) {
        result.warnings.push({
          type: 'large_branch',
          message: `Moving large branch (${branchSize} tasks) - consider smaller operations`,
          severity: 'medium'
        });
        result.estimatedImpact.riskFactors.push('large_operation');
      }

      // Validate target if specified
      if (op.newParentId) {
        const newParent = flattenedTasks.find(t => bareId(t.id) === op.newParentId);
        if (!newParent) {
          result.errors.push({
            type: 'target_not_found',
            message: `Target parent not found: ${op.newParentId}`,
            severity: 'critical'
          });
          return;
        }

        // Check for circular dependency (branch contains new parent)
        if (branchContainsTask(task, newParent)) {
          result.errors.push({
            type: 'circular_dependency',
            message: `Cannot move branch - target parent is within the branch`,
            severity: 'critical'
          });
          return;
        }
      }
    }

    function validateCreateSubtaskOperation(op, result) {
      if (!op.parentTaskId) {
        result.errors.push({
          type: 'missing_parameter',
          message: 'parentTaskId is required for createSubtask operation',
          severity: 'critical'
        });
        return;
      }

      if (!op.name) {
        result.errors.push({
          type: 'missing_parameter',
          message: 'name is required for createSubtask operation',
          severity: 'critical'
        });
        return;
      }

      const parentTask = flattenedTasks.find(t => bareId(t.id) === op.parentTaskId);
      if (!parentTask) {
        result.errors.push({
          type: 'parent_not_found',
          message: `Parent task not found: ${op.parentTaskId}`,
          severity: 'critical'
        });
        return;
      }

      result.estimatedImpact.tasksAffected = 1;

      // Check parent state
      if (parentTask.completed) {
        result.warnings.push({
          type: 'parent_completed',
          message: `Parent task "${parentTask.name}" is completed`,
          severity: 'medium'
        });
      }

      if (parentTask.dropDate) {
        result.warnings.push({
          type: 'parent_dropped',
          message: `Parent task "${parentTask.name}" is dropped`,
          severity: 'medium'
        });
      }

      // Check depth
      const parentDepth = calculateTaskDepth(parentTask);
      if (parentDepth >= 10) {
        result.warnings.push({
          type: 'excessive_depth',
          message: `Creating subtask at depth ${parentDepth + 1} (exceeds recommended maximum)`,
          severity: 'low'
        });
      }

      // Check sibling count
      if (parentTask.children.length >= 20) {
        result.warnings.push({
          type: 'many_siblings',
          message: `Parent already has ${parentTask.children.length} children`,
          severity: 'low'
        });
      }
    }

    function validateFlattenOperation(op, result) {
      if (!op.rootTaskId) {
        result.errors.push({
          type: 'missing_parameter',
          message: 'rootTaskId is required for flatten operation',
          severity: 'critical'
        });
        return;
      }

      const rootTask = flattenedTasks.find(t => bareId(t.id) === op.rootTaskId);
      if (!rootTask) {
        result.errors.push({
          type: 'root_not_found',
          message: `Root task not found: ${op.rootTaskId}`,
          severity: 'critical'
        });
        return;
      }

      // Count descendants
      const descendantCount = countTaskDescendants(rootTask);
      result.estimatedImpact.tasksAffected = descendantCount;

      if (descendantCount === 0) {
        result.warnings.push({
          type: 'no_descendants',
          message: `Root task has no descendants to flatten`,
          severity: 'low'
        });
      }

      if (descendantCount > 100) {
        result.warnings.push({
          type: 'large_flatten',
          message: `Flattening large hierarchy (${descendantCount} tasks)`,
          severity: 'medium'
        });
        result.estimatedImpact.riskFactors.push('large_operation');
      }
    }

    function validateNestOperation(op, result) {
      if (!op.taskIds || !Array.isArray(op.taskIds)) {
        result.errors.push({
          type: 'missing_parameter',
          message: 'taskIds array is required for nest operation',
          severity: 'critical'
        });
        return;
      }

      result.estimatedImpact.tasksAffected = op.taskIds.length;

      // Validate all tasks exist
      for (const taskId of op.taskIds) {
        const task = flattenedTasks.find(t => bareId(t.id) === taskId);
        if (!task) {
          result.errors.push({
            type: 'task_not_found',
            message: `Task not found in nest operation: ${taskId}`,
            severity: 'critical'
          });
        }
      }

      if (op.taskIds.length > 50) {
        result.warnings.push({
          type: 'large_nest',
          message: `Nesting operation involves ${op.taskIds.length} tasks`,
          severity: 'medium'
        });
      }
    }

    // Helper functions
    function wouldCreateCircularDependency(task, newParent) {
      let current = newParent;
      while (current) {
        if (bareId(current.id) === bareId(task.id)) {
          return true;
        }
        current = current.parent;
      }
      return false;
    }

    function countTaskBranch(task) {
      let count = 1;
      for (const child of task.children) {
        count += countTaskBranch(child);
      }
      return count;
    }

    function branchContainsTask(branchRoot, targetTask) {
      if (bareId(branchRoot.id) === bareId(targetTask.id)) {
        return true;
      }
      for (const child of branchRoot.children) {
        if (branchContainsTask(child, targetTask)) {
          return true;
        }
      }
      return false;
    }

    function countTaskDescendants(task) {
      let count = 0;
      for (const child of task.children) {
        count++;
        count += countTaskDescendants(child);
      }
      return count;
    }
  };

  lib.getValidationErrors = params => {
    const startTime = Date.now();
    const hierarchyIds = params.hierarchyIds || [];
    const errorTypes = params.errorTypes || null; // null = all types
    const severity = params.severity || null; // null = all severities
    const includeWarnings = params.includeWarnings !== undefined ? params.includeWarnings : true;
    
    try {
      console.log(`[INFO] Getting validation errors for ${hierarchyIds.length || 'all'} hierarchies`);
      
      const errorReport = {
        scope: hierarchyIds.length > 0 ? 'specific hierarchies' : 'all hierarchies',
        hierarchyIds: hierarchyIds,
        filters: {
          errorTypes: errorTypes,
          severity: severity,
          includeWarnings: includeWarnings
        },
        summary: {
          totalErrors: 0,
          totalWarnings: 0,
          criticalErrors: 0,
          hierarchiesWithIssues: 0
        },
        errorsByHierarchy: [],
        errorsByType: {},
        recommendations: []
      };

      // Determine which hierarchies to check
      let hierarchiesToCheck = [];
      if (hierarchyIds.length > 0) {
        for (const hierarchyId of hierarchyIds) {
          const rootTask = flattenedTasks.find(t => bareId(t.id) === hierarchyId);
          if (rootTask) {
            hierarchiesToCheck.push(rootTask);
          }
        }
      } else {
        // Check all root-level tasks and orphaned tasks
        hierarchiesToCheck = flattenedTasks.filter(t => !t.parent);
      }

      // Validate each hierarchy
      for (const rootTask of hierarchiesToCheck) {
        const hierarchyValidation = lib.validateHierarchyIntegrity({
          rootId: bareId(rootTask.id),
          includeRepairSuggestions: true,
          validationLevel: 'comprehensive'
        });

        if (hierarchyValidation.errors.length > 0 || 
            (includeWarnings && hierarchyValidation.warnings.length > 0)) {
          
          const hierarchyErrors = {
            hierarchyId: bareId(rootTask.id),
            hierarchyName: rootTask.name,
            errors: filterIssues(hierarchyValidation.errors, errorTypes, severity),
            warnings: includeWarnings ? filterIssues(hierarchyValidation.warnings, errorTypes, severity) : [],
            overallHealth: hierarchyValidation.overallHealth
          };

          errorReport.errorsByHierarchy.push(hierarchyErrors);
          errorReport.summary.hierarchiesWithIssues++;
          errorReport.summary.totalErrors += hierarchyErrors.errors.length;
          errorReport.summary.totalWarnings += hierarchyErrors.warnings.length;
          errorReport.summary.criticalErrors += hierarchyErrors.errors.filter(e => e.severity === 'critical').length;
        }

        // Aggregate errors by type
        for (const error of hierarchyValidation.errors) {
          if (!errorReport.errorsByType[error.type]) {
            errorReport.errorsByType[error.type] = {
              type: error.type,
              count: 0,
              severity: error.severity,
              description: error.message.split(':')[0], // Get general description
              instances: []
            };
          }
          errorReport.errorsByType[error.type].count++;
          errorReport.errorsByType[error.type].instances.push({
            hierarchyId: bareId(rootTask.id),
            taskId: error.taskId,
            taskName: error.taskName
          });
        }
      }

      // Generate recommendations based on error patterns
      generateRecommendations(errorReport);

      const processingTime = Date.now() - startTime;
      trackPerformance('getValidationErrors', startTime, false);
      console.log(`[TIMING] getValidationErrors completed in ${processingTime}ms`);

      return errorReport;
      
    } catch (error) {
      console.log(`[ERROR] getValidationErrors failed: ${error.message}`);
      throw new Error(`Failed to get validation errors: ${error.message}`);
    }

    function filterIssues(issues, types, severityFilter) {
      return issues.filter(issue => {
        if (types && !types.includes(issue.type)) return false;
        if (severityFilter && issue.severity !== severityFilter) return false;
        return true;
      });
    }

    function generateRecommendations(report) {
      // Analyze error patterns and suggest improvements
      const errorTypes = Object.keys(report.errorsByType);
      
      if (errorTypes.includes('circular_dependency')) {
        report.recommendations.push({
          type: 'urgent',
          title: 'Resolve Circular Dependencies',
          description: 'Circular dependencies detected. These must be resolved immediately to prevent data corruption.',
          action: 'Use moveTask operations to break circular chains'
        });
      }

      if (errorTypes.includes('excessive_hierarchy_depth')) {
        report.recommendations.push({
          type: 'optimization',
          title: 'Flatten Deep Hierarchies',
          description: 'Some hierarchies exceed recommended depth limits.',
          action: 'Use flattenTaskHierarchy to reduce complexity'
        });
      }

      if (report.summary.totalWarnings > report.summary.totalErrors * 3) {
        report.recommendations.push({
          type: 'maintenance',
          title: 'Regular Hierarchy Cleanup',
          description: 'High warning count suggests need for regular hierarchy maintenance.',
          action: 'Schedule periodic validation and cleanup operations'
        });
      }
    }
  };

  lib.repairHierarchyIntegrity = params => {
    const startTime = Date.now();
    const hierarchyId = params.hierarchyId;
    const repairTypes = params.repairTypes || ['all']; // 'all', 'critical', 'warnings', or specific types
    const dryRun = params.dryRun !== undefined ? params.dryRun : true; // Safe default
    const maxOperations = params.maxOperations || 50; // Safety limit
    
    if (!hierarchyId) {
      throw new Error("hierarchyId parameter is required");
    }
    
    try {
      console.log(`[INFO] Starting hierarchy integrity repair (dry run: ${dryRun})`);
      
      const rootTask = flattenedTasks.find(t => bareId(t.id) === hierarchyId);
      if (!rootTask) {
        throw new Error(`Hierarchy root task not found: ${hierarchyId}`);
      }

      // First, validate the hierarchy to identify issues
      const validation = lib.validateHierarchyIntegrity({
        rootId: hierarchyId,
        includeRepairSuggestions: true,
        validationLevel: 'comprehensive'
      });

      const repairReport = {
        hierarchyId: hierarchyId,
        hierarchyName: rootTask.name,
        dryRun: dryRun,
        originalHealth: validation.overallHealth,
        repairTypes: repairTypes,
        maxOperations: maxOperations,
        repairSummary: {
          issuesFound: validation.errors.length + validation.warnings.length,
          repairsAttempted: 0,
          repairsSuccessful: 0,
          repairsFailed: 0
        },
        repairOperations: [],
        remainingIssues: [],
        finalHealth: 'unknown'
      };

      // Collect issues to repair
      const issuesToRepair = [];
      
      if (repairTypes.includes('all') || repairTypes.includes('critical')) {
        issuesToRepair.push(...validation.errors);
      }
      
      if (repairTypes.includes('all') || repairTypes.includes('warnings')) {
        issuesToRepair.push(...validation.warnings);
      } else {
        // Add specific types
        for (const type of repairTypes) {
          if (type !== 'all' && type !== 'critical' && type !== 'warnings') {
            issuesToRepair.push(...validation.errors.filter(e => e.type === type));
            issuesToRepair.push(...validation.warnings.filter(w => w.type === type));
          }
        }
      }

      // Sort issues by severity (critical first)
      issuesToRepair.sort((a, b) => {
        const severityOrder = { critical: 0, medium: 1, low: 2 };
        return severityOrder[a.severity] - severityOrder[b.severity];
      });

      // Attempt repairs
      let operationsPerformed = 0;
      for (const issue of issuesToRepair) {
        if (operationsPerformed >= maxOperations) {
          console.log(`[WARNING] Reached maximum repair operations limit (${maxOperations})`);
          break;
        }

        const repairOperation = planRepairOperation(issue);
        if (repairOperation) {
          repairReport.repairOperations.push(repairOperation);
          repairReport.repairSummary.repairsAttempted++;

          if (!dryRun) {
            try {
              executeRepairOperation(repairOperation);
              repairOperation.executed = true;
              repairOperation.success = true;
              repairReport.repairSummary.repairsSuccessful++;
            } catch (error) {
              repairOperation.executed = true;
              repairOperation.success = false;
              repairOperation.error = error.message;
              repairReport.repairSummary.repairsFailed++;
            }
          } else {
            repairOperation.executed = false;
            repairOperation.success = null;
          }

          operationsPerformed++;
        }
      }

      // Re-validate if repairs were actually executed
      if (!dryRun && repairReport.repairSummary.repairsSuccessful > 0) {
        invalidateOrganizationalCache('global', null);
        const finalValidation = lib.validateHierarchyIntegrity({
          rootId: hierarchyId,
          includeRepairSuggestions: false,
          validationLevel: 'comprehensive'
        });
        
        repairReport.finalHealth = finalValidation.overallHealth;
        repairReport.remainingIssues = finalValidation.errors.concat(finalValidation.warnings);
      } else {
        repairReport.finalHealth = validation.overallHealth;
        repairReport.remainingIssues = issuesToRepair.filter(issue => 
          !repairReport.repairOperations.some(op => op.issueId === issue.taskId && op.issueType === issue.type)
        );
      }

      const processingTime = Date.now() - startTime;
      trackPerformance('repairHierarchyIntegrity', startTime, false);
      console.log(`[TIMING] repairHierarchyIntegrity completed in ${processingTime}ms`);

      return repairReport;
      
    } catch (error) {
      console.log(`[ERROR] repairHierarchyIntegrity failed: ${error.message}`);
      throw new Error(`Failed to repair hierarchy integrity: ${error.message}`);
    }

    function planRepairOperation(issue) {
      switch (issue.type) {
        case 'circular_dependency':
          return {
            issueId: issue.taskId,
            issueType: issue.type,
            operation: 'moveTask',
            description: `Move task "${issue.taskName}" to break circular dependency`,
            parameters: {
              taskId: issue.taskId,
              targetProjectId: issue.taskId.split('-')[0], // Move to project root
              parentTaskId: null
            },
            riskLevel: 'medium',
            reversible: true
          };

        case 'orphaned_task':
          return {
            issueId: issue.taskId,
            issueType: issue.type,
            operation: 'moveTask',
            description: `Move orphaned task "${issue.taskName}" to appropriate project`,
            parameters: {
              taskId: issue.taskId,
              targetProjectId: document.inbox.project ? bareId(document.inbox.project.id) : null
            },
            riskLevel: 'low',
            reversible: true
          };

        case 'active_task_under_completed_parent':
          return {
            issueId: issue.taskId,
            issueType: issue.type,
            operation: 'moveTask',
            description: `Move active task "${issue.taskName}" from under completed parent`,
            parameters: {
              taskId: issue.taskId,
              parentTaskId: null // Move to project level
            },
            riskLevel: 'low',
            reversible: true
          };

        case 'completed_parent_with_active_children':
          return {
            issueId: issue.taskId,
            issueType: issue.type,
            operation: 'markIncomplete',
            description: `Mark parent task "${issue.taskName}" as incomplete due to active children`,
            parameters: {
              taskId: issue.taskId
            },
            riskLevel: 'low',
            reversible: true
          };

        default:
          // For issues without automatic repair
          return null;
      }
    }

    function executeRepairOperation(operation) {
      switch (operation.operation) {
        case 'moveTask':
          lib.moveTask(operation.parameters);
          break;
        case 'markIncomplete':
          const task = flattenedTasks.find(t => bareId(t.id) === operation.parameters.taskId);
          if (task) {
            task.completed = false;
          }
          break;
        default:
          throw new Error(`Unknown repair operation: ${operation.operation}`);
      }
    }
  };

  // =============================================================================
  // TRANSACTION SUPPORT
  // =============================================================================

  // Transaction state management - session-based with module-level storage
  // Note: OmniFocus doesn't support document.settings, so we use session-based storage
  // with enhanced rollback tracking through timestamp-based operation detection
  
  // Module-level session state - resets between plugin executions
  if (typeof omniFocusSessionState === 'undefined') {
    var omniFocusSessionState = {
      activeTransactions: new Map(),
      transactionHistory: [],
      nextTransactionId: 1,
      maxHistorySize: 50,
      rollbackTimeoutMinutes: 10,
      lastAccess: Date.now(),
      sessionStartTime: Date.now()
    };
    console.log('[TRANSACTION] Initialized fresh session state');
  }
  
  function getTransactionState() {
    omniFocusSessionState.lastAccess = Date.now();
    return omniFocusSessionState;
  }
  
  // No persistence needed - session-based storage only
  function saveTransactionState(state) {
    // Session state is automatically maintained
    console.log(`[TRANSACTION] Session state updated: ${state.activeTransactions.size} active, ${state.transactionHistory.length} in history`);
  }
  
  const transactionState = getTransactionState();

  lib.beginTransaction = function({
    description = 'Complex hierarchy operation',
    validateBefore = true,
    dryRun = false
  }) {
    const startTime = Date.now();
    const transactionId = `tx-${transactionState.nextTransactionId++}`;
    
    try {
      console.log(`[TRANSACTION] Beginning transaction ${transactionId}: ${description}`);

      // Capture initial undo state
      const initialUndoState = {
        canUndo: document.canUndo,
        timestamp: Date.now()
      };

      // Validate hierarchy integrity before starting if requested
      let preValidation = null;
      if (validateBefore) {
        console.log(`[TRANSACTION] Performing pre-transaction validation...`);
        preValidation = lib.validateHierarchyIntegrity({
          validationLevel: 'standard',
          includeRepairSuggestions: false
        });

        if (preValidation.overallHealth === 'critical') {
          throw new Error(`Cannot start transaction - hierarchy in critical state: ${preValidation.errors.length} critical errors found`);
        }
      }

      // Create transaction record
      const transaction = {
        id: transactionId,
        description: description,
        status: 'active',
        startTime: Date.now(),
        dryRun: dryRun,
        initialUndoState: initialUndoState,
        preValidation: preValidation,
        operations: [],
        operationCount: 0,
        rollbackCount: 0,
        metadata: {
          cacheStateSnapshot: {
            queryCacheSize: queryCache.size,
            aggregationCacheSize: aggregationCache.size,
            hierarchyCacheSize: hierarchyCache.size
          }
        }
      };

      console.log(`[TRANSACTION] Adding transaction ${transactionId} to active transactions`);
      transactionState.activeTransactions.set(transactionId, transaction);
      console.log(`[TRANSACTION] Active transactions now contains: ${Array.from(transactionState.activeTransactions.keys()).join(', ')}`);
      // saveTransactionState(transactionState); // Not needed with session-based storage
      
      const processingTime = Date.now() - startTime;
      trackPerformance('beginTransaction', startTime, false);
      console.log(`[TIMING] beginTransaction completed in ${processingTime}ms`);

      return {
        success: true,
        transactionId: transactionId,
        description: description,
        dryRun: dryRun,
        initialUndoAvailable: initialUndoState.canUndo,
        preValidation: preValidation ? {
          health: preValidation.overallHealth,
          errorCount: preValidation.errors.length,
          warningCount: preValidation.warnings.length
        } : null
      };

    } catch (error) {
      console.log(`[ERROR] beginTransaction failed: ${error.message}`);
      throw new Error(`Failed to begin transaction: ${error.message}`);
    }
  };

  lib.executeTransactional = function({
    operations = [],
    description = 'Batch hierarchy operations',
    validateBefore = true,
    validateAfter = true,
    dryRun = false,
    rollbackOnError = true,
    maxOperations = 50
  }) {
    const startTime = Date.now();
    
    try {
      if (!Array.isArray(operations) || operations.length === 0) {
        throw new Error('Operations array is required and must not be empty');
      }

      if (operations.length > maxOperations) {
        throw new Error(`Too many operations: ${operations.length} (max: ${maxOperations})`);
      }

      console.log(`[TRANSACTION] Executing transactional batch: ${operations.length} operations`);

      // Begin transaction
      const transactionResult = lib.beginTransaction({
        description: `${description} (${operations.length} operations)`,
        validateBefore: validateBefore,
        dryRun: dryRun
      });

      const transactionId = transactionResult.transactionId;
      
      console.log(`[TRANSACTION] executeTransactional looking for transaction ${transactionId}`);
      
      // Refresh transaction state to get the newly created transaction
      const currentTransactionState = getTransactionState();
      console.log(`[TRANSACTION] executeTransactional found ${currentTransactionState.activeTransactions.size} active transactions: ${Array.from(currentTransactionState.activeTransactions.keys()).join(', ')}`);
      
      const transaction = currentTransactionState.activeTransactions.get(transactionId);
      
      if (!transaction) {
        throw new Error(`Transaction ${transactionId} not found in active transactions after creation. Available: ${Array.from(currentTransactionState.activeTransactions.keys()).join(', ')}`);
      }

      const executionResults = {
        transactionId: transactionId,
        description: description,
        dryRun: dryRun,
        operationResults: [],
        summary: {
          totalOperations: operations.length,
          successfulOperations: 0,
          failedOperations: 0,
          skippedOperations: 0
        },
        rollbackPerformed: false,
        finalValidation: null
      };

      // Execute operations
      for (let i = 0; i < operations.length; i++) {
        const operation = operations[i];
        const operationStart = Date.now();

        console.log(`[TRANSACTION] Executing operation ${i + 1}/${operations.length}: ${operation.method}`);

        const operationResult = {
          index: i,
          method: operation.method,
          parameters: operation.parameters || {},
          success: false,
          result: null,
          error: null,
          duration: 0,
          skipped: false
        };

        try {
          // Validate operation method exists
          if (typeof lib[operation.method] !== 'function') {
            throw new Error(`Unknown operation method: ${operation.method}`);
          }

          // Add transaction context to operation parameters
          const operationParams = {
            ...operation.parameters,
            _transactionId: transactionId,
            _dryRun: dryRun
          };

          // Execute operation
          if (!dryRun) {
            operationResult.result = lib[operation.method](operationParams);
          } else {
            // For dry run, call validation version if available
            const validationMethod = `validate${operation.method.charAt(0).toUpperCase() + operation.method.slice(1)}`;
            if (typeof lib[validationMethod] === 'function') {
              operationResult.result = lib[validationMethod](operationParams);
            } else {
              operationResult.result = { dryRun: true, wouldExecute: true };
            }
          }

          operationResult.success = true;
          executionResults.summary.successfulOperations++;
          transaction.operationCount++;

          // Record operation in transaction
          transaction.operations.push({
            method: operation.method,
            parameters: operationParams,
            result: operationResult.result,
            timestamp: Date.now(),
            success: true
          });
          
          // Save updated transaction state
          // saveTransactionState(currentTransactionState); // Not needed with session-based storage

        } catch (error) {
          operationResult.error = error.message;
          executionResults.summary.failedOperations++;
          
          console.log(`[TRANSACTION] Operation ${i + 1} failed: ${error.message}`);

          if (rollbackOnError && !dryRun) {
            console.log(`[TRANSACTION] Rolling back transaction due to operation failure`);
            
            // Rollback transaction directly using current state
            let rollbackCount = 0;
            const maxRollbacks = transaction.operationCount;

            console.log(`[TRANSACTION] Attempting to undo ${maxRollbacks} operations`);

            while (document.canUndo && rollbackCount < maxRollbacks) {
              try {
                document.undo();
                rollbackCount++;
                console.log(`[TRANSACTION] Undo operation ${rollbackCount}/${maxRollbacks} completed`);
              } catch (undoError) {
                console.log(`[TRANSACTION] Undo failed at step ${rollbackCount}: ${undoError.message}`);
                break;
              }
            }

            // Clear caches after rollback
            invalidateOrganizationalCache('global', null);

            // Update transaction state
            transaction.status = 'rolled_back';
            transaction.endTime = Date.now();
            transaction.duration = transaction.endTime - transaction.startTime;

            // Move to history
            currentTransactionState.transactionHistory.push(transaction);
            currentTransactionState.activeTransactions.delete(transactionId);
            
            // saveTransactionState(currentTransactionState); // Not needed with session-based storage
            
            const rollbackResult = {
              success: true,
              transactionId: transactionId,
              status: 'rolled_back',
              operationCount: transaction.operationCount,
              rollbackCount: rollbackCount,
              finalUndoAvailable: document.canUndo
            };
            
            executionResults.rollbackPerformed = true;
            executionResults.rollbackResult = rollbackResult;
            break;
          } else if (dryRun) {
            operationResult.skipped = true;
            executionResults.summary.skippedOperations++;
          }
        }

        operationResult.duration = Date.now() - operationStart;
        executionResults.operationResults.push(operationResult);
      }

      // Post-execution validation
      if (validateAfter && !executionResults.rollbackPerformed && !dryRun) {
        console.log(`[TRANSACTION] Performing post-transaction validation...`);
        executionResults.finalValidation = lib.validateHierarchyIntegrity({
          validationLevel: 'standard',
          includeRepairSuggestions: false
        });
      }

      // Auto-accept transaction and add to rollback history
      if (!executionResults.rollbackPerformed) {
        // Accept transaction directly using current state (avoid state reload issues)
        console.log(`[TRANSACTION] Accepting transaction ${transactionId}`);
        
        // Update transaction state
        transaction.status = 'accepted';
        transaction.endTime = Date.now();
        transaction.duration = transaction.endTime - transaction.startTime;
        
        // Enhanced rollback metadata for recent transaction rollback
        transaction.rollbackExpiry = Date.now() + (currentTransactionState.rollbackTimeoutMinutes * 60 * 1000);
        transaction.canRollback = true;
        transaction.rollbackMetadata = {
          operationCount: transaction.operationCount,
          capturedAt: Date.now(),
          undoAvailable: document.canUndo
        };

        // Move to history
        currentTransactionState.transactionHistory.push(transaction);
        currentTransactionState.activeTransactions.delete(transactionId);

        // Clean up history if needed
        if (currentTransactionState.transactionHistory.length > currentTransactionState.maxHistorySize) {
          currentTransactionState.transactionHistory.shift();
        }
        
        // saveTransactionState(currentTransactionState); // Not needed with session-based storage
        
        const acceptResult = {
          success: true,
          transactionId: transactionId,
          status: 'accepted',
          operationCount: transaction.operationCount,
          duration: transaction.duration
        };
        
        executionResults.acceptResult = acceptResult;
      }

      const processingTime = Date.now() - startTime;
      trackPerformance('executeTransactional', startTime, false);
      console.log(`[TIMING] executeTransactional completed in ${processingTime}ms`);

      return executionResults;

    } catch (error) {
      console.log(`[ERROR] executeTransactional failed: ${error.message}`);
      throw new Error(`Failed to execute transactional operations: ${error.message}`);
    }
  };

  lib.acceptTransaction = function({
    transactionId = null,
    validateAfter = false
  }) {
    const startTime = Date.now();
    
    try {
      // Refresh transaction state from persistent storage
      const transactionState = getTransactionState();
      
      if (!transactionId) {
        throw new Error('Transaction ID is required');
      }

      const transaction = transactionState.activeTransactions.get(transactionId);
      if (!transaction) {
        throw new Error(`Transaction not found: ${transactionId}`);
      }

      if (transaction.status !== 'active') {
        throw new Error(`Cannot accept transaction in status: ${transaction.status}`);
      }

      console.log(`[TRANSACTION] Accepting transaction ${transactionId}`);

      // Final validation if requested
      let finalValidation = null;
      if (validateAfter && !transaction.dryRun) {
        finalValidation = lib.validateHierarchyIntegrity({
          validationLevel: 'standard',
          includeRepairSuggestions: false
        });

        if (finalValidation.overallHealth === 'critical') {
          console.log(`[TRANSACTION] Final validation failed - rolling back transaction`);
          return lib.rollbackTransaction({ transactionId: transactionId });
        }
      }

      // Update transaction state
      transaction.status = 'accepted';
      transaction.endTime = Date.now();
      transaction.duration = transaction.endTime - transaction.startTime;
      transaction.finalValidation = finalValidation;
      
      // Enhanced rollback metadata for recent transaction rollback
      transaction.rollbackExpiry = Date.now() + (transactionState.rollbackTimeoutMinutes * 60 * 1000);
      transaction.canRollback = true;
      transaction.rollbackMetadata = {
        operationCount: transaction.operationCount,
        capturedAt: Date.now(),
        undoAvailable: document.canUndo
      };

      // Move to history
      transactionState.transactionHistory.push(transaction);
      transactionState.activeTransactions.delete(transactionId);

      // Clean up history if needed
      if (transactionState.transactionHistory.length > transactionState.maxHistorySize) {
        transactionState.transactionHistory.shift();
      }
      
      // saveTransactionState(transactionState); // Not needed with session-based storage

      // Note: OmniFocus automatically saves changes - no manual save needed
      // Removed document.save() to prevent "document changed by another application" dialog

      const processingTime = Date.now() - startTime;
      trackPerformance('acceptTransaction', startTime, false);
      console.log(`[TIMING] acceptTransaction completed in ${processingTime}ms`);

      return {
        success: true,
        transactionId: transactionId,
        status: 'accepted',
        operationCount: transaction.operationCount,
        duration: transaction.duration,
        finalValidation: finalValidation ? {
          health: finalValidation.overallHealth,
          errorCount: finalValidation.errors.length,
          warningCount: finalValidation.warnings.length
        } : null
      };

    } catch (error) {
      console.log(`[ERROR] acceptTransaction failed: ${error.message}`);
      throw new Error(`Failed to accept transaction: ${error.message}`);
    }
  };

  lib.rollbackTransaction = function({
    transactionId = null
  }) {
    const startTime = Date.now();
    
    try {
      // Refresh transaction state from persistent storage
      const transactionState = getTransactionState();
      
      if (!transactionId) {
        throw new Error('Transaction ID is required');
      }

      const transaction = transactionState.activeTransactions.get(transactionId);
      if (!transaction) {
        throw new Error(`Transaction not found: ${transactionId}`);
      }

      console.log(`[TRANSACTION] Rolling back transaction ${transactionId}`);

      if (transaction.dryRun) {
        // For dry runs, just mark as rolled back
        transaction.status = 'rolled_back';
        transaction.endTime = Date.now();
        transaction.duration = transaction.endTime - transaction.startTime;
        
        transactionState.transactionHistory.push(transaction);
        transactionState.activeTransactions.delete(transactionId);

        return {
          success: true,
          transactionId: transactionId,
          status: 'rolled_back',
          operationCount: transaction.operationCount,
          rollbackCount: 0,
          dryRun: true
        };
      }

      // Use OmniFocus built-in undo to rollback operations
      let rollbackCount = 0;
      const maxRollbacks = transaction.operationCount; // Undo exactly the operations we performed

      console.log(`[TRANSACTION] Attempting to undo ${maxRollbacks} operations`);

      while (document.canUndo && rollbackCount < maxRollbacks) {
        try {
          document.undo();
          rollbackCount++;
          transaction.rollbackCount++;
          console.log(`[TRANSACTION] Undo operation ${rollbackCount}/${maxRollbacks} completed`);
        } catch (undoError) {
          console.log(`[TRANSACTION] Undo failed at step ${rollbackCount}: ${undoError.message}`);
          break;
        }
      }

      // Clear caches after rollback
      invalidateOrganizationalCache('global', null);

      // Update transaction state
      transaction.status = 'rolled_back';
      transaction.endTime = Date.now();
      transaction.duration = transaction.endTime - transaction.startTime;

      // Move to history
      transactionState.transactionHistory.push(transaction);
      transactionState.activeTransactions.delete(transactionId);
      
      // saveTransactionState(transactionState); // Not needed with session-based storage

      const processingTime = Date.now() - startTime;
      trackPerformance('rollbackTransaction', startTime, false);
      console.log(`[TIMING] rollbackTransaction completed in ${processingTime}ms`);

      return {
        success: true,
        transactionId: transactionId,
        status: 'rolled_back',
        operationCount: transaction.operationCount,
        rollbackCount: rollbackCount,
        finalUndoAvailable: document.canUndo
      };

    } catch (error) {
      console.log(`[ERROR] rollbackTransaction failed: ${error.message}`);
      throw new Error(`Failed to rollback transaction: ${error.message}`);
    }
  };

  lib.rollbackRecentTransaction = function({
    transactionId = null,
    findByDescription = null,
    maxUndoOperations = 20
  }) {
    const startTime = Date.now();
    
    try {
      const transactionState = getTransactionState();
      
      // Clean up expired transactions first
      cleanupExpiredTransactions();

      let transaction = null;
      let rollbackOperations = maxUndoOperations; // Default fallback
      
      if (transactionId) {
        // Find by specific transaction ID
        transaction = transactionState.transactionHistory.find(t => t.id === transactionId);
        if (!transaction) {
          console.log(`[TRANSACTION] Transaction ${transactionId} not found in session history, attempting general undo`);
        } else {
          rollbackOperations = transaction.rollbackMetadata ? transaction.rollbackMetadata.operationCount : maxUndoOperations;
        }
      } else if (findByDescription) {
        // Find most recent transaction matching description
        const matches = transactionState.transactionHistory
          .filter(t => t.description.toLowerCase().includes(findByDescription.toLowerCase()))
          .sort((a, b) => b.endTime - a.endTime);
        
        if (matches.length > 0) {
          transaction = matches[0];
          rollbackOperations = transaction.rollbackMetadata ? transaction.rollbackMetadata.operationCount : maxUndoOperations;
        } else {
          console.log(`[TRANSACTION] No transactions matching "${findByDescription}" found in session, attempting general undo`);
        }
      } else {
        // Find most recent accepted transaction
        const recentAccepted = transactionState.transactionHistory
          .filter(t => t.status === 'accepted')
          .sort((a, b) => b.endTime - a.endTime);
        
        if (recentAccepted.length > 0) {
          transaction = recentAccepted[0];
          rollbackOperations = transaction.rollbackMetadata ? transaction.rollbackMetadata.operationCount : maxUndoOperations;
        } else {
          console.log(`[TRANSACTION] No recent transactions found in session, attempting general undo of ${maxUndoOperations} operations`);
        }
      }

      // If we have a transaction, check rollback expiry
      if (transaction) {
        const now = Date.now();
        if (!transaction.canRollback || (transaction.rollbackExpiry && now > transaction.rollbackExpiry)) {
          const expiredMinutes = Math.round((now - transaction.rollbackExpiry) / (60 * 1000));
          console.log(`[TRANSACTION] Transaction ${transaction.id} expired ${expiredMinutes} minutes ago, attempting general undo`);
          transaction = null; // Proceed with general undo
        }

        if (transaction && transaction.status !== 'accepted') {
          console.log(`[TRANSACTION] Transaction ${transaction.id} status is ${transaction.status}, attempting general undo`);
          transaction = null; // Proceed with general undo
        }
      }

      console.log(`[TRANSACTION] Rolling back operations - targeting ${rollbackOperations} undo operations`);

      // Use OmniFocus built-in undo to rollback operations
      let rollbackCount = 0;
      const maxRollbacks = rollbackOperations;

      console.log(`[TRANSACTION] Attempting to undo up to ${maxRollbacks} operations`);

      while (document.canUndo && rollbackCount < maxRollbacks) {
        try {
          document.undo();
          rollbackCount++;
          console.log(`[TRANSACTION] Undo operation ${rollbackCount}/${maxRollbacks} completed`);
        } catch (undoError) {
          console.log(`[TRANSACTION] Undo failed at step ${rollbackCount}: ${undoError.message}`);
          break;
        }
      }

      // Clear caches after rollback
      invalidateOrganizationalCache('global', null);

      // Update transaction state if we found one
      if (transaction) {
        transaction.status = 'rolled_back';
        transaction.canRollback = false;
        transaction.rollbackCount = rollbackCount;
        transaction.rollbackTime = Date.now();
        
        // saveTransactionState(transactionState); // Not needed with session-based storage
      }

      const processingTime = Date.now() - startTime;
      trackPerformance('rollbackRecentTransaction', startTime, false);
      console.log(`[TIMING] rollbackRecentTransaction completed in ${processingTime}ms`);

      return {
        success: true,
        transactionId: transaction ? transaction.id : 'unknown',
        description: transaction ? transaction.description : `General undo of ${rollbackCount} operations`,
        status: 'rolled_back',
        originalOperationCount: rollbackOperations,
        rollbackCount: rollbackCount,
        rollbackCompleted: rollbackCount >= Math.min(maxRollbacks, rollbackOperations),
        finalUndoAvailable: document.canUndo,
        usedGeneralUndo: !transaction
      };

    } catch (error) {
      console.log(`[ERROR] rollbackRecentTransaction failed: ${error.message}`);
      throw new Error(`Failed to rollback recent transaction: ${error.message}`);
    }
  };

  function cleanupExpiredTransactions() {
    const now = Date.now();
    const initialCount = transactionState.transactionHistory.length;
    
    // Mark expired transactions as no longer rollback-able
    let expiredCount = 0;
    transactionState.transactionHistory.forEach(transaction => {
      if (transaction.canRollback && transaction.rollbackExpiry && now > transaction.rollbackExpiry) {
        transaction.canRollback = false;
        expiredCount++;
        console.log(`[TRANSACTION] Transaction ${transaction.id} rollback capability expired`);
      }
    });
    
    if (expiredCount > 0) {
      // saveTransactionState(transactionState); // Not needed with session-based storage
    }

    // Remove very old transactions to prevent memory bloat
    const maxAge = 24 * 60 * 60 * 1000; // 24 hours
    transactionState.transactionHistory = transactionState.transactionHistory.filter(t => {
      return (now - t.endTime) < maxAge;
    });

    const cleanedCount = initialCount - transactionState.transactionHistory.length;
    if (cleanedCount > 0) {
      console.log(`[TRANSACTION] Cleaned up ${cleanedCount} old transactions`);
      // saveTransactionState(transactionState); // Not needed with session-based storage
    }
  }

  lib.getTransactionHistory = function({
    includeActive = true,
    maxResults = 20,
    status = null // 'active', 'accepted', 'rolled_back', or null for all
  }) {
    const startTime = Date.now();
    
    try {
      // Refresh transaction state from persistent storage
      const transactionState = getTransactionState();
      
      let transactions = [];

      // Add active transactions if requested
      if (includeActive) {
        transactions.push(...Array.from(transactionState.activeTransactions.values()));
      }

      // Add historical transactions
      transactions.push(...transactionState.transactionHistory);

      // Filter by status if specified
      if (status) {
        transactions = transactions.filter(t => t.status === status);
      }

      // Sort by start time (newest first) and limit results
      transactions.sort((a, b) => b.startTime - a.startTime);
      transactions = transactions.slice(0, maxResults);

      // Clean up expired transactions before showing history
      cleanupExpiredTransactions();

      // Format for output
      const formattedTransactions = transactions.map(t => ({
        id: t.id,
        description: t.description,
        status: t.status,
        startTime: new Date(t.startTime).toISOString(),
        endTime: t.endTime ? new Date(t.endTime).toISOString() : null,
        duration: t.duration || (Date.now() - t.startTime),
        operationCount: t.operationCount,
        rollbackCount: t.rollbackCount || 0,
        canRollback: t.canRollback || false,
        rollbackExpiresIn: t.rollbackExpiry ? Math.max(0, Math.round((t.rollbackExpiry - Date.now()) / (60 * 1000))) : null,
        dryRun: t.dryRun,
        preValidation: t.preValidation ? {
          health: t.preValidation.overallHealth,
          errorCount: t.preValidation.errors.length,
          warningCount: t.preValidation.warnings.length
        } : null,
        finalValidation: t.finalValidation ? {
          health: t.finalValidation.overallHealth,
          errorCount: t.finalValidation.errors.length,
          warningCount: t.finalValidation.warnings.length
        } : null
      }));

      const processingTime = Date.now() - startTime;
      trackPerformance('getTransactionHistory', startTime, true);
      console.log(`[TIMING] getTransactionHistory completed in ${processingTime}ms`);

      return {
        transactions: formattedTransactions,
        totalCount: formattedTransactions.length,
        activeTransactions: transactionState.activeTransactions.size,
        historySize: transactionState.transactionHistory.length
      };

    } catch (error) {
      console.log(`[ERROR] getTransactionHistory failed: ${error.message}`);
      throw new Error(`Failed to get transaction history: ${error.message}`);
    }
  };

  lib.validateTransaction = function({
    operations = [],
    description = 'Transaction validation',
    performDeepValidation = true
  }) {
    const startTime = Date.now();
    
    try {
      if (!Array.isArray(operations) || operations.length === 0) {
        throw new Error('Operations array is required and must not be empty');
      }

      console.log(`[TRANSACTION] Validating transaction: ${operations.length} operations`);

      const validationResults = {
        description: description,
        operationCount: operations.length,
        operationValidations: [],
        overallValid: true,
        riskLevel: 'minimal',
        estimatedDuration: 0,
        preTransactionValidation: null,
        potentialIssues: [],
        recommendations: []
      };

      // Pre-transaction hierarchy validation
      if (performDeepValidation) {
        validationResults.preTransactionValidation = lib.validateHierarchyIntegrity({
          validationLevel: 'standard',
          includeRepairSuggestions: false
        });

        if (validationResults.preTransactionValidation.overallHealth === 'critical') {
          validationResults.overallValid = false;
          validationResults.riskLevel = 'high';
          validationResults.potentialIssues.push({
            type: 'critical_hierarchy_state',
            severity: 'critical',
            description: 'Hierarchy is in critical state before transaction',
            recommendation: 'Repair hierarchy integrity before attempting transaction'
          });
        }
      }

      // Validate each operation
      let totalRiskScore = 0;
      for (let i = 0; i < operations.length; i++) {
        const operation = operations[i];
        
        const operationValidation = {
          index: i,
          method: operation.method,
          parameters: operation.parameters || {},
          valid: true,
          riskLevel: 'minimal',
          estimatedDuration: 100, // Base duration in ms
          issues: [],
          dependencies: []
        };

        // Check if method exists
        if (typeof lib[operation.method] !== 'function') {
          operationValidation.valid = false;
          operationValidation.riskLevel = 'high';
          operationValidation.issues.push({
            type: 'unknown_method',
            severity: 'critical',
            description: `Unknown operation method: ${operation.method}`
          });
          validationResults.overallValid = false;
        } else {
          // Method-specific validation
          const methodValidation = validateOperationMethod(operation.method, operation.parameters);
          operationValidation.valid = methodValidation.valid;
          operationValidation.riskLevel = methodValidation.riskLevel;
          operationValidation.estimatedDuration = methodValidation.estimatedDuration;
          operationValidation.issues.push(...methodValidation.issues);
          operationValidation.dependencies.push(...methodValidation.dependencies);

          if (!methodValidation.valid) {
            validationResults.overallValid = false;
          }
        }

        // Update risk scoring
        const riskScores = { minimal: 1, low: 2, medium: 4, high: 8 };
        totalRiskScore += riskScores[operationValidation.riskLevel] || 1;

        validationResults.operationValidations.push(operationValidation);
        validationResults.estimatedDuration += operationValidation.estimatedDuration;
      }

      // Calculate overall risk level
      const avgRiskScore = totalRiskScore / operations.length;
      if (avgRiskScore >= 6) validationResults.riskLevel = 'high';
      else if (avgRiskScore >= 3) validationResults.riskLevel = 'medium';
      else if (avgRiskScore >= 1.5) validationResults.riskLevel = 'low';

      // Generate recommendations
      if (validationResults.riskLevel === 'high') {
        validationResults.recommendations.push('Consider executing operations individually with validation between each step');
        validationResults.recommendations.push('Ensure database backup is available before proceeding');
      }
      
      if (validationResults.estimatedDuration > 10000) {
        validationResults.recommendations.push('Consider breaking transaction into smaller batches for better performance');
      }

      const processingTime = Date.now() - startTime;
      trackPerformance('validateTransaction', startTime, false);
      console.log(`[TIMING] validateTransaction completed in ${processingTime}ms`);

      return validationResults;

    } catch (error) {
      console.log(`[ERROR] validateTransaction failed: ${error.message}`);
      throw new Error(`Failed to validate transaction: ${error.message}`);
    }
  };

  // Note: OmniFocus doesn't provide direct access to undo stack depth
  // We use operation counting for rollback instead of stack depth tracking

  // Helper function to validate operation methods
  function validateOperationMethod(method, parameters) {
    const validation = {
      valid: true,
      riskLevel: 'minimal',
      estimatedDuration: 100,
      issues: [],
      dependencies: []
    };

    switch (method) {
      case 'moveTask':
        if (!parameters.taskId) {
          validation.valid = false;
          validation.issues.push({
            type: 'missing_parameter',
            severity: 'critical',
            description: 'taskId parameter is required'
          });
        }
        validation.riskLevel = 'low';
        validation.estimatedDuration = 200;
        break;

      case 'restructureTaskHierarchy':
        if (!parameters.operations || !Array.isArray(parameters.operations)) {
          validation.valid = false;
          validation.issues.push({
            type: 'missing_parameter',
            severity: 'critical',
            description: 'operations array is required'
          });
        }
        validation.riskLevel = 'medium';
        validation.estimatedDuration = 500;
        break;

      case 'flattenTaskHierarchy':
        validation.riskLevel = 'medium';
        validation.estimatedDuration = 300;
        break;

      // Add more method-specific validations as needed
      default:
        validation.riskLevel = 'low';
        validation.estimatedDuration = 150;
    }

    return validation;
  }

  lib.request = raw => {
    let msg;
    try { msg = JSON.parse(raw); }
    catch (e) { throw new Error("Invalid JSON: " + e); }
    const fn = msg.method, params = msg.params || {};
    if (typeof lib[fn] !== "function") throw new Error("Unknown method '" + fn + "'");
    return JSON.stringify({ result: lib[fn](params) });
  };

  return lib;
})();