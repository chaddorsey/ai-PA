  function generateSimplifiedShortcuts(enrichedItems) {
    // Very basic shortcut generation for performance
    const processableItems = enrichedItems
      .filter(item => item.content_type === 'standard')
      .map(item => item.id);
    
    const emailItems = enrichedItems
      .filter(item => item.content_type === 'email')
      .map(item => item.id);
    
    return {
      processable_items: processableItems,
      email_items: emailItems,
      total_items: enrichedItems.length,
      common_operations: [
        { shortcut: 'a', description: 'Process all standard items', command_template: 'process {processable_items}' },
        { shortcut: 'e', description: 'Review email items', command_template: 'review {email_items}' }
      ]
    };
  }

  function generateSuggestedShortcuts(enrichedItems) {
    const highConfidenceItems = enrichedItems
      .filter(item => item.suggested_projects.length > 0 && item.suggested_projects[0].confidence > 0.7)
      .map(item => item.id);
    
    const uncertainItems = enrichedItems
      .filter(item => item.suggested_projects.length === 0 || item.suggested_projects[0].confidence < 0.5)
      .map(item => item.id);
    
    return {
      high_confidence_items: highConfidenceItems,
      uncertain_items: uncertainItems,
      merge_suggestions: [], // Could be enhanced
      common_operations: [
        { shortcut: 'a', description: 'Accept all high confidence suggestions', command_template: 'accept {high_confidence_items}' },
        { shortcut: 'r', description: 'Review uncertain items', command_template: 'review {uncertain_items}' }
      ]
    };
  }

  // Smart project activity scoring for inbox processing suggestions
  function calculateProjectActivityScore(project) {
    const now = new Date();
    let score = 0;
    
    // Base score for active projects
    if (project.status && project.status.name === 'Active') {
      score += 10;
    } else if (project.completed) {
      return 0; // Don't suggest completed projects
    } else {
      score += 5; // On hold, dropped, etc.
    }
    
    // Recent modification scoring (most important factor)
    if (project.modified) {
      const modifiedAge = (now - project.modified) / (1000 * 60 * 60 * 24); // days
      if (modifiedAge <= 1) score += 50; // Modified today
      else if (modifiedAge <= 3) score += 30; // Modified within 3 days
      else if (modifiedAge <= 7) score += 20; // Modified within a week
      else if (modifiedAge <= 30) score += 10; // Modified within a month
      else if (modifiedAge <= 90) score += 3; // Modified within 3 months
      // Projects older than 3 months get no modification boost
    }
    
    // Recent review activity
    if (project.lastReviewDate) {
      const reviewAge = (now - project.lastReviewDate) / (1000 * 60 * 60 * 24); // days
      if (reviewAge <= 7) score += 15; // Reviewed within a week
      else if (reviewAge <= 30) score += 8; // Reviewed within a month
      else if (reviewAge <= 90) score += 3; // Reviewed within 3 months
    }
    
    // Active task count (indicates current relevance)
    if (project.flattenedTasks) {
      const activeTasks = Array.from(project.flattenedTasks).filter(t => !t.completed && t.effectiveActive);
      const activeTaskCount = activeTasks.length;
      
      if (activeTaskCount > 10) score += 15; // Very active project
      else if (activeTaskCount > 5) score += 10; // Active project  
      else if (activeTaskCount > 2) score += 5; // Some activity
      else if (activeTaskCount === 0) score -= 5; // No active tasks
      
      // Recent task activity within the project
      const recentTaskActivity = getRecentTaskActivity(activeTasks);
      score += recentTaskActivity;
    }
    
    // Age penalty for very old projects without recent activity
    if (project.added) {
      const projectAge = (now - project.added) / (1000 * 60 * 60 * 24); // days
      if (projectAge > 365 && score < 20) { // Old project without much recent activity
        score -= 10;
      }
    }
    
    return Math.max(0, score); // Ensure non-negative score
  }

  function getRecentTaskActivity(tasks) {
    if (!tasks || tasks.length === 0) return 0;
    
    const now = new Date();
    let activityScore = 0;
    
    for (const task of tasks) {
      // Check task creation date (most recent tasks)
      if (task.added) {
        const taskAge = (now - task.added) / (1000 * 60 * 60 * 24); // days
        if (taskAge <= 1) activityScore += 8; // Added today
        else if (taskAge <= 3) activityScore += 5; // Added within 3 days
        else if (taskAge <= 7) activityScore += 3; // Added within a week
        else if (taskAge <= 30) activityScore += 1; // Added within a month
      }
      
      // Check task modification date
      if (task.modified) {
        const modAge = (now - task.modified) / (1000 * 60 * 60 * 24); // days
        if (modAge <= 1) activityScore += 3; // Modified today
        else if (modAge <= 7) activityScore += 1; // Modified within a week
      }
    }
    
    return Math.min(activityScore, 25); // Cap task activity contribution
  }

