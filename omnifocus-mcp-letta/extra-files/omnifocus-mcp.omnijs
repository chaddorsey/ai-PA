  function getLastTaskAddedDate(project) {
    const tasks = Array.from(project.flattenedTasks);
    if (tasks.length === 0) return null;
    
    const latestTask = tasks.reduce((latest, task) => {
      return (!latest || (task.creationDate && (!latest.creationDate || task.creationDate > latest.creationDate))) ? task : latest;
    });
    
    return latestTask.creationDate ? latestTask.creationDate.toISOString() : null;
  }

  function getCategoryFromTagName(tagName) {
    // Simple category detection based on common patterns
    if (tagName.startsWith('@')) {
      return 'context';
    } else if (tagName.toLowerCase().includes('priority') || tagName.toLowerCase().includes('urgent')) {
      return 'priority';
    }
    return 'general';
  }

  function getTagUsageFrequency(tag) {
    // Count tasks with this tag
    return flattenedTasks.filter(t => t.tags.some(taskTag => bareId(taskTag.id) === bareId(tag.id))).length;
  }

