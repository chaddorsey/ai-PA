<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omnifocus.bridge.startup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>if [ -f /Volumes/main-drive/ai-PA/omnifocus-mcp-letta/ensure-bridge-running.sh ]; then exec /Volumes/main-drive/ai-PA/omnifocus-mcp-letta/ensure-bridge-running.sh; else exit 0; fi</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>~/Library/Logs/omnifocus-bridge-startup.log</string>
    <key>StandardErrorPath</key>
    <string>~/Library/Logs/omnifocus-bridge-startup.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
