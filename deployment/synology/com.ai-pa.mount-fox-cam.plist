<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-pa.mount-fox-cam</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/main-drive/ai-PA/deployment/synology/mount-fox-cam.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/var/log/ai-pa-mount-fox-cam.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/ai-pa-mount-fox-cam.log</string>
</dict>
</plist>
