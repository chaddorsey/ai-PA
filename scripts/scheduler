#!/usr/bin/env bash
# scheduler — scheduler-service job-management CLI for local-mode agents.
#
# Replaces the 7 scheduler-mcp tools (scheduler_list_jobs,
# scheduler_search_jobs, scheduler_get_job, scheduler_update_job,
# scheduler_delete_job, scheduler_archive_job, scheduler_list_executions)
# plus the trigger-now operation. Underlying scheduler-service REST API
# is unchanged — this is a thin shell over it.
#
# `scheduler create` (added 2026-08-12): agents CAN create jobs. Safety is
# audit-based, not restriction: every created job is auto-tagged
# category=agent-created + created_by, and `scheduler cancel-all` wipes them
# in one shot. Execution runs with the scheduler-service's privileges (not the
# agent's); script actions are already confined to the allow-listed scripts
# dir at execution; http is unrestricted (accepted). See
# docs/plans/2026-08-12-agent-scheduler-create-design.md.
#
# Usage:
#   scheduler list [--status <st>] [--category <cat>] [--created-by <u>]
#                  [--include-archived] [--limit <n>]
#   scheduler search <query>
#   scheduler get <job-id>
#   scheduler update <job-id> [--title <t>] [--description <d>]
#   scheduler delete <job-id>
#   scheduler archive <job-id> [<job-id>...]
#   scheduler executions <job-id> [--limit <n>]
#   scheduler trigger <job-id>
#   scheduler --help
#
# Env:
#   SCHEDULER_BASE_URL   defaults to http://localhost:8087
#                        (use http://scheduler-service:8087 from Docker network)
#   SCHEDULER_API_KEY    optional; sent as Authorization: Bearer <key>
#                        if scheduler-service is configured to require it

set -euo pipefail

SCHED="${SCHEDULER_BASE_URL:-http://localhost:8087}"

# ─── helpers ────────────────────────────────────────────────────────────────

die() { echo "ERROR: $*" >&2; exit 2; }

auth_header() {
  if [[ -n "${SCHEDULER_API_KEY:-}" ]]; then
    echo "Authorization: Bearer ${SCHEDULER_API_KEY}"
  fi
}

# Make an authenticated curl call with proper error handling
sched_curl() {
  local method="$1" path="$2"; shift 2
  local body="${1:-}"
  local resp http_code
  resp="$(mktemp)"
  local auth
  auth="$(auth_header)"

  local curl_args=(-sS --max-time 30 -o "$resp" -w '%{http_code}'
                   -X "$method"
                   -H "Content-Type: application/json")
  [[ -n "$auth" ]] && curl_args+=(-H "$auth")
  [[ -n "$body" ]] && curl_args+=(-d "$body")

  http_code="$(curl "${curl_args[@]}" "${SCHED}${path}")"

  if [[ "$http_code" =~ ^2 ]]; then
    cat "$resp"
    rm -f "$resp"
    return 0
  else
    echo "ERROR ($http_code): $(cat "$resp")" >&2
    rm -f "$resp"
    return 3
  fi
}

usage() {
  cat <<'EOF'
scheduler — manage scheduler-service jobs from a shell

Subcommands:

  create --title T <schedule> <action> [opts]   Create a new job
    schedule (one of): --cron "0 6 * * *" | --every <seconds>
                       | --at <ISO8601> | --when "<natural language>"
                       | --schedule-json '{...}'
                       (--when phrases must be parser-recognized, e.g.
                        "every 5 minutes"; if rejected, use --cron)
    action   (one of): --message "<text>" --to-agent <id>
                       | --script <name> [--args '<json array>']
                       | --http <url> [--method POST] [--body '<str>']
                       | --action-json '{...}'
    --description D    --category C (default: agent-created)
    --created-by U     (default: $SCHEDULER_CREATED_BY or "agent")
    Jobs are auto-tagged category=agent-created + created_by; undo with
    `scheduler cancel-all`. (execution uses scheduler-service privileges)

  list [opts]                 List scheduled jobs
    --status <st>             scheduled | paused | cancelled | completed | active
    --category <cat>          filter by category
    --created-by <user>       filter by creator
    --include-archived        include archived jobs (only with --status active)
    --limit <n>               cap (default 50)
    --format <fmt>            json (default) | table

  search <query>              Semantic search by title/description

  get <job-id>                Show full job record (JSON)

  update <job-id> [opts]      Modify an existing job
    --title <text>
    --description <text>
    --status <st>             scheduled | paused | cancelled

  delete <job-id>             Cancel a job (status → cancelled)

  cancel-all [opts]           Bulk-cancel matching scheduled jobs (undo lever)
    --category <cat>          default: agent-created
    --created-by <user>       filter by creator
    --yes / -y                skip the confirmation prompt (for agents)

  archive <job-id> [<job-id>...]
                              Archive one or more jobs

  executions <job-id> [opts]  List execution history for a job
    --limit <n>               cap (default 20)

  trigger <job-id>            Run a job immediately (creates an execution)

  --help

Examples:

  # List scheduled jobs for the calendar agent
  scheduler list --status scheduled --created-by calendar-agent --format table

  # Find a job by title
  scheduler search "morning briefing"

  # Pause a job
  scheduler update <job-id> --status paused

  # Run a job right now (for testing)
  scheduler trigger <job-id>

  # Let an agent schedule a weekday-morning reminder (auto-tagged agent-created)
  scheduler create --title "Reminder: review SOW" --cron "0 9 * * 1-5" \
    --message "Please review the SOW draft" --to-agent agent-local-30c45759-...

  # Schedule an hourly allow-listed script
  scheduler create --title "Hourly export" --every 3600 --script "run-export.sh"

  # Undo everything agents have scheduled
  scheduler cancel-all --category agent-created --yes

  # Focused help for a command:  scheduler create --help  /  scheduler cancel-all --help
EOF
}

# ─── focused per-command help (progressive disclosure) ────────────────────────

create_help() {
  cat <<'EOF'
scheduler create — create a new scheduled job (auto-tagged for audit)

Synopsis:
  scheduler create --title T <SCHEDULE> <ACTION> [--description D] [--category C] [--created-by U]

Schedule (exactly one):
  --cron "M H D M W"        cron, e.g. "0 6 * * *" (6am daily)
  --every <seconds>         interval, e.g. --every 3600 (hourly)
  --at <ISO8601>            one-off, e.g. --at "2026-09-01T14:00:00Z"
  --when "<phrase>"         natural language; must be parser-recognized
                            (e.g. "every 5 minutes"); if rejected, use --cron
  --schedule-json '{...}'   raw {type,expression[,next_run_at,timezone]}

Action (exactly one):
  --message "<text>" --to-agent <agent-id>        message a Letta agent
  --script <name> [--args '<json-array>']         run an allow-listed script
  --http <url> [--method POST] [--body '<str>']   HTTP request
  --action-json '{...}'                           raw {action_type,config}

Audit: category defaults to "agent-created", created_by to $SCHEDULER_CREATED_BY
or "agent". Undo with `scheduler cancel-all`. Jobs execute with the
scheduler-service's privileges (script actions are allow-list-confined; http is open).

Examples:
  scheduler create --title "Nudge" --cron "0 9 * * 1-5" \
    --message "Review the SOW" --to-agent agent-local-30c45759-...
  scheduler create --title "Hourly export" --every 3600 --script "run-export.sh"
EOF
}

cancelall_help() {
  cat <<'EOF'
scheduler cancel-all — bulk-cancel matching scheduled jobs (the undo lever)

Synopsis:
  scheduler cancel-all [--category C] [--created-by U] [--yes]

  --category <cat>       default: agent-created (what `create` tags)
  --created-by <user>    further filter by creator
  --yes / -y             skip the confirmation prompt (for agents)

Cancels all currently-scheduled jobs matching the filter.
Example:
  scheduler cancel-all --created-by pulse-agent --yes
EOF
}

# ─── list ───────────────────────────────────────────────────────────────────

cmd_list() {
  local status="" category="" created_by="" include_archived=0 limit=50 fmt=json
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status)             status="$2";       shift 2 ;;
      --category)           category="$2";     shift 2 ;;
      --created-by)         created_by="$2";   shift 2 ;;
      --include-archived)   include_archived=1; shift   ;;
      --limit)              limit="$2";        shift 2 ;;
      --format)             fmt="$2";          shift 2 ;;
      -h|--help)            usage; exit 0 ;;
      *)                    die "unknown flag: $1" ;;
    esac
  done

  local qs=""
  [[ -n "$status" ]]     && qs+="&status_filter=${status}"
  [[ -n "$category" ]]   && qs+="&category_filter=${category}"
  [[ -n "$created_by" ]] && qs+="&created_by_filter=${created_by}"
  (( include_archived )) && qs+="&include_archived=true"
  qs+="&limit=${limit}"
  qs="?${qs#&}"

  local out
  out="$(sched_curl GET "/v1/jobs${qs}")"

  if [[ "$fmt" == "table" ]]; then
    echo "$out" | jq -r '
      (. // .jobs // [])[] |
      "\(.job_id)\t\(.status)\t\(.next_run_at // "—")\t\(.title)"
    ' | column -t -s $'\t'
    echo "($(echo "$out" | jq '(. // .jobs // []) | length') jobs)"
  else
    echo "$out" | jq .
  fi
}

# ─── search ─────────────────────────────────────────────────────────────────

cmd_search() {
  [[ $# -ge 1 ]] || die "search requires a query"
  local query="$1"; shift
  local limit=20 fmt=json
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit)   limit="$2"; shift 2 ;;
      --format)  fmt="$2";   shift 2 ;;
      *)         die "unknown flag: $1" ;;
    esac
  done

  local query_enc
  query_enc="$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")"
  local out
  out="$(sched_curl GET "/v1/jobs/search?query_text=${query_enc}&limit=${limit}")"

  if [[ "$fmt" == "table" ]]; then
    echo "$out" | jq -r '
      (. // .results // [])[] |
      "\(.job_id)\t\(.score // "—")\t\(.title)"
    ' | column -t -s $'\t'
  else
    echo "$out" | jq .
  fi
}

# ─── get ────────────────────────────────────────────────────────────────────

cmd_get() {
  [[ $# -ge 1 ]] || die "get requires a job-id"
  sched_curl GET "/v1/jobs/$1" | jq .
}

# ─── update ─────────────────────────────────────────────────────────────────

cmd_update() {
  [[ $# -ge 1 ]] || die "update requires a job-id"
  local job_id="$1"; shift
  local title="" desc="" status=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)        title="$2";  shift 2 ;;
      --description)  desc="$2";   shift 2 ;;
      --status)       status="$2"; shift 2 ;;
      *)              die "unknown flag: $1" ;;
    esac
  done

  local body
  body="$(jq -n \
    --arg title "$title" \
    --arg desc "$desc" \
    --arg status "$status" \
    '{}
      + (if $title  != "" then {title:       $title}  else {} end)
      + (if $desc   != "" then {description: $desc}   else {} end)
      + (if $status != "" then {status:      $status} else {} end)')"
  [[ "$body" == "{}" ]] && die "update requires at least one of --title/--description/--status"

  sched_curl PATCH "/v1/jobs/$job_id" "$body" | jq .
}

# ─── delete ─────────────────────────────────────────────────────────────────

cmd_delete() {
  [[ $# -ge 1 ]] || die "delete requires a job-id"
  sched_curl DELETE "/v1/jobs/$1" | jq .
}

# ─── archive ────────────────────────────────────────────────────────────────

cmd_archive() {
  [[ $# -ge 1 ]] || die "archive requires at least one job-id"
  local ids_json
  # /v1/jobs/batch/archive expects a BARE JSON array of ids (not {job_ids:[...]}).
  ids_json="$(printf '%s\n' "$@" | jq -R . | jq -s '.')"
  sched_curl POST "/v1/jobs/batch/archive" "$ids_json" | jq .
}

# ─── executions ─────────────────────────────────────────────────────────────

cmd_executions() {
  [[ $# -ge 1 ]] || die "executions requires a job-id"
  local job_id="$1"; shift
  local limit=20 fmt=json
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit)   limit="$2"; shift 2 ;;
      --format)  fmt="$2";   shift 2 ;;
      *)         die "unknown flag: $1" ;;
    esac
  done

  local out
  out="$(sched_curl GET "/v1/jobs/$job_id/executions?limit=${limit}")"

  if [[ "$fmt" == "table" ]]; then
    echo "$out" | jq -r '
      .[] |
      "\(.scheduled_at)\t\(.status)\t\(.completed_at // "running")\t\((.log_summary // "")[:80])"
    ' | column -t -s $'\t' | head -n "$((limit+1))"
  else
    echo "$out" | jq .
  fi
}

# ─── trigger ────────────────────────────────────────────────────────────────

cmd_trigger() {
  [[ $# -ge 1 ]] || die "trigger requires a job-id"
  sched_curl POST "/v1/jobs/$1/executions" | jq .
}

# ─── create ─────────────────────────────────────────────────────────────────

cmd_create() {
  local title="" desc="" category="" created_by=""
  local sched_type="" sched_expr_json="" next_run="" sched_json=""
  local act_type="" act_json=""
  local msg="" to_agent="" script_name="" script_args="[]"
  local http_url="" http_method="POST" http_body=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)         title="$2"; shift 2 ;;
      --description)   desc="$2"; shift 2 ;;
      --category)      category="$2"; shift 2 ;;
      --created-by)    created_by="$2"; shift 2 ;;
      --cron)          sched_type="cron";     sched_expr_json="$(jq -nc --arg c "$2" '{cron:$c}')"; shift 2 ;;
      --every)         sched_type="interval"; sched_expr_json="$(jq -nc --argjson s "$2" '{seconds:$s}')"; shift 2 ;;
      --at)            sched_type="one_off";  sched_expr_json="{}"; next_run="$2"; shift 2 ;;
      --when)          sched_type="natural";  sched_expr_json="$(jq -nc --arg t "$2" '$t')"; shift 2 ;;
      --schedule-json) sched_json="$2"; shift 2 ;;
      --message)       act_type="agent_message"; msg="$2"; shift 2 ;;
      --to-agent)      to_agent="$2"; shift 2 ;;
      --script)        act_type="script"; script_name="$2"; shift 2 ;;
      --args)          script_args="$2"; shift 2 ;;
      --http)          act_type="http"; http_url="$2"; shift 2 ;;
      --method)        http_method="$2"; shift 2 ;;
      --body)          http_body="$2"; shift 2 ;;
      --action-json)   act_json="$2"; shift 2 ;;
      -h|--help)       create_help; exit 0 ;;
      *)               die "unknown flag: $1" ;;
    esac
  done
  [[ -n "$title" ]] || die "create requires --title"

  # Auto-tag (the audit spine)
  [[ -n "$category" ]]   || category="agent-created"
  [[ -n "$created_by" ]] || created_by="${SCHEDULER_CREATED_BY:-agent}"

  # Schedule object
  local schedule
  if [[ -n "$sched_json" ]]; then
    schedule="$sched_json"
  elif [[ -n "$sched_type" ]]; then
    schedule="$(jq -nc --arg t "$sched_type" --argjson e "$sched_expr_json" --arg nr "$next_run" \
                 '{type:$t, expression:$e} + (if $nr=="" then {} else {next_run_at:$nr} end)')"
  else
    die "a schedule is required (--cron / --every / --at / --when / --schedule-json)"
  fi

  # Action object
  local action
  if [[ -n "$act_json" ]]; then
    action="$act_json"
  elif [[ "$act_type" == "agent_message" ]]; then
    [[ -n "$to_agent" ]] || die "--message requires --to-agent"
    action="$(jq -nc --arg a "$to_agent" --arg m "$msg" '{action_type:"agent_message", config:{agent_id:$a, message:$m}}')"
  elif [[ "$act_type" == "script" ]]; then
    action="$(jq -nc --arg s "$script_name" --argjson args "$script_args" '{action_type:"script", config:{script:$s, args:$args}}')"
  elif [[ "$act_type" == "http" ]]; then
    action="$(jq -nc --arg u "$http_url" --arg m "$http_method" --arg b "$http_body" \
               '{action_type:"http", config:({url:$u, method:$m} + (if $b=="" then {} else {body:$b} end))}')"
  else
    die "an action is required (--message+--to-agent / --script / --http / --action-json)"
  fi

  local body out jid
  body="$(jq -nc --arg t "$title" --arg d "$desc" --arg cb "$created_by" --arg cat "$category" \
            --argjson sch "$schedule" --argjson act "$action" \
            '{title:$t, description:$d, created_by:$cb, category:$cat, schedule:$sch, actions:[$act]}')"
  out="$(sched_curl POST "/v1/jobs" "$body")"
  echo "$out" | jq .
  jid="$(echo "$out" | jq -r '.job_id // .id // empty')"
  echo "created job ${jid} (created_by=${created_by}, category=${category})" >&2
  echo "undo: scheduler cancel-all --category ${category}   # or: scheduler archive ${jid}" >&2
}

# ─── cancel-all ───────────────────────────────────────────────────────────────

cmd_cancel_all() {
  local created_by="" category="agent-created" assume_yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --created-by) created_by="$2"; shift 2 ;;
      --category)   category="$2"; shift 2 ;;
      --yes|-y)     assume_yes=1; shift ;;
      -h|--help)    cancelall_help; exit 0 ;;
      *)            die "unknown flag: $1" ;;
    esac
  done

  local qs="?status_filter=scheduled&limit=500"
  [[ -n "$created_by" ]] && qs+="&created_by_filter=${created_by}"
  [[ -n "$category" ]]   && qs+="&category_filter=${category}"

  local jobs ids n
  jobs="$(sched_curl GET "/v1/jobs${qs}")"
  ids="$(echo "$jobs" | jq -r '(. // .jobs // [])[].job_id')"
  n="$(printf '%s' "$ids" | grep -c . || true)"
  if [[ "$n" -eq 0 ]]; then echo "0 matching jobs" >&2; return 0; fi

  if [[ "$assume_yes" -ne 1 ]]; then
    echo "About to cancel ${n} job(s) (created_by='${created_by:-*}' category='${category:-*}'). Enter to proceed, Ctrl-C to abort." >&2
    read -r _
  fi

  # /v1/jobs/batch/cancel expects a BARE JSON array of ids (not {job_ids:[...]}).
  local ids_json
  ids_json="$(echo "$ids" | jq -R . | jq -sc '.')"
  sched_curl POST "/v1/jobs/batch/cancel" "$ids_json" | jq .
  echo "cancelled ${n} job(s)" >&2
}

# ─── main ───────────────────────────────────────────────────────────────────

case "${1:-}" in
  create)       shift; cmd_create "$@" ;;
  cancel-all)   shift; cmd_cancel_all "$@" ;;
  list)         shift; cmd_list "$@" ;;
  search)       shift; cmd_search "$@" ;;
  get)          shift; cmd_get "$@" ;;
  update)       shift; cmd_update "$@" ;;
  delete)       shift; cmd_delete "$@" ;;
  archive)      shift; cmd_archive "$@" ;;
  executions)   shift; cmd_executions "$@" ;;
  trigger)      shift; cmd_trigger "$@" ;;
  -h|--help|"") usage ;;
  *)            die "unknown subcommand: $1 (try --help)" ;;
esac
