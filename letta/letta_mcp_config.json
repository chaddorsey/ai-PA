{
  "mcpServers": {
    "slack-tools": {
      "command": "http",
      "args": ["http://localhost:3001/sse"],
      "env": {},
      "disabled": false
    },
    "graphiti-tools": {
      "command": "http",
      "args": ["http://graphiti-mcp-server:8000/mcp"],
      "env": {
        "MCP_SERVER_NAME": "graphiti-tools",
        "MCP_SERVER_VERSION": "1.0.0",
        "MCP_TRANSPORT": "streamable-http"
      },
      "disabled": false
    },
    "rag-tools": {
      "command": "http",
      "args": ["http://rag-mcp-server:8082/mcp"],
      "env": {
        "MCP_SERVER_NAME": "rag-tools",
        "MCP_SERVER_VERSION": "1.0.0",
        "MCP_TRANSPORT": "streamable-http"
      },
      "disabled": false
    },
    "calendly-tools": {
      "command": "http",
      "args": ["http://calendly-mcp-server:8086/mcp"],
      "env": {
        "MCP_SERVER_NAME": "calendly-tools",
        "MCP_SERVER_VERSION": "1.0.0",
        "MCP_TRANSPORT": "streamable-http"
      },
      "disabled": false
    },
    "scheduler-tools": {
      "command": "http",
      "args": ["http://scheduler-mcp:8088/mcp"],
      "env": {
        "MCP_SERVER_NAME": "scheduler-tools",
        "MCP_SERVER_VERSION": "1.0.0",
        "MCP_TRANSPORT": "streamable-http"
      },
      "disabled": false
    },
    "granola-tools": {
      "command": "http",
      "args": ["http://host.docker.internal:8089/mcp"],
      "env": {
        "MCP_SERVER_NAME": "granola-tools",
        "MCP_SERVER_VERSION": "1.0.0",
        "MCP_TRANSPORT": "streamable-http"
      },
      "disabled": false
    }
  }
}
