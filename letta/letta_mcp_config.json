{
  "mcpServers": {
    "gmail-tools": {
      "command": "http",
      "args": ["http://localhost:8084/mcp"],
      "env": {
        "MCP_SERVER_NAME": "gmail-tools",
        "MCP_SERVER_VERSION": "1.1.11",
        "MCP_TRANSPORT": "streamable-http"
      },
      "disabled": false
    },
    "slack-tools": {
      "command": "http",
      "args": ["http://localhost:3001/sse"],
      "env": {},
      "disabled": false
    },
    "graphiti-tools": {
      "command": "http",
      "args": ["http://graphiti-mcp-server:8082"],
      "env": {},
      "disabled": false
    },
    "rag-tools": {
      "command": "http",
      "args": ["http://rag-mcp-server:8083"],
      "env": {},
      "disabled": false
    }
  }
}
