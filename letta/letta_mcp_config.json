{
  "mcpServers": {
    "slack-tools": {
      "command": "http",
      "args": ["http://localhost:3001/sse"],
      "env": {},
      "disabled": false
    },
    "scheduler-tools": {
      "command": "http",
      "args": ["http://scheduler-mcp:8088/mcp"],
      "env": {
        "MCP_SERVER_NAME": "scheduler-tools",
        "MCP_SERVER_VERSION": "1.0.0",
        "MCP_TRANSPORT": "streamable-http"
      },
      "disabled": false
    },
    "granola-tools": {
      "command": "http",
      "args": ["http://host.docker.internal:8089/mcp"],
      "env": {
        "MCP_SERVER_NAME": "granola-tools",
        "MCP_SERVER_VERSION": "1.0.0",
        "MCP_TRANSPORT": "streamable-http"
      },
      "disabled": false
    }
  }
}
