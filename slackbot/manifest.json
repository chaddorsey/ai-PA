{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Chadbot",
    "description": "An experiment in interactivity and stateful agents",
    "background_color": "#3053ba"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Chadbot",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Run sample shortcut",
        "type": "global",
        "callback_id": "sample_shortcut_id",
        "description": "Runs a sample shortcut"
      }
    ],
    "slash_commands": [
      {
        "command": "/sample-command",
        "description": "Runs a sample command",
        "should_escape": false
      },
      {
        "command": "/ask-chadbot",
        "description": "Schedule with Chad!",
        "should_escape": true
      },
      {
        "command": "/ask-bolty",
        "url": "https://example.com/slack/events",
        "description": "Ask the bot a question",
        "usage_hint": "[prompt]",
        "should_escape": false
      }
    ],
    "assistant_view": {
      "assistant_description": "This assistant bot can help schedule times and advise on ideal meeting scheduling options",
      "suggested_prompts": []
    }
  },
  "oauth_config": {
    "scopes": {
      "user": [
        "channels:history",
        "identify",
        "im:history",
        "im:write"
      ],
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "chat:write.customize",
        "chat:write.public",
        "commands",
        "groups:history",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "reactions:read",
        "assistant:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened",
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "function_executed",
        "assistant_thread_started",
        "assistant_thread_context_changed"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "hermes_app_type": "remote",
    "function_runtime": "remote"
  },
  "functions": {
    "e791ea": {
      "title": "Start",
      "description": "",
      "input_parameters": {},
      "output_parameters": {}
    }
  }
}
