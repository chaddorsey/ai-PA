<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-pa.letta-local-runner</string>

  <key>WorkingDirectory</key>
  <string>/Volumes/main-drive/ai-PA/letta-local-runner</string>

  <key>Program</key>
  <string>/Volumes/main-drive/ai-PA/letta-local-runner/run.sh</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>LETTA_BIN</key>
    <string>/opt/homebrew/bin/letta</string>
    <!-- Default. Override per-environment (e.g. for canary work) by
         editing your local copy at ~/Library/LaunchAgents/ — do NOT
         commit the override back to the in-repo plist. -->
    <key>LETTA_LOCAL_BACKEND_DIR</key>
    <string>/Users/dorseyhomeserver/.letta/lc-local-backend</string>
    <key>LETTA_LOCAL_RUNNER_LOG_DIR</key>
    <string>/Users/dorseyhomeserver/Library/Logs/letta-local-runner</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/dorseyhomeserver</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/dorseyhomeserver/Library/Logs/letta-local-runner/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/dorseyhomeserver/Library/Logs/letta-local-runner/stderr.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
